#!/usr/bin/env bash
#
# PortBridge control menu.
#
# Each tunnel is one config file plus one secret file, run by one instance of a
# single systemd template unit. That keeps tunnels genuinely independent: several
# can run side by side, in different modes, without touching each other.
#
#   /etc/portbridge/tunnels/<name>.conf     settings
#   /etc/portbridge/tunnels/<name>.secret   shared password, root-only
#   portbridge@<name>.service               the running service
#   /run/portbridge/<name>.json             live status, written by the tunnel

set -uo pipefail

VERSION_FALLBACK="unknown"
BIN=/usr/local/bin/portbridge
FIREWALL=/usr/local/bin/portbridge-firewall
TUNE=/usr/local/bin/portbridge-tune
CONF_DIR=/etc/portbridge/tunnels
RUN_DIR=/run/portbridge
AGENT_CONF=/etc/portbridge/agent.conf
AGENT_CLIENT_CONF=/etc/portbridge/agent-client.conf
AGENTS_DIR=/etc/portbridge/agents
AGENT_UNIT=portbridge-agent.service
LAST_LINKED_AGENT=""
# 443 is the port ordinary secure websites use, so a connection to it looks
# unremarkable. The previous default was 8388, which is the well-known
# Shadowsocks port and therefore one of the first things filtering looks for.
DEFAULT_TUNNEL_PORT=443

# Ports strongly associated with proxy and VPN software. Using one of these for
# the link between the two servers is an easy giveaway, so the menu warns.
SUSPICIOUS_PORTS="8388 1080 1081 9050 9051 8388 8080 8880 2080 2052 2082 2086 2095 8008 8081 3128 1194 500 4500 51820 8388 9000 10000 7100 8964 2222"

# ---------------------------------------------------------------- presentation

# Colours carry meaning, so the same colour always says the same thing:
#   green  = working          yellow = be careful        red = a problem or a
#   cyan numbers = what to type                          destructive choice
#   magenta = a group heading  grey = a side note
# NO_COLOR (any value) turns all of it off, as does output that is not a terminal.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$'\033[1m'; R=$'\033[0m'
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; CYAN=$'\033[36m'
    NUM=$'\033[1;96m'
    HEAD=$'\033[1;35m'
    # The plain "dim" attribute turns grey text almost invisible on many dark
    # themes, which made the side notes hard to read. A real light grey is used
    # where the terminal has 256 colours; otherwise dim, as before.
    if [ "$(tput colors 2>/dev/null || echo 8)" -ge 256 ] 2>/dev/null; then
        DIM=$'\033[38;5;247m'
    else
        DIM=$'\033[2m'
    fi
else
    B=''; DIM=''; R=''; RED=''; GREEN=''; YELLOW=''; CYAN=''; NUM=''; HEAD=''
fi

# The status dot. A plain star where the terminal cannot show it.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) DOT='●' ;;
    *) DOT='*' ;;
esac

# Only say() and deliberate printfs go to stdout. Everything decorative goes to
# stderr, so that helpers whose output is captured in a variable cannot be
# polluted by a stray status message.
say()  { printf '%s\n' "$*"; }
info() { printf '%s\n' "${CYAN}$*${R}" >&2; }
ok()   { printf '%s\n' "${GREEN}$*${R}" >&2; }
warn() { printf '%s\n' "${YELLOW}$*${R}" >&2; }
err()  { printf '%s\n' "${RED}$*${R}" >&2; }
hr()   { printf '%s\n' "${DIM}------------------------------------------------------------${R}"; }

# group <title> - a heading that starts a block of menu items, with a blank line
# above it so the blocks read as separate lists.
group() { printf '\n  %s%s%s\n' "$HEAD" "$1" "$R"; }

# item <key> <text> [note] [colour] - one menu line: the key to type in colour,
# the text in plain, the side note in grey and lined up in its own column. The
# colour argument is for destructive choices, which are shown in red.
item() {
    local key=$1 text=$2 note=${3-} tone=${4-}
    if [ -n "$note" ]; then
        printf '  %s%2s%s)  %s%-34s%s %s%s%s\n' "$NUM" "$key" "$R" "$tone" "$text" "$R" "$DIM" "$note" "$R"
    else
        printf '  %s%2s%s)  %s%s%s\n' "$NUM" "$key" "$R" "$tone" "$text" "$R"
    fi
}

pause() {
    printf '\n%s' "${DIM}Press Enter to continue...${R}"
    read -r _ || true
}

require_root() {
    [ "$(id -u)" -eq 0 ] || { err "Please run this as root."; exit 1; }
}

# ------------------------------------------------------------------- utilities

conf_of()   { printf '%s/%s.conf' "$CONF_DIR" "$1"; }
secret_of() { printf '%s/%s.secret' "$CONF_DIR" "$1"; }
unit_of()   { printf 'portbridge@%s.service' "$1"; }

tunnel_names() {
    [ -d "$CONF_DIR" ] || return 0
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        basename "$f" .conf
    done
}

tunnel_count() { tunnel_names | wc -l | tr -d ' '; }

# read_conf <name> <key>
read_conf() {
    local f
    f=$(conf_of "$1")
    [ -f "$f" ] || return 1
    sed -nE "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"?([^\"#]*)\"?[[:space:]]*$/\1/p" "$f" |
        tail -1 | sed -E 's/[[:space:]]+$//'
}

# other_public_ip <name> - the other server's real address. For a tunnel over a
# GRE link, peer_ip holds the private address on the link, and the public one is
# kept as gre_remote. Everything that looks the other server up, or tells the
# user where it is, wants this one.
other_public_ip() {
    if [ "$(read_conf "$1" gre)" = on ]; then
        read_conf "$1" gre_remote
    else
        read_conf "$1" peer_ip
    fi
}

# write_conf <name> <key> <value>  (replaces the line, or appends it)
write_conf() {
    local f
    f=$(conf_of "$1")
    write_file_key "$f" "$2" "$3"
}

# sed_escape <text> - makes text safe as the replacement part of a sed command
# that uses | as its delimiter. Backslash, ampersand and the delimiter all mean
# something there; left alone, a value containing one of them wrote the wrong
# thing, or ran a different sed command.
sed_escape() {
    printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'
}

read_file_key() {
    local f=$1 k=$2
    [ -f "$f" ] || return 1
    sed -nE "s/^[[:space:]]*${k}[[:space:]]*=[[:space:]]*\"?([^\"#]*)\"?[[:space:]]*$/\1/p" "$f" |
        tail -1 | sed -E 's/[[:space:]]+$//'
}

write_file_key() {
    local f=$1 k=$2 v=$3 esc
    # A value with a line break would write a second setting.
    case "$v" in
        *$'\n'* | *$'\r'*) err "Refusing to write a value with a line break into $k."; return 1 ;;
    esac
    mkdir -p "$(dirname "$f")"
    if [ -f "$f" ] && grep -qE "^[[:space:]]*${k}[[:space:]]*=" "$f" 2>/dev/null; then
        esc=$(sed_escape "$v")
        sed -i -E "s|^[[:space:]]*${k}[[:space:]]*=.*|${k} = ${esc}|" "$f"
    else
        printf '%s = %s\n' "$k" "$v" >>"$f"
    fi
    chmod 600 "$f"
}

gen_agent_token() {
    if command -v openssl >/dev/null 2>&1; then
        printf 'pba_%s' "$(openssl rand -hex 24)"
    else
        printf 'pba_%s' "$(head -c 24 /dev/urandom | xxd -p -c 48 2>/dev/null || head -c 24 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 48)"
    fi
}

# json_field <file> <key> - good enough for the flat status file we write
json_field() {
    [ -f "$1" ] || return 1
    sed -nE "s/^[[:space:]]*\"$2\"[[:space:]]*:[[:space:]]*\"?([^\",]*)\"?,?[[:space:]]*$/\1/p" "$1" | head -1
}

gen_secret() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 32 | tr -d '\n'
    else
        head -c 32 /dev/urandom | base64 | tr -d '\n'
    fi
}

is_private_ipv4() {
    case "$1" in
        10.* | 192.168.* | 127.* | 169.254.*) return 0 ;;
        172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) return 0 ;;
        100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) return 0 ;;
        *) return 1 ;;
    esac
}

# The address the OTHER server should use to reach this one.
#
# A public address bound directly to an interface is the most trustworthy
# answer, so it wins. Asking a website is only a fallback: on some providers
# outgoing traffic leaves through a different address than the one that accepts
# incoming connections, and the website only ever sees the outgoing one. Found
# on a real server, where that mistake sent the other side dialling an address
# that never answered.
public_ip() {
    local ip
    for ip in $(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1); do
        if ! is_private_ipv4 "$ip"; then
            printf '%s' "$ip"
            return 0
        fi
    done
    # Short timeouts: plenty of servers have no outbound web access at all, and a
    # setup screen that appears frozen for fifteen seconds looks broken.
    for url in https://api.ipify.org https://ifconfig.me; do
        ip=$(curl -4 -fsS --max-time 3 "$url" 2>/dev/null | tr -d '[:space:]')
        case "$ip" in
            [0-9]*.[0-9]*.[0-9]*.[0-9]*) printf '%s' "$ip"; return 0 ;;
        esac
    done
    # No outbound web access, which is common. Fall back to the routing table.
    ip route get 1.1.1.1 2>/dev/null | sed -nE 's/.* src ([0-9.]+).*/\1/p' | head -1
}

engine_version() {
    if [ -x "$BIN" ]; then "$BIN" version 2>/dev/null || printf '%s' "$VERSION_FALLBACK"
    else printf '%s' "not installed"; fi
}

# -------------------------------------------------------------------- validation

valid_name() {
    case "$1" in
        '' ) return 1 ;;
        *[!a-zA-Z0-9_-]* ) return 1 ;;
        *) [ "${#1}" -le 40 ] ;;
    esac
}

valid_port() {
    case "$1" in
        '' | *[!0-9]* ) return 1 ;;
        *) [ "$1" -ge 1 ] && [ "$1" -le 65535 ] ;;
    esac
}

# valid_count <n> - a whole number of at least 1
valid_count() {
    case "$1" in
        '' | *[!0-9]*) return 1 ;;
        *) [ "$1" -ge 1 ] ;;
    esac
}

valid_ports_list() {
    local list=$1 item
    [ -n "$list" ] || return 1
    local old_ifs=$IFS
    IFS=','
    for item in $list; do
        item=$(printf '%s' "$item" | tr -d '[:space:]')
        if ! valid_port "$item"; then
            IFS=$old_ifs
            return 1
        fi
    done
    IFS=$old_ifs
    return 0
}

valid_host() {
    case "$1" in
        '' ) return 1 ;;
        *[!a-zA-Z0-9.:_-]* ) return 1 ;;
        *) return 0 ;;
    esac
}

# port_owner <port> - names the tunnel already using a port, if any
port_owner() {
    local want=$1 n a item key
    for n in $(tunnel_names); do
        for key in tunnel_addr user_listen; do
            a=$(read_conf "$n" "$key") || continue
            [ -n "$a" ] || continue
            # A setting may list several addresses, "0.0.0.0:443, 0.0.0.0:8443".
            # Only the last port of the whole string used to be looked at.
            while IFS= read -r item; do
                item=$(printf '%s' "$item" | tr -d '[:space:]')
                [ -n "$item" ] || continue
                [ "${item##*:}" = "$want" ] && { printf '%s' "$n"; return 0; }
            done < <(printf '%s\n' "$a" | tr ',' '\n')
        done
    done
    return 1
}

# warn_if_suspicious_port <port> - a port known for proxy software makes the link
# between the two servers easy to pick out.
warn_if_suspicious_port() {
    local p
    for p in $SUSPICIOUS_PORTS; do
        if [ "$p" = "$1" ]; then
            warn "  Port $1 is well known for proxy software, which makes this link"
            warn "  easy to spot. Port 443 looks like an ordinary website instead."
            return 0
        fi
    done
    return 1
}

# port_in_use_by_system <port> [udp] - something is already listening on it.
# The KCP transport is UDP, so its port has to be looked for there.
port_in_use_by_system() {
    local flags=-lntH
    [ "${2:-tcp}" = "udp" ] && flags=-lnuH
    ss "$flags" 2>/dev/null | awk '{print $4}' | sed -E 's/.*:([0-9]+)$/\1/' | grep -qx "$1"
}

# ------------------------------------------------------------------- prompting

# ask <prompt> <default> -> echoes the answer
ask() {
    local prompt=$1 def=${2-} reply
    if [ -n "$def" ]; then
        printf '%s' "$prompt ${DIM}[$def]${R}: " >&2
    else
        printf '%s' "$prompt: " >&2
    fi
    read -r reply || true
    printf '%s' "${reply:-$def}"
}

# Only a clear yes or no is accepted. Anything else is asked again rather than
# being taken as "no", so a stray keystroke can never silently cancel something.
# An empty answer still means no, which keeps it safe to just press Enter.
confirm() {
    local reply
    while :; do
        printf '%s' "$1 ${DIM}[y/N]${R}: " >&2
        if ! read -r reply; then
            return 1 # no input available at all
        fi
        case "$reply" in
            [yY] | [yY][eE][sS]) return 0 ;;
            '' | [nN] | [nN][oO]) return 1 ;;
            *) err "  Please answer y or n." ;;
        esac
    done
}

# choose <prompt> <default> <valid...> - keeps asking until the answer is one of
# the listed options, so a mistyped key cannot skip a setup step.
choose() {
    local prompt=$1 def=$2 reply opt
    shift 2
    while :; do
        reply=$(ask "$prompt" "$def")
        for opt in "$@"; do
            if [ "$reply" = "$opt" ]; then
                printf '%s' "$reply"
                return 0
            fi
        done
        err "  Please enter one of: $*"
    done
}

ask_port() {
    local prompt=$1 def=$2 skip_name=${3-} p owner
    while :; do
        p=$(ask "$prompt" "$def")
        if ! valid_port "$p"; then
            err "  A port must be a number from 1 to 65535."
            continue
        fi
        owner=$(port_owner "$p" || true)
        if [ -n "$owner" ] && [ "$owner" != "$skip_name" ]; then
            err "  Port $p is already used by tunnel '$owner'. Pick another."
            continue
        fi
        if port_in_use_by_system "$p" "${5-tcp}"; then
            warn "  Something is already listening on port $p."
            confirm "  Use it anyway?" || continue
        fi
        if [ "${4-}" = link ] && warn_if_suspicious_port "$p"; then
            confirm "  Use it anyway?" || continue
        fi
        printf '%s' "$p"
        return 0
    done
}

# ------------------------------------------------------------ the two machines
#
# Every tunnel joins an Iran server (where users connect, the IP in their
# configs) to a foreign server (with the panel and Xray inbound). That never
# changes, in direct or reverse.
#
# So the menu never asks which machine it is on. It does not need to:
#   Create a tunnel  - is only ever run on the Iran server
#   Join a tunnel    - is only ever run on the foreign server
# Picking the option already answers the question.
#
# Internally the Iran side is the "edge" and the foreign side is the "origin".

explain_modes() {
    hr
    say "${B}Direct or reverse?${R}"
    say "${DIM}Your users will not notice any difference, and their configs still use${R}"
    say "${DIM}this Iran server's IP either way. This only decides which of the two${R}"
    say "${DIM}servers starts the connection between them.${R}"
    say ""
    say "  ${B}1) Direct${R}  - this Iran server connects out to your foreign server."
    say "     ${DIM}Try this first. It works in most cases.${R}"
    say ""
    say "  ${B}2) Reverse${R} - your foreign server connects in to this Iran server."
    say "     ${DIM}Use this if direct stops working, usually because this Iran server${R}"
    say "     ${DIM}can no longer reach the foreign server's IP.${R}"
    hr
}

# ------------------------------------------------------------------ disguise
#
# What the link between the two servers looks like to anyone watching it.
#
# The plain option is the fastest, and also the easiest to spot: the link opens
# with a burst of random-looking bytes that matches no known protocol, which is
# exactly what filtering looks for. The other options make it look like ordinary
# web traffic instead.
#
# Chosen on the Iran server and carried in the code, so both ends always agree.
# DG_* are set by ask_disguise and read by write_tunnel.
DG_TRANSPORT=plain
DG_SERVERNAME=""
DG_WSPATH=""
DG_CDN=off
# DG_ALTHOST is the domain to fall back to through a CDN when the foreign
# server's own address stops being reachable. Empty means no second route.
DG_ALTHOST=""

# ask_domain - reads a domain name, rejecting anything that is not one.
ask_domain() {
    local host
    while :; do
        host=$(ask "Your domain name" "")
        case "$host" in
            '' | *[!a-zA-Z0-9.-]*)
                err "  That does not look like a domain name."
                continue
                ;;
        esac
        case "$host" in
            *.*) break ;;
            *) err "  Please give a full domain name, such as link.example.com." ;;
        esac
    done
    printf '%s' "$host"
}

explain_disguise() {
    local mode=$1
    hr
    say "${B}How should the link between the two servers look?${R}"
    say "${DIM}This is about the connection between your two servers only. Your users'${R}"
    say "${DIM}own traffic is already encrypted by Xray and is not changed by this.${R}"
    say ""
    say "  ${B}1) Plain${R}"
    say "     ${DIM}Nothing added. Slightly faster, but the link matches no normal${R}"
    say "     ${DIM}pattern, which is the easiest kind of traffic to single out.${R}"
    say ""
    say "  ${B}2) Look like a normal website${R} ${DIM}(recommended)${R}"
    say "     ${DIM}The link is wrapped so it appears to be an ordinary secure website${R}"
    say "     ${DIM}connection. Costs a little speed and hides the link well.${R}"
    say ""
    say "  ${B}3) Go through Cloudflare or another CDN${R}"
    say "     ${DIM}As above, and routed through a CDN, so your foreign server's IP${R}"
    say "     ${DIM}never appears on the link and cannot simply be blocked. Needs a${R}"
    say "     ${DIM}domain name you control, pointed at the CDN.${R}"
    if [ "$mode" = direct ]; then
        say ""
        say "  ${B}4) Look like a website, with a CDN standing by${R}"
        say "     ${DIM}Normally connects straight to your foreign server, which is the${R}"
        say "     ${DIM}fastest way. If that address ever stops being reachable, it moves${R}"
        say "     ${DIM}to your domain through the CDN on its own and keeps working.${R}"
        say "     ${DIM}Also needs a domain pointed at the CDN.${R}"
        say ""
        say "  ${B}5) HTTP/2 / gRPC stream${R}"
        say "     ${DIM}Wraps the link in HTTP/2 streaming frames over TLS, appearing${R}"
        say "     ${DIM}as active HTTP/2 web/gRPC traffic. Resists DPI protocol inspection${R}"
        say "     ${DIM}and works with Cloudflare gRPC mode.${R}"
        say ""
        say "  ${B}6) Loss-resistant KCP / UDP with FEC${R} ${DIM}(resists packet loss & DPI TCP RSTs)${R}"
        say "     ${DIM}Runs over UDP with Reed-Solomon Forward Error Correction (10 data / 3 parity shards)${R}"
        say "     ${DIM}and AES encryption. Drops are repaired instantly without retransmission delays.${R}"
        say "     ${DIM}Immune to TCP middlebox RST drops; no TLS cert needed.${R}"
    else
        say ""
        say "  ${B}4) HTTP/2 / gRPC stream${R}"
        say "     ${DIM}Wraps the link in HTTP/2 streaming frames over TLS, appearing${R}"
        say "     ${DIM}as active HTTP/2 web/gRPC traffic. Resists DPI protocol inspection${R}"
        say "     ${DIM}and works with Cloudflare gRPC mode.${R}"
        say ""
        say "  ${B}5) Loss-resistant KCP / UDP with FEC${R} ${DIM}(resists packet loss & DPI TCP RSTs)${R}"
        say "     ${DIM}Runs over UDP with Reed-Solomon Forward Error Correction (10 data / 3 parity shards)${R}"
        say "     ${DIM}and AES encryption. Drops are repaired instantly without retransmission delays.${R}"
        say "     ${DIM}Immune to TCP middlebox RST drops; no TLS cert needed.${R}"
    fi
    hr
}

# gre_plan <this-server-ip> <other-server-ip> - the private addresses of the GRE
# link between two servers, asked of the helper, which follows the same rule as
# the engine. Sets GRE_OWN (this server's) and GRE_PEER (the other's).
# Fails if either address is not a plain IPv4 address.
gre_plan() {
    local out
    out=$("$FIREWALL" gre-addr "$1" "$2" 2>/dev/null) || return 1
    read -r _ GRE_OWN GRE_PEER <<<"$out"
    [ -n "${GRE_PEER-}" ]
}

# ---------------------------------------------------------------------- IPv6
#
# Some networks cut ordinary IPv4 connections between countries after a few packets
# yet leave IPv6 alone. A tunnel over IPv6 is the plain link with IPv6 addresses
# for the two servers, so nothing is made or set up: only the addresses differ.

V6_ON=off
V6_LOCAL=""
V6_PEER=""

# hostport <host> <port> - host:port, with an IPv6 address in brackets.
hostport() {
    case "$1" in
        *:*) printf '[%s]:%s' "$1" "$2" ;;
        *) printf '%s:%s' "$1" "$2" ;;
    esac
}

# bare_host <host:port> - the host of an address as hostport writes it, without
# the brackets, which the shell's own connection test does not understand.
bare_host() {
    local h=${1%:*}
    h=${h#\[}
    h=${h%\]}
    printf '%s' "$h"
}

# first_global_ipv6 - this server's first public IPv6 address, or nothing.
first_global_ipv6() {
    "$BIN" addresses 2>/dev/null | awk '$1 == "ipv6" {print $2; exit}'
}

# print_agent_links <token> <ipv4> <port> <fingerprint> - the link string to paste
# on the Iran server, and, when this server has a public IPv6 address, the same
# with that, for when ordinary IPv4 does not work between the two servers.
print_agent_links() {
    local tok=$1 v4=$2 p=$3 afp=${4-} v6
    say "  ${GREEN}pb-agent://${tok}@${v4}:${p}${afp:+?fp=$afp}${R}"
    v6=$(first_global_ipv6)
    if [ -n "$v6" ]; then
        say ""
        say "  ${DIM}If ordinary IPv4 does not work between your two servers, use this one instead:${R}"
        say "  ${GREEN}pb-agent://${tok}@[${v6}]:${p}${afp:+?fp=$afp}${R}"
    fi
}
# foreign_ipv6 <agent alias> - the foreign server's first public IPv6 address,
# asked of its agent. Prints it and returns 0; returns 1 if it was asked and has
# none; 2 if it could not be asked (no agent, not reachable, too old).
foreign_ipv6() {
    local out
    if [ -z "${1-}" ] || [ ! -f "$(agent_conf_of "$1")" ]; then
        return 2
    fi
    out=$(agent_call_alias "$1" -addresses 2>/dev/null) || return 2
    out=$(printf '%s\n' "$out" | awk '$1 == "ipv6" {print $2; exit}')
    [ -n "$out" ] || return 1
    printf '%s' "$out"
}

# foreign_ipv4 <agent alias> - the foreign server's first public IPv4 address,
# asked of its agent when the server was linked over IPv6.
foreign_ipv4() {
    local out
    if [ -z "${1-}" ] || [ ! -f "$(agent_conf_of "$1")" ]; then
        return 2
    fi
    out=$(agent_call_alias "$1" -addresses 2>/dev/null) || return 2
    out=$(printf '%s\n' "$out" | awk '$1 == "ipv4" {print $2; exit}')
    [ -n "$out" ] || return 1
    printf '%s' "$out"
}

# ask_ipv6 <agent alias or empty> - offers to connect the two servers over IPv6
# when both have a public IPv6 address. Sets V6_ON to on or off, and when on
# V6_LOCAL (this server's address) and V6_PEER (the foreign server's). When this
# server has no public IPv6 address it says so in one line and asks nothing.
ask_ipv6() {
    local alias=${1-} preset=${2-} mine theirs typed st
    V6_ON=off
    V6_LOCAL=""
    V6_PEER=""
    mine=$(first_global_ipv6)
    if [ -n "$preset" ] && [ -z "$mine" ]; then
        # The foreign server was given by its IPv6 address, which this server
        # cannot reach without one of its own.
        say "${DIM}You gave an IPv6 address, but this server has no public IPv6 address, so it${R}"
        say "${DIM}cannot reach it. Your hosting provider can give it one.${R}"
        return 0
    fi
    if [ -z "$mine" ]; then
        # Said in one line, not skipped in silence: a server that shows only an
        # address starting fe80 has IPv6 for its own network only, which the other
        # server cannot reach, and someone looking for the question wonders why.
        say "${DIM}IPv6 is not offered: this server has no public IPv6 address (only a local one,${R}"
        say "${DIM}or none), so the link uses IPv4. Your hosting provider can give it one.${R}"
        return 0
    fi

    if [ -n "$preset" ]; then
        # Already known: it is the address that was given for the foreign server.
        theirs=$preset
        st=0
    else
        printf '%s' "${DIM}Looking for IPv6 on the foreign server...${R}" >&2
        theirs=$(foreign_ipv6 "$alias")
        st=$?
        printf '\r%*s\r' 50 '' >&2
    fi
    if [ "$st" -eq 1 ]; then
        say "${DIM}The foreign server has no public IPv6 address, so this link uses IPv4.${R}"
        return 0
    fi

    hr
    say "${B}Connect the two servers over IPv6?${R}"
    say ""
    say "Some networks cut ordinary IPv4 connections between countries after a few packets"
    say "but leave IPv6 alone. This Iran server has the IPv6 address ${B}$mine${R}."
    if [ "$st" -eq 0 ]; then
        say "The foreign server has ${B}$theirs${R}."
    else
        say "The foreign server's IPv6 address could not be found automatically."
        typed=$(ask "Foreign server's IPv6 address (Enter to use IPv4)" "")
        [ -n "$typed" ] || return 0
        case "$typed" in
            *:*) ;;
            *) err "  That is not an IPv6 address; using IPv4."; return 0 ;;
        esac
        if ! valid_host "$typed"; then
            err "  That does not look like an address; using IPv4."
            return 0
        fi
        theirs=$typed
    fi
    if [ "$DG_TRANSPORT" = plain ]; then
        say "${DIM}Like any plain link it is not encrypted or disguised.${R}"
    else
        say "${DIM}The link keeps the disguise you chose; only the addresses change.${R}"
    fi
    hr
    confirm "Use IPv6 between the two servers?" || return 0

    if command -v ping >/dev/null 2>&1; then
        if ping -6 -c 3 -W 3 "$theirs" >/dev/null 2>&1; then
            ok "  IPv6 works between the two servers."
        else
            warn "  The foreign server did not answer over IPv6. Its firewall may block pings, or"
            warn "  IPv6 may not be working on one of the servers."
            confirm "  Use IPv6 anyway?" || return 0
        fi
    fi
    V6_ON=on
    V6_LOCAL=$mine
    V6_PEER=$theirs
}

# ask_gre - whether the tunnel runs over a private GRE link. Sets DG_GRE to on or
# off. The link between the servers is then plain and needs no disguise, since the
# only thing that crosses the border is GRE, so the caller skips that question.
ask_gre() {
    DG_GRE=off
    DG_GRE_LOCAL=""
    DG_GRE_REMOTE=""
    hr
    say "${B}Carry it over a private GRE link?${R}"
    say ""
    say "Some networks cut ordinary connections that leave the country after a few"
    say "packets, yet let GRE through. GRE joins your two servers with a private network"
    say "between them. The tunnel then runs inside it, so the only thing that crosses"
    say "the border is GRE."
    say ""
    say "  ${DIM}Use it when a normal tunnel connects but no data flows.${R}"
    say "  ${DIM}It is not encrypted or disguised: anyone watching can tell it is GRE.${R}"
    say "  ${DIM}Both servers must hold their own public IPv4 address, and the host must${R}"
    say "  ${DIM}allow GRE. Some low-cost plans and containers do not.${R}"
    hr
    confirm "Use a GRE link?" || return 0
    local out
    if ! out=$("$FIREWALL" gre-check 2>&1); then
        err "$out"
        say ""
        info "So a GRE link is not possible on this server. Choose another kind of link."
        return 0
    fi
    ok "$out"
    DG_GRE=on
}

# ask_disguise <mode> - fills the DG_* variables.
ask_disguise() {
    local mode=$1 choice

    explain_disguise "$mode"
    if [ "$mode" = direct ]; then
        choice=$(choose "Choose 1, 2, 3, 4, 5 or 6" "2" 1 2 3 4 5 6)
    else
        choice=$(choose "Choose 1, 2, 3, 4 or 5" "2" 1 2 3 4 5)
        case "$choice" in
            4) choice=5 ;; # gRPC
            5) choice=6 ;; # KCP
        esac
    fi

    DG_SERVERNAME=""
    DG_WSPATH=""
    DG_CDN=off
    DG_ALTHOST=""
    DG_CLEAN_IPS=""
    DG_UTLS=off
    DG_FRAGMENT=off
    DG_HTTPHEADER=off
    DG_HTTPHOST=""
    DG_REAL_SITE=off
    DG_COVER_SITE=""

    case "$choice" in
        1)
            DG_TRANSPORT=plain
            warn "Chosen: plain. Nothing is hidden."
            say ""
            info "The plain link opens with random-looking bytes, which some networks refuse."
            info "It can instead open like ordinary web traffic: a short fake web request and"
            info "reply naming a site of your choice, then the tunnel as before. It is not"
            info "encryption, and both servers get the same setting from the code."
            if confirm "Make it open like web traffic?"; then
                DG_HTTPHEADER=on
                DG_HTTPHOST=$(ask_http_host)
                ok "Chosen: plain, opening like web traffic to $DG_HTTPHOST."
            fi
            return 0
            ;;
        2) DG_TRANSPORT=tls ;;
        3) DG_TRANSPORT=wss; DG_CDN=on ;;
        4) DG_TRANSPORT=wss; DG_CDN=off ;;
        5) DG_TRANSPORT=grpc ;;
        6)
            DG_TRANSPORT=kcp
            DG_CDN=off
            DG_SERVERNAME=""
            DG_WSPATH=""
            say ""
            ok "Chosen: Loss-resistant KCP over UDP with Reed-Solomon FEC."
            return 0
            ;;
    esac

    if [ "$choice" = 3 ] || [ "$choice" = 4 ]; then
        say ""
        info "A CDN routes by name, so this needs a domain you control which is"
        info "already pointed at your foreign server, with the CDN's proxy turned on."
        info "Somebody else's domain behind the same CDN cannot work: the CDN would"
        info "hand your traffic to their server, not yours."
        local domain
        domain=$(ask_domain)
        DG_WSPATH="/$(head -c 9 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 10)"

        if [ "$choice" = 4 ]; then
            # Two routes, two names. Going straight to the server must not name
            # the domain, because that domain's records point at the CDN and not
            # at the address being dialled, and the two not matching says more
            # than either on its own.
            DG_ALTHOST=$domain
            say ""
            info "While it is connecting straight to your foreign server it will claim"
            info "to be some ordinary site instead of your domain, because your domain"
            info "points at the CDN and naming it there would not add up."
            DG_SERVERNAME=$(ask "Name to claim on the direct route" "www.bing.com")
            [ -n "$DG_SERVERNAME" ] || DG_SERVERNAME=www.bing.com
            say ""
            info "Direct: claims $DG_SERVERNAME. Falling back: $domain$DG_WSPATH."
        else
            DG_SERVERNAME=$domain
            say ""
            info "Using the web address $DG_SERVERNAME$DG_WSPATH for the link."
            if [ "$mode" = reverse ]; then
                warn "Note: a CDN only carries connections towards your domain, so with"
                warn "reverse this only works if the domain points at THIS Iran server."
            fi
        fi
        if [ "$DG_CDN" = on ]; then
            say ""
            info "Clean Cloudflare IPs (optional): If Cloudflare default Anycast IPs are"
            info "blocked or throttled by your ISP, enter one or more verified clean IPs"
            info "(comma-separated, e.g. 104.16.12.34, 172.67.45.67). Leave blank to resolve via DNS."
            DG_CLEAN_IPS=$(ask "Clean Cloudflare IPs" "")
        fi

        say ""
        warn "Two things to set on the CDN, or the link will not come up:"
        warn "  - its encryption mode must be Full, not Flexible and not Full Strict."
        warn "    Flexible sends plain traffic to your server, which this refuses."
        warn "    Strict demands a publicly trusted certificate, which this has no"
        warn "    need for, because the shared password is what proves who is who."
        warn "  - the CDN must forward the port below. Cloudflare forwards only: $CDN_PORTS"
        warn "    Other providers, such as ArvanCloud, may allow more; check yours."
        say ""
        warn "Because the link can arrive from the CDN rather than from your other"
        warn "server, the tunnel port cannot be locked to one address, so it is left"
        warn "open. Anything that knocks on it without the right web address and"
        warn "password gets an ordinary 404 and nothing else."
    elif [ "$choice" = 5 ]; then
        say ""
        info "HTTP/2 / gRPC stream can connect directly to your foreign server, or"
        info "route through Cloudflare CDN (with the gRPC setting turned on in Cloudflare)."
        say ""
        say "  ${NUM}1${R}) Direct to foreign server IP ${DIM}(claims any normal website name, e.g. www.google.com)${R}"
        say "  ${NUM}2${R}) Through Cloudflare CDN ${DIM}(needs your domain pointed to Cloudflare with gRPC enabled)${R}"
        local grpc_choice
        grpc_choice=$(choose "Choose 1 or 2" "1" 1 2)
        if [ "$grpc_choice" = 2 ]; then
            DG_CDN=on
            say ""
            info "Needs a domain you control pointed at your foreign server behind Cloudflare."
            info "Make sure Cloudflare -> Network -> gRPC is toggled ON, and SSL is Full."
            local domain
            domain=$(ask_domain)
            DG_SERVERNAME=$domain
            DG_WSPATH=""
            say ""
            info "Routing gRPC through Cloudflare using domain: $DG_SERVERNAME"
            if [ "$mode" = reverse ]; then
                warn "Note: a CDN only carries connections towards your domain, so with"
                warn "reverse this only works if the domain points at THIS Iran server."
            fi
            say ""
            info "Clean Cloudflare IPs (optional): If Cloudflare default Anycast IPs are"
            info "blocked or throttled by your ISP, enter one or more verified clean IPs"
            info "(comma-separated, e.g. 104.16.12.34, 172.67.45.67). Leave blank to resolve via DNS."
            DG_CLEAN_IPS=$(ask "Clean Cloudflare IPs" "")
            say ""
            warn "Three things to set on Cloudflare for gRPC mode:"
            warn "  - Network -> gRPC must be turned ON."
            warn "  - SSL/TLS encryption mode must be Full."
            warn "  - Cloudflare forwards only these ports: $CDN_PORTS"
            warn "    Another provider may allow more; check yours."
        else
            DG_CDN=off
            say ""
            info "The direct gRPC stream will claim to be a website/API service."
            info "Any believable name works (e.g. www.google.com, www.bing.com)."
            DG_SERVERNAME=$(ask "Name for it to claim" "www.google.com")
            [ -n "$DG_SERVERNAME" ] || DG_SERVERNAME=www.google.com
            say ""
            info "Stealth evasion: Use Chrome TLS fingerprint (uTLS) and ClientHello TCP"
            info "fragmentation to bypass Iranian SNI DPI on direct connections."
            if confirm "Enable stealth evasion (uTLS & fragmentation)?"; then
                DG_UTLS=on
                DG_FRAGMENT=on
            fi
        fi
    else
        say ""
        info "The link will claim to be a website. Any believable name works, and it"
        info "does not need to be a domain you own or one that really exists."
        DG_SERVERNAME=$(ask "Name for it to claim" "www.bing.com")
        [ -n "$DG_SERVERNAME" ] || DG_SERVERNAME=www.bing.com
        say ""
        info "Stealth evasion: Use Chrome TLS fingerprint (uTLS) and ClientHello TCP"
        info "fragmentation to bypass Iranian SNI DPI on direct connections."
        if confirm "Enable stealth evasion (uTLS & fragmentation)?"; then
            DG_UTLS=on
            DG_FRAGMENT=on
        fi
    fi
}

# ask_real_site <mode> - asks whether strangers should be passed straight to the genuine website.
ask_real_site() {
    local mode=$1
    DG_REAL_SITE=off
    DG_COVER_SITE=""

    # Does not apply to CDN links, GRE, plain, or KCP links.
    # A CDN backup route is left out too: the CDN makes its own connection to
    # this server, which cannot carry the proof, so it would be shown the real site.
    if [ "${DG_CDN:-off}" = on ] || [ -n "${DG_ALTHOST:-}" ] ||
        [ "${DG_TRANSPORT:-plain}" = plain ] || [ "${DG_TRANSPORT:-plain}" = kcp ]; then
        return 0
    fi

    say ""
    info "Show the real website to strangers:"
    info "Strangers, censors or probe scanners connecting to this port will be passed"
    info "straight through to the genuine website. They get Microsoft's authentic"
    info "TLS certificate and real pages, so our server never exposes itself."
    info "Authentic PortBridge clients carry a secret proof in their hello and connect normally."

    if [ "$mode" = reverse ]; then
        say ""
        info "In reverse mode, this Iran server is the one listening on the port."
        info "Testing accessible cover sites from this server..."
        local candidate=""
        local s
        for s in "${DG_SERVERNAME:-}" www.bing.com www.varzesh3.com www.wikipedia.org; do
            [ -n "$s" ] || continue
            if curl -fsSIL --connect-timeout 3 "https://$s" >/dev/null 2>&1; then
                candidate="$s"
                break
            fi
        done
        if [ -n "$candidate" ]; then
            ok "Verified accessible cover site from this server: $candidate"
            DG_SERVERNAME="$candidate"
        else
            warn "Could not automatically reach https://${DG_SERVERNAME:-www.bing.com}."
            info "Enter a cover site that is accessible from this server."
            DG_SERVERNAME=$(ask "Accessible cover site" "${DG_SERVERNAME:-www.bing.com}")
        fi
    fi

    say ""
    if confirm "Show the real website to strangers? (Recommended)" "y"; then
        DG_REAL_SITE=on
        # Automatically use browser look-alike hello (uTLS)
        DG_UTLS=on
        ok "Chosen: Strangers will be passed to $DG_SERVERNAME."
    fi
}

# describe_disguise <transport> <cdn> [althost] - one short phrase for summaries.
# valid_hostname <name> - letters, digits, dots and dashes
valid_hostname() {
    case "$1" in
        '' | .* | -* | *. | *-) return 1 ;;
        *[!a-zA-Z0-9.-]*) return 1 ;;
        *) [ "${#1}" -le 253 ] ;;
    esac
}

# ask_http_host - the site name the web header claims; any believable name works
# and it does not have to be one you own.
ask_http_host() {
    local h
    while :; do
        h=$(ask "Site name for the web header" "www.bing.com")
        if valid_hostname "$h"; then
            printf '%s' "$h"
            return 0
        fi
        err "  Use a name like www.example.com (letters, digits, dots and dashes)."
    done
}

describe_disguise() {
    case "$1:$2" in
        tls:*) printf 'looks like a normal website' ;;
        h2:on) printf 'HTTP/2 stream through Cloudflare' ;;
        h2:*) printf 'looks like HTTP/2 web traffic' ;;
        grpc:on) printf 'gRPC stream through Cloudflare' ;;
        grpc:*) printf 'looks like gRPC over HTTP/2' ;;
        kcp:*) printf 'loss-resistant KCP/UDP with FEC' ;;
        wss:on) printf 'through a CDN' ;;
        wss:*)
            if [ -n "${3-}" ]; then
                printf 'looks like a website, CDN standing by'
            else
                printf 'looks like a website, websocket'
            fi
            ;;
        *)
            if [ -n "${4-}" ]; then
                printf 'plain, opening like web traffic to %s (not encrypted)' "$4"
            else
                printf 'plain, not hidden'
            fi
            ;;
    esac
}

# http_header_host <name> - the name a plain tunnel's web header claims, or nothing
# if the header is off.
http_header_host() {
    if [ "$(read_conf "$1" http_header)" = on ]; then
        local h
        h=$(read_conf "$1" http_host)
        printf '%s' "${h:-www.bing.com}"
    fi
}

# cdn_involved <cdn> <althost> - can the link arrive from a CDN rather than
# straight from the other server? If so the tunnel port cannot be locked to one
# address, because the address it arrives from is the CDN's.
cdn_involved() {
    [ "$1" = on ] || [ -n "${2-}" ]
}

# The ports Cloudflare's proxy will carry a secure connection on. This is only
# advice: other providers, ArvanCloud for one, forward more, so a port outside the
# list is pointed out and never refused.
CDN_PORTS="443 2053 2083 2087 2096 8443"

cdn_port_ok() {
    local p
    for p in $CDN_PORTS; do
        [ "$1" = "$p" ] && return 0
    done
    return 1
}

# ------------------------------------------------------------------ free ports
#
# The link between the servers needs a port that is free on whichever server
# listens for it, and a CDN forwards only some ports. Both are easy to forget, so
# the menu asks both servers (the foreign one through its agent) and shows the
# answers side by side.

# The ports worth looking at: the ones Cloudflare forwards, then the extra ones
# other CDNs, ArvanCloud for one, forward.
PORTS_OTHER_CDNS="80 8080 8880 2052 2082 2086 2095"

# ports_here <list> - this server's answer, as lines of port, state and owner
# separated by tabs.
ports_here() { "$BIN" ports "$1" 2>/dev/null; }

# ports_there <alias> <list> - the foreign server's, through its agent. Says
# nothing and fails when there is no agent, it cannot be reached, or it is too old.
ports_there() { agent_call_alias "$1" -ports "$2" 2>/dev/null; }

# port_cell <state> <owner> - one cell of the table, coloured and padded to 24.
port_cell() {
    local state=$1 by=${2-} text colour
    case "$state" in
        free) text=free; colour=$GREEN ;;
        busy) text=busy; colour=$RED ;;
        reserved) text=reserved; colour=$YELLOW ;;
        *) text="not known"; colour=$DIM ;;
    esac
    # "PortBridge tunnel m-a (its users)" is shown as "tunnel m-a", to fit.
    by=${by#PortBridge }
    by=${by%% (*}
    [ -n "$by" ] && text="$text ($(printf '%.12s' "$by"))"
    printf '%s%-24s%s' "$colour" "$text" "$R"
}

# show_port_table <ports> <agent alias or empty> <direct|reverse|both>
#
# Prints this server and the foreign server side by side, with whether a CDN
# forwards each port. Sets PORT_BEST to the first port that suits the tunnel: free
# on both servers if there is one, otherwise free where the link is opened (the
# foreign server in direct mode, this one in reverse). It is empty when nothing
# suits or the answer is not known.
show_port_table() {
    local list=$1 alias=${2-} need=${3-both}
    local -A lstate=() lby=() fstate=() fby=()
    local port state by have_foreign=no ls fs ok verdict cdn best_both="" best_need=""
    PORT_BEST=""

    printf '%s' "${DIM}Checking the ports...${R}" >&2
    while IFS=$'\t' read -r port state by; do
        [ -n "$port" ] || continue
        lstate[$port]=$state
        lby[$port]=$by
    done < <(ports_here "$list")
    if [ -n "$alias" ] && [ -f "$(agent_conf_of "$alias")" ]; then
        while IFS=$'\t' read -r port state by; do
            [ -n "$port" ] || continue
            fstate[$port]=$state
            fby[$port]=$by
            have_foreign=yes
        done < <(ports_there "$alias" "$list")
    fi
    printf '\r%*s\r' 30 '' >&2

    printf '  %s%-6s %-24s %-24s %-11s%s\n' "$DIM" PORT "THIS SERVER" "FOREIGN SERVER" "CDN" "$R"
    for port in ${list//,/ }; do
        ls=${lstate[$port]-}
        fs=${fstate[$port]-}
        verdict=""
        ok=no
        if [ "$ls" = free ] && [ "$fs" = free ]; then
            verdict="${GREEN}free on both${R}"
            ok=both
        elif [ "$need" = direct ] && [ "$fs" = free ]; then
            verdict="${GREEN}usable${R}"
            ok=need
        elif [ "$need" = reverse ] && [ "$ls" = free ]; then
            verdict="${GREEN}usable${R}"
            ok=need
        fi
        [ "$ok" = both ] && [ -z "$best_both" ] && best_both=$port
        [ "$ok" != no ] && [ -z "$best_need" ] && best_need=$port
        if cdn_port_ok "$port"; then cdn=Cloudflare; else cdn="other CDNs"; fi
        printf '  %s%-6s%s %s %s %s%-11s%s %s\n' "$B" "$port" "$R" \
            "$(port_cell "$ls" "${lby[$port]-}")" "$(port_cell "$fs" "${fby[$port]-}")" \
            "$DIM" "$cdn" "$R" "$verdict"
    done
    say "${DIM}busy = something is using it.  reserved = free now, but a tunnel here is set to use it.${R}"
    if [ -z "$alias" ]; then
        say "${DIM}No agent is linked for the foreign server, so only this server is checked there.${R}"
        say "${DIM}Link one under 'Management Agent' to see both.${R}"
    elif [ "$have_foreign" = no ]; then
        warn "The foreign server did not answer (is its agent running, and up to date?),"
        warn "so only this server is shown."
    fi
    PORT_BEST=${best_both:-$best_need}
}

# suggest_link_port <direct|reverse> <agent alias or empty> <cdn: on|off> - shows
# the ports worth considering for the link and leaves the best one in PORT_BEST.
suggest_link_port() {
    local mode=$1 alias=${2-} cdn=${3:-off}
    say ""
    if [ "$cdn" = on ]; then
        say "${B}Ports a CDN forwards, and whether they are free${R}"
        say "${DIM}Cloudflare forwards only the ones marked Cloudflare. A port must be free on${R}"
        say "${DIM}the server that opens it: the foreign server in direct mode, this one in reverse.${R}"
        show_port_table "$(printf '%s' "$CDN_PORTS $PORTS_OTHER_CDNS" | tr ' ' ',')" "$alias" "$mode"
    else
        # Without a CDN in the way any port will do, so none is singled out. The
        # table is still there for anyone who wants to see what is free.
        PORT_BEST=""
        say "${DIM}Any port will do for this link. 'Show free ports on both servers' in the main${R}"
        say "${DIM}menu shows which are free.${R}"
        return 0
    fi
    if [ -n "$PORT_BEST" ]; then
        info "Suggested: $PORT_BEST"
    fi
}

# ---- checking the ports as they are typed
#
# The Iran server's own ports are checked on the spot. The foreign server's are
# asked of its agent, so a busy port is caught as it is typed, not after the
# tunnel's Iran half has been made. Without an agent, or when it cannot be
# reached, the foreign server checks them itself when the tunnel is set up there.

REMOTE_AGENT=""      # the agent alias to ask, or empty
REMOTE_SELF=""       # the tunnel being changed, whose own ports are not "taken"
REMOTE_STATE=unknown # unknown, up or down: once down it is not asked again
declare -A FQ_STATE=() FQ_BY=()

# use_foreign_agent <alias or empty> [tunnel being changed] - starts a round of
# questions about the foreign server's ports.
use_foreign_agent() {
    REMOTE_AGENT=${1-}
    REMOTE_SELF=${2-}
    REMOTE_STATE=unknown
    FQ_STATE=()
    FQ_BY=()
    if [ -z "$REMOTE_AGENT" ]; then
        info "No agent is linked for the foreign server, so its ports cannot be checked as you"
        info "type them. It checks them itself when the tunnel is set up there."
    fi
}

# foreign_query <ports> - asks the foreign server about ports; fails quietly (and
# says so once) when it cannot be asked.
foreign_query() {
    local list=$1 out port state by
    [ -n "$REMOTE_AGENT" ] || return 1
    [ "$REMOTE_STATE" = down ] && return 1
    if ! out=$(ports_there "$REMOTE_AGENT" "$list"); then
        REMOTE_STATE=down
        warn "  The foreign server could not be asked about its ports (is its agent running, and"
        warn "  up to date?). It checks them itself when the tunnel is set up there."
        return 1
    fi
    FQ_STATE=()
    FQ_BY=()
    while IFS=$'\t' read -r port state by; do
        [ -n "$port" ] || continue
        FQ_STATE[$port]=$state
        FQ_BY[$port]=$by
    done <<<"$out"
    REMOTE_STATE=up
    return 0
}

# foreign_own <owner> - is this port held by the tunnel being changed itself?
foreign_own() {
    [ -n "$REMOTE_SELF" ] || return 1
    case "$1" in "PortBridge tunnel $REMOTE_SELF ("*) return 0 ;; esac
    return 1
}

# check_foreign_link_port <port> - the link port, opened on the foreign server in
# direct mode, has to be free there. Returns 1, after saying why, if it is not.
check_foreign_link_port() {
    local p=$1 st by
    foreign_query "$p" || return 0
    st=${FQ_STATE[$p]-}
    by=${FQ_BY[$p]-}
    foreign_own "$by" && return 0
    case "$st" in
        busy | reserved)
            err "  Port $p is already used on the foreign server${by:+ ($by)}. Choose another."
            return 1
            ;;
        free) ok "  Port $p is free on the foreign server." ;;
    esac
    return 0
}

# check_foreign_service_ports <ports> - the service ports are where your inbound
# listens on the foreign server, so something should be listening there already,
# and it must not be the link of another tunnel. Returns 1 if they should be
# entered again.
check_foreign_service_ports() {
    local p st by bad=0 quiet=0
    foreign_query "$1" || return 0
    for p in $(printf '%s' "$1" | tr ',' ' '); do
        st=${FQ_STATE[$p]-}
        by=${FQ_BY[$p]-}
        case "$by" in
            "PortBridge tunnel "*)
                foreign_own "$by" && continue
                err "  Port $p is used on the foreign server by ${by#PortBridge }, so it cannot also be your service."
                bad=1
                ;;
        esac
        [ "$bad" -eq 1 ] && continue
        case "$st" in
            free)
                warn "  Nothing is listening on port $p on the foreign server yet."
                quiet=1
                ;;
            busy) ok "  Port $p: something is listening on the foreign server${by:+ ($by)}." ;;
        esac
    done
    [ "$bad" -eq 1 ] && return 1
    if [ "$quiet" -eq 1 ]; then
        warn "  Is the service (Xray) running there, with an inbound on that port?"
        confirm "  Use it anyway?" || return 1
    fi
    return 0
}

# ports_overview - the menu's own page: which ports are free on both servers.
ports_overview() {
    local alias="" count list names=() i=1 n sel
    init_agents_dir
    hr
    say "${B}Free ports on both servers${R}"
    say "${DIM}Useful when you forget which ports a CDN forwards and which are already taken.${R}"
    hr
    count=$(agent_count)
    if [ "$count" -eq 1 ]; then
        alias=$(agent_names | head -n 1)
    elif [ "$count" -gt 1 ]; then
        say "Which foreign server?"
        for n in $(agent_names); do
            say "  ${NUM}$i${R})  ${B}$n${R}"
            names+=("$n")
            i=$((i + 1))
        done
        sel=$(ask "Choose [1-$((i - 1))]" "1")
        if valid_count "$sel" && [ "$sel" -le "${#names[@]}" ]; then
            alias="${names[$((sel - 1))]}"
        fi
    fi
    list=$(ask "Ports to check (Enter for the usual CDN ports)" "")
    if [ -z "$list" ]; then
        list=$(printf '%s' "$CDN_PORTS $PORTS_OTHER_CDNS" | tr ' ' ',')
    elif ! printf '%s' "$list" | grep -Eq '^[0-9]+([ ,]+[0-9]+)*$'; then
        err "That is not a list of port numbers."
        return 1
    fi
    say ""
    [ -n "$alias" ] && say "Foreign server: ${B}$alias${R}"
    show_port_table "$list" "$alias" both
    [ -n "$PORT_BEST" ] && info "Free on both: the first is $PORT_BEST"
    return 0
}
explain_cdn_ports() {
    warn "  Port $1 is not one Cloudflare forwards ($CDN_PORTS)."
    info "  Other CDNs, such as ArvanCloud, may forward it. Make sure yours does; carrying on."
}

# ------------------------------------------------------------------- sharing
#
# Whether every user session gets its own connection across the border, or they
# all share a few that stay open.
#
# This is a genuine trade, not an improvement, which is why it is asked plainly
# and left off by default. Sharing hides how busy the tunnel is and holds far
# fewer connections open, which is harder to single out. It also means a lost
# packet holds up everyone sharing that connection, and on a bad route that is
# felt.
#
# Chosen on the Iran server and carried in the code, so both ends always agree.
MX_MUX=off
MX_LINKS=4

explain_sharing() {
    local transport=${DG_TRANSPORT:-plain} rec_one="" rec_two=""
    # The two choices are always numbered the same way, so "2" never means
    # something different from one screen to the next. Only the suggestion moves.
    if [ "$transport" = kcp ] || [ "$transport" = wss ] || [ "$transport" = grpc ]; then
        rec_two=" ${DIM}(recommended for $transport)${R}"
    else
        rec_one=" ${DIM}(recommended)${R}"
    fi
    hr
    say "${B}How should your users' traffic travel between the two servers?${R}"
    say ""
    say "  ${B}1) A separate connection for each user${R}$rec_one"
    say "     ${DIM}Every user gets their own path between the servers. If one user's${R}"
    say "     ${DIM}connection has trouble, nobody else is affected. Best on a weak or${R}"
    say "     ${DIM}unreliable route. The downside: many connections open and close between${R}"
    say "     ${DIM}the servers, which a network can notice more easily.${R}"
    say ""
    say "  ${B}2) Everyone shares a few connections${R}$rec_two"
    say "     ${DIM}All users travel together over $MX_LINKS connections that stay open for hours.${R}"
    say "     ${DIM}Far fewer connections to notice, so the tunnel is harder to spot. The${R}"
    say "     ${DIM}downside: if one shared connection stalls, every user on it feels it at${R}"
    say "     ${DIM}the same moment.${R}"
    say ""
    say "  ${DIM}Not sure? Choose 1.${R}"    hr
}

# ask_mux_links - how many shared connections, 1 to 16.
ask_mux_links() {
    local n
    while :; do
        n=$(ask "How many shared connections" "4")
        if valid_port "$n" && [ "$n" -le 16 ]; then
            MX_LINKS=$n
            return 0
        fi
        err "  Give a number between 1 and 16."
    done
}

ask_sharing() {
    explain_sharing
    local transport=${DG_TRANSPORT:-plain} def=1
    if [ "$transport" = kcp ] || [ "$transport" = wss ] || [ "$transport" = grpc ]; then
        def=2
    fi
    case "$(choose "Choose 1 or 2" "$def" 1 2)" in
        1)
            MX_MUX=off
            MX_LINKS=4
            ;;
        2)
            MX_MUX=on
            say ""
            info "More connections spread the risk of a hiccup; fewer hide the tunnel"
            info "better. Four is a sensible middle."
            ask_mux_links
            ;;
    esac
}

# describe_sharing <mux> <links> - one short phrase for summaries.
describe_sharing() {
    if [ "$1" = on ]; then
        printf 'all users share %s connections' "${2:-4}"
    else
        printf 'one connection per user'
    fi
}

# -------------------------------------------------------------- pairing code

# The code carries everything the foreign server needs, so it asks nothing.
make_pairing_code() {
    local name=$1 mode=$2 tport=$3 relay_ip=$4 server_ip=$5 inbound_port=$6 pool=$7 secret=$8
    local transport=$9 servername=${10} wspath=${11} cdn=${12} mux=${13} muxlinks=${14}
    local althost=${15-} utls=${16-} fragment=${17-} cleanips=${18-}
    local httpheader=${19-} httphost=${20-} gre=${21-} realsite=${22-}
    # Version 6 adds the browser hello, the split hello and the clean addresses,
    # which a CDN tunnel needs on the foreign side as well. Version 7 adds the web
    # header of a plain link. A code says 7 only when it uses it, so a server that
    # knows up to 6 keeps working with every tunnel that does not. Version 8 adds
    # the private GRE link, and is sent only for a tunnel that uses one. Version 9
    # passes strangers to the real website instead of presenting our own cert.
    if [ "$realsite" = on ]; then
        printf 'v=9\nname=%s\nmode=%s\ntunnel_port=%s\nrelay_ip=%s\nserver_ip=%s\ninbound_port=%s\npool=%s\ntransport=%s\nserver_name=%s\nws_path=%s\ncdn=%s\nalt_host=%s\nmux=%s\nmux_links=%s\nutls=%s\ntls_fragment=%s\nclean_ips=%s\nreal_site=%s\nsecret=%s\n' \
            "$name" "$mode" "$tport" "$relay_ip" "$server_ip" "$inbound_port" "$pool" \
            "$transport" "$servername" "$wspath" "$cdn" "$althost" "${mux:-off}" "${muxlinks:-4}" \
            "$utls" "$fragment" "$cleanips" "on" "$secret" |
            base64 | tr -d '\n'
        return 0
    fi
    if [ "$gre" = on ]; then
        printf 'v=8\nname=%s\nmode=%s\ntunnel_port=%s\nrelay_ip=%s\nserver_ip=%s\ninbound_port=%s\npool=%s\ntransport=%s\nserver_name=%s\nws_path=%s\ncdn=%s\nalt_host=%s\nmux=%s\nmux_links=%s\nutls=%s\ntls_fragment=%s\nclean_ips=%s\ngre=%s\nsecret=%s\n' \
            "$name" "$mode" "$tport" "$relay_ip" "$server_ip" "$inbound_port" "$pool" \
            "$transport" "$servername" "$wspath" "$cdn" "$althost" "${mux:-off}" "${muxlinks:-4}" \
            "$utls" "$fragment" "$cleanips" "on" "$secret" |
            base64 | tr -d '\n'
        return 0
    fi
    if [ "$httpheader" = on ]; then
        printf 'v=7\nname=%s\nmode=%s\ntunnel_port=%s\nrelay_ip=%s\nserver_ip=%s\ninbound_port=%s\npool=%s\ntransport=%s\nserver_name=%s\nws_path=%s\ncdn=%s\nalt_host=%s\nmux=%s\nmux_links=%s\nutls=%s\ntls_fragment=%s\nclean_ips=%s\nhttp_header=%s\nhttp_host=%s\nsecret=%s\n' \
            "$name" "$mode" "$tport" "$relay_ip" "$server_ip" "$inbound_port" "$pool" \
            "$transport" "$servername" "$wspath" "$cdn" "$althost" "${mux:-off}" "${muxlinks:-4}" \
            "$utls" "$fragment" "$cleanips" "on" "${httphost:-www.bing.com}" "$secret" |
            base64 | tr -d '\n'
        return 0
    fi
    printf 'v=6\nname=%s\nmode=%s\ntunnel_port=%s\nrelay_ip=%s\nserver_ip=%s\ninbound_port=%s\npool=%s\ntransport=%s\nserver_name=%s\nws_path=%s\ncdn=%s\nalt_host=%s\nmux=%s\nmux_links=%s\nutls=%s\ntls_fragment=%s\nclean_ips=%s\nsecret=%s\n' \
        "$name" "$mode" "$tport" "$relay_ip" "$server_ip" "$inbound_port" "$pool" \
        "$transport" "$servername" "$wspath" "$cdn" "$althost" "${mux:-off}" "${muxlinks:-4}" \
        "$utls" "$fragment" "$cleanips" "$secret" |
        base64 | tr -d '\n'
}
get_tunnel_pairing_code() {
    local name=$1 role mode tport secret relay_ip server_ip inbound_port pool
    role=$(read_conf "$name" role)
    if [ "$role" != edge ]; then
        return 1
    fi
    mode=$(read_conf "$name" mode)
    tport=$(read_conf "$name" tunnel_addr); tport=${tport##*:}
    secret=$(cat "$(secret_of "$name")" 2>/dev/null)
    relay_ip=$(read_conf "$name" local_ip)
    [ -n "$relay_ip" ] || relay_ip=$(public_ip)
    server_ip=$(other_public_ip "$name")
    inbound_port=$(read_conf "$name" server_inbound_port)
    pool=$(read_conf "$name" pool_size)

    local transport servername wspath cdn mux muxlinks alt althost
    transport=$(read_conf "$name" transport); [ -n "$transport" ] || transport=plain
    servername=$(read_conf "$name" server_name)
    wspath=$(read_conf "$name" ws_path)
    cdn=$(read_conf "$name" cdn); [ -n "$cdn" ] || cdn=off
    mux=$(read_conf "$name" mux); [ -n "$mux" ] || mux=off
    muxlinks=$(read_conf "$name" mux_links); [ -n "$muxlinks" ] || muxlinks=4
    alt=$(read_conf "$name" alt_target)
    althost=${alt%:*}
    local utls fragment cleanips
    # Left empty when the tunnel never set them, so the other side keeps its own
    # default (on for a CDN) instead of being told "off".
    utls=$(read_conf "$name" utls)
    fragment=$(read_conf "$name" tls_fragment)
    cleanips=$(read_conf "$name" clean_ips | tr -d ' ')

    make_pairing_code "$name" "$mode" "$tport" "$relay_ip" "$server_ip" "$inbound_port" \
        "$pool" "$secret" "$transport" "$servername" "$wspath" "$cdn" "$mux" "$muxlinks" "$althost" \
        "$utls" "$fragment" "$cleanips" "$(read_conf "$name" http_header)" "$(read_conf "$name" http_host)" \
        "$(read_conf "$name" gre)" "$(read_conf "$name" real_site)"
}

show_pairing_code() {
    local name=$1 code server_ip
    code=$(get_tunnel_pairing_code "$name") || {
        warn "Codes are made on the Iran server. Use 'Show a tunnel's code' there instead."
        return 1
    }
    server_ip=$(other_public_ip "$name")

    hr
    say "${B}Code for your foreign server${R}"
    say ""
    say "Now log in to your ${B}foreign server${R} ($server_ip), install PortBridge there,"
    say "choose ${B}'Join a tunnel'${R} and paste this one line. It asks nothing else."
    say ""
    printf '%s\n' "$code"
    say ""
    warn "This line contains the tunnel's password, so do not post it anywhere public."
    if [ "$(read_conf "$name" gre)" = on ]; then
        say ""
        info "This tunnel runs over a private GRE link. The foreign server makes its end of"
        info "the link when it joins, so its host must allow GRE."
    fi
    hr
}

# report_gre_link <name> - after a tunnel over a GRE link is up on both servers,
# says whether the other end of the link answers. It can take a few seconds for
# the foreign side to finish, so it tries for a short while before giving up.
report_gre_link() {
    local name=$1 i out
    [ "$(read_conf "$name" gre)" = on ] || return 0
    printf '%s' "${DIM}Checking the private GRE link...${R}" >&2
    for i in 1 2 3 4 5; do
        if out=$("$FIREWALL" gre-test "$name" 2>&1); then
            printf '\r%*s\r' 45 '' >&2
            ok "$out"
            return 0
        fi
        sleep 2
    done
    printf '\r%*s\r' 45 '' >&2
    warn "$out"
    warn "The tunnel is set up, but the GRE link is not carrying packets yet. Either the"
    warn "network drops GRE between these two servers, or a firewall in front of one of"
    warn "them blocks IP protocol 47. 'Check a tunnel for problems' shows more."
}

# ------------------------------------------------------------ write a tunnel

# write_tunnel <name> <mode> <role> <tunnel_addr> <user_listen> <inbound_addr>
#              <peer_ip> <local_ip> <pool> <secret> [server_inbound_port]
write_tunnel() {
    local name=$1 mode=$2 role=$3 taddr=$4 ulisten=$5 inbound=$6
    local peer=$7 localip=$8 pool=$9 secret=${10} sinport=${11-}

    mkdir -p "$CONF_DIR"
    chmod 700 "$CONF_DIR"

    local conf
    conf=$(conf_of "$name")
    {
        printf '# PortBridge tunnel "%s", written by the menu on %s\n' "$name" "$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        printf '# Edit with: portbridge-menu  ->  Edit a tunnel\n\n'
        printf 'name = %s\n' "$name"
        printf 'mode = %s\n' "$mode"
        if [ "$role" = edge ]; then
            printf '# edge = the Iran server, where users connect\n'
        else
            printf '# origin = the foreign server, where the inbound is\n'
        fi
        printf 'role = %s\n\n' "$role"
        if [ "$mode:$role" = "direct:edge" ] || [ "$mode:$role" = "reverse:origin" ]; then
            printf '# This machine starts the connection, so this is the address it calls.\n'
        else
            printf '# This machine waits for the other one to call, on this port.\n'
        fi
        printf 'tunnel_addr = %s\n' "$taddr"
        [ -n "$ulisten" ] && printf '\n# Where your users connect.\nuser_listen = %s\n' "$ulisten"
        [ -n "$inbound" ] && printf '\n# Your Xray inbound.\ninbound_addr = %s\n' "$inbound"
        [ -n "$sinport" ] && printf '\n# The inbound port on the foreign server, kept for the code.\nserver_inbound_port = %s\n' "$sinport"
        printf '\n# The other machine.\n'
        printf 'peer_ip = %s\n' "$peer"
        if [ "${DG_GRE:-off}" = on ]; then
            printf '# off because the port can only be reached through the private GRE link.\n'
            printf 'firewall = off\n'
        elif cdn_involved "${DG_CDN:-off}" "${DG_ALTHOST-}"; then
            printf '# off because the link can arrive from a CDN, whose address is not\n'
            printf '# the other server, so the port cannot be locked to one address.\n'
            printf 'firewall = off\n'
        else
            printf '# on = only the other machine may use the tunnel port. Change from the menu.\n'
            printf 'firewall = on\n'
        fi
        [ -n "$localip" ] && printf 'local_ip = %s\n' "$localip"
        if [ "${DG_GRE:-off}" = on ]; then
            printf '\n# Runs over a private GRE link between the two servers: peer_ip and\n'
            printf '# tunnel_addr are addresses on that link, and these are the real ones.\n'
            printf 'gre = on\n'
            printf 'gre_local = %s\n' "${DG_GRE_LOCAL-}"
            printf 'gre_remote = %s\n' "${DG_GRE_REMOTE-}"
        fi
        printf '\n# What the link looks like to anyone watching it. See the menu.\n'
        printf 'transport = %s\n' "${DG_TRANSPORT:-plain}"
        if [ "${DG_TRANSPORT:-plain}" = plain ] && [ "${DG_HTTPHEADER:-off}" = on ]; then
            printf '# Opens with a fake web request and reply; both servers must have it.\n'
            printf 'http_header = on\n'
            printf 'http_host = %s\n' "${DG_HTTPHOST:-www.bing.com}"
        fi
        if [ "${DG_TRANSPORT:-plain}" != plain ] && [ "${DG_TRANSPORT:-plain}" != kcp ]; then
            [ -n "${DG_SERVERNAME-}" ] && printf 'server_name = %s\n' "$DG_SERVERNAME"
            [ -n "${DG_WSPATH-}" ] && printf 'ws_path = %s\n' "$DG_WSPATH"
            printf 'cdn = %s\n' "${DG_CDN:-off}"
            printf 'cert_file = %s/%s.crt\n' "$CONF_DIR" "$name"
            printf 'key_file = %s/%s.key\n' "$CONF_DIR" "$name"
        fi
        # A second route is only of use to the side that dials; the other side
        # accepts the link whichever way it arrives, so it is told nothing.
        if [ -n "${DG_ALTHOST-}" ] &&
            { [ "$mode:$role" = "direct:edge" ] || [ "$mode:$role" = "reverse:origin" ]; }; then
            printf '\n# If the address above cannot be reached, try this instead.\n'
            printf 'alt_target = %s:%s\n' "$DG_ALTHOST" "${taddr##*:}"
            printf '# The CDN routes by name, so this route has to name the domain,\n'
            printf '# while the direct route above deliberately does not.\n'
            printf 'alt_server_name = %s\n' "$DG_ALTHOST"
        fi

        # Only the side that dials uses these.
        if [ -n "${DG_CLEAN_IPS-}" ] &&
            { [ "$mode:$role" = "direct:edge" ] || [ "$mode:$role" = "reverse:origin" ]; }; then
            printf '\n# Clean Cloudflare Anycast IPs for bypassing throttling/blocking\n'
            printf 'clean_ips = %s\n' "$DG_CLEAN_IPS"
        fi

        if [ "${DG_UTLS:-off}" = on ]; then
            printf 'utls = on\n'
        fi
        if [ "${DG_FRAGMENT:-off}" = on ]; then
            printf 'tls_fragment = on\n'
        fi
        if [ "${DG_REAL_SITE:-off}" = on ]; then
            printf 'real_site = on\n'
            if [ -n "${DG_COVER_SITE-}" ]; then
                printf 'cover_site = %s\n' "$DG_COVER_SITE"
            fi
        fi

        printf '\n# on = every user session shares a few long-lived connections.\n'
        printf 'mux = %s\n' "${MX_MUX:-off}"
        if [ "${MX_MUX:-off}" = on ]; then
            printf 'mux_links = %s\n' "${MX_LINKS:-4}"
        fi

        printf '\npool_size = %s\n' "$pool"
        printf 'max_conn = 2000\n'
        printf 'max_pending = 512\n'
        printf 'spare_ttl = 10m\n'
        printf 'park_timeout = 15m\n'
        printf 'drain = 5s\n'
        printf '\nsecret_file = %s\n' "$(secret_of "$name")"
    } >"$conf"
    chmod 600 "$conf"

    printf '%s\n' "$secret" >"$(secret_of "$name")"
    chmod 600 "$(secret_of "$name")"
}

# discard_tunnel removes a half-made tunnel. Without this, a setup that failed
# validation left its settings behind, so the tunnel appeared in the list and in
# the firewall view while never being able to run.
discard_tunnel() {
    systemctl disable --now "$(unit_of "$1")" >/dev/null 2>&1
    # Starting it may already have set a firewall rule or a GRE link, so those go
    # while the settings that name them are still here.
    "$FIREWALL" remove "$1" >/dev/null 2>&1
    rm -f "$(conf_of "$1")" "$(secret_of "$1")" "$RUN_DIR/$1.json" \
        "$CONF_DIR/$1.crt" "$CONF_DIR/$1.key"
    systemctl daemon-reload
    "$FIREWALL" sweep quiet >/dev/null 2>&1
}

validate_and_enable() {
    local name=$1
    if ! "$BIN" check -config "$(conf_of "$name")" >/dev/null; then
        "$BIN" check -config "$(conf_of "$name")" >&2
        err "Those settings were refused, so nothing has been started."
        discard_tunnel "$name"
        err "The half-made tunnel has been cleaned up. Nothing was left behind."
        return 1
    fi
    systemctl daemon-reload
    systemctl enable --now "$(unit_of "$name")" >/dev/null 2>&1 || {
        err "Could not start the tunnel. Recent log:"
        journalctl -u "$(unit_of "$name")" -n 20 --no-pager
        return 1
    }
    sleep 2
    if [ "$(systemctl is-active "$(unit_of "$name")")" != active ]; then
        err "The tunnel started then stopped. Recent log:"
        journalctl -u "$(unit_of "$name")" -n 25 --no-pager
        say ""
        warn "The settings have been kept so you can look at them or edit them."
        warn "Use 'Delete a tunnel' to remove it."
        return 1
    fi
    return 0
}

# ask_remote_port <prompt> <default> - a port on the OTHER machine, so the local
# "is it free here" checks would be meaningless and are skipped.
ask_remote_port() {
    local p
    while :; do
        p=$(ask "$1" "${2-}")
        if ! valid_port "$p"; then
            err "  A port must be a number from 1 to 65535."
            continue
        fi
        if [ "${3-}" = link ] && warn_if_suspicious_port "$p"; then
            confirm "  Use it anyway?" || continue
        fi
        printf '%s' "$p"
        return 0
    done
}

# ask_remote_ports <prompt> <default> - one port or comma-separated list
ask_remote_ports() {
    local p
    while :; do
        p=$(ask "$1" "${2-}")
        if ! valid_ports_list "$p"; then
            err "  Each port must be a number from 1 to 65535 (e.g. 443, 8443, 2083)."
            continue
        fi
        printf '%s' "$p" | sed -E 's/[[:space:]]+//g'
        return 0
    done
}

# next_free_local_port <port> - the first port after this one that nothing on this
# server uses, as a number, or nothing if there is none close by.
next_free_local_port() {
    local n=$1 tries=0
    while [ "$tries" -lt 200 ]; do
        n=$((n + 1))
        tries=$((tries + 1))
        [ "$n" -le 65535 ] || return 1
        if [ -z "$(port_owner "$n" || true)" ] && ! port_in_use_by_system "$n"; then
            printf '%s' "$n"
            return 0
        fi
    done
    return 1
}

# suggest_user_ports <inbound ports> - what to suggest for the users' ports: the
# same numbers as the inbound ports, which is simplest, except where this Iran
# server already uses that number (another tunnel's users, or another program),
# when the next free one is suggested and the change is said out loud. The inbound
# port lives on the foreign server and the users' port on this one, so the same
# number being busy here says nothing against the inbound port itself.
suggest_user_ports() {
    local out="" p q owner
    for p in $(printf '%s' "$1" | tr ',' ' '); do
        q=$p
        owner=$(port_owner "$p" || true)
        if [ -n "$owner" ] || port_in_use_by_system "$p"; then
            q=$(next_free_local_port "$p" || true)
            q=${q:-$p}
            if [ -n "$owner" ]; then
                info "  Port $p is already used on this Iran server by tunnel '$owner', so $q is suggested for your users."
            else
                info "  Port $p is already in use on this Iran server, so $q is suggested for your users."
            fi
        fi
        [ -n "$out" ] && out="$out, $q" || out="$q"
    done
    printf '%s' "$out"
}

# ask_user_ports <prompt> <default> [skip_name]
ask_user_ports() {
    local prompt=$1 def=$2 skip_name=${3-} p item owner
    while :; do
        p=$(ask "$prompt" "$def")
        if ! valid_ports_list "$p"; then
            err "  Each port must be a number from 1 to 65535 (e.g. 443, 8443, 2083)."
            continue
        fi
        local clean=""
        local old_ifs=$IFS
        local conflict=0
        IFS=','
        for item in $p; do
            item=$(printf '%s' "$item" | tr -d '[:space:]')
            owner=$(port_owner "$item" || true)
            if [ -n "$owner" ] && [ "$owner" != "$skip_name" ]; then
                err "  Port $item is already used by tunnel '$owner'. Pick another."
                conflict=1
                break
            fi
            if port_in_use_by_system "$item"; then
                warn "  Something is already listening on port $item."
                if ! confirm "  Use it anyway?"; then
                    conflict=1
                    break
                fi
            fi
            [ -n "$clean" ] && clean="$clean, $item" || clean="$item"
        done
        IFS=$old_ifs
        [ "$conflict" -eq 1 ] && continue
        printf '%s' "$clean"
        return 0
    done
}

# this_machine_has_ip <ip> - true if the address is bound to one of our interfaces
this_machine_has_ip() {
    ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -qx "$1"
}

# looks_like_foreign_server <port> - true if something other than PortBridge is
# already serving that port here, which on a normal setup means Xray: this is
# the foreign server, and Create was chosen on the wrong machine.
looks_like_foreign_server() {
    ss -lntpH 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" {print $6}' | grep -q . &&
        ! ss -lntpH 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" {print $6}' | grep -q '"portbridge"'
}

# ---------------------------------------------------------------- create flow

create_tunnel() {
    local name mode tport taddr ulisten peer localip secret inport uport
    local pool=25 target_agent="" agent_url="" agent_token="" peer_conf=""

    hr
    say "${B}Create a tunnel${R}"
    say "${DIM}Do this on your Iran server, the one whose IP is in your users' configs.${R}"
    say "${DIM}You will get a code at the end to paste on your foreign server.${R}"
    hr

    while :; do
        name=$(ask "A short name for this tunnel (letters, digits, dash)" "")
        if ! valid_name "$name"; then
            err "  Use only letters, digits, dash and underscore, up to 40 characters."
            continue
        fi
        if [ -f "$(conf_of "$name")" ]; then
            err "  A tunnel called '$name' already exists."
            continue
        fi
        break
    done

    explain_modes
    case "$(choose "Choose 1 or 2" "1" 1 2)" in
        1) mode=direct ;;
        2) mode=reverse ;;
    esac

    # What the link looks like, and so whether a CDN is involved, is settled before any
    # port is asked about: only a tunnel through a CDN is limited in which ports it can
    # use, so the questions about ports depend on this answer.
    ask_gre
    if [ "$DG_GRE" = on ]; then
        # Nothing to disguise: only GRE crosses the border. Everything the other
        # questions would have set is put back to its plain value, so nothing is
        # left over from an earlier tunnel made in the same session.
        DG_TRANSPORT=plain
        DG_SERVERNAME=""
        DG_WSPATH=""
        DG_CDN=off
        DG_ALTHOST=""
        DG_CLEAN_IPS=""
        DG_UTLS=off
        DG_FRAGMENT=off
        DG_HTTPHEADER=off
        DG_HTTPHOST=""
        DG_REAL_SITE=off
        DG_COVER_SITE=""
    else
        ask_disguise "$mode"
        ask_real_site "$mode"
    fi
    ask_sharing
    init_agents_dir

    local count
    count=$(agent_count)

    if [ "$count" -gt 0 ]; then
        hr
        say "${B}Target Foreign Server${R}"
        say "${DIM}Choose which foreign server this tunnel connects to:${R}"
        hr
        local names=() i=1 aname au aip
        for aname in $(agent_names); do
            au=$(read_file_key "$(agent_conf_of "$aname")" url)
            aip=$(read_file_key "$(agent_conf_of "$aname")" server_ip)
            say "  ${NUM}$i${R})  ${B}$aname${R}  ${DIM}($aip, $au)${R}"
            names+=("$aname")
            i=$((i + 1))
        done
        say "  ${NUM}$i${R}) Link a new Foreign server now ${DIM}(automated 1-click setup)${R}"
        say "  ${NUM}M${R}) Enter IP manually ${DIM}(without agent / manual pairing code)${R}"
        hr
        local sel
        sel=$(ask "Choose [1-$i, M]" "1")
        if [ "$sel" = "$i" ]; then
            if link_foreign_agent; then
                target_agent="$LAST_LINKED_AGENT"
                if [ -n "$target_agent" ] && [ -f "$(agent_conf_of "$target_agent")" ]; then
                    peer=$(read_file_key "$(agent_conf_of "$target_agent")" server_ip)
                    agent_url=$(read_file_key "$(agent_conf_of "$target_agent")" url)
                    agent_token=$(read_file_key "$(agent_conf_of "$target_agent")" token)
                    ok "Using newly linked server: $target_agent ($peer)"
                fi
            fi
        elif valid_count "$sel" && [ "$sel" -le "${#names[@]}" ]; then
            target_agent="${names[$((sel - 1))]}"
            peer=$(read_file_key "$(agent_conf_of "$target_agent")" server_ip)
            agent_url=$(read_file_key "$(agent_conf_of "$target_agent")" url)
            agent_token=$(read_file_key "$(agent_conf_of "$target_agent")" token)
            ok "Selected Foreign server: $target_agent ($peer)"
        fi
    else
        hr
        say "${B}Target Foreign Server${R}"
        say "${DIM}No foreign servers linked yet.${R}"
        say "  ${NUM}1${R}) Link a Foreign server now ${DIM}(automated 1-click setup)${R}"
        say "  ${NUM}2${R}) Enter Foreign server IP manually ${DIM}(manual pairing code)${R}"
        hr
        local sel
        sel=$(ask "Choose [1-2]" "1")
        if [ "$sel" = "1" ]; then
            if link_foreign_agent; then
                target_agent="$LAST_LINKED_AGENT"
                if [ -n "$target_agent" ] && [ -f "$(agent_conf_of "$target_agent")" ]; then
                    peer=$(read_file_key "$(agent_conf_of "$target_agent")" server_ip)
                    agent_url=$(read_file_key "$(agent_conf_of "$target_agent")" url)
                    agent_token=$(read_file_key "$(agent_conf_of "$target_agent")" token)
                    ok "Using newly linked server: $target_agent ($peer)"
                fi
            fi
        fi
    fi

    if [ -z "${peer-}" ]; then
        say ""
        info "Your foreign server's IP, the one with your panel on it."
        info "If ordinary IPv4 does not work between the two servers, give its IPv6 address."
        while :; do
            peer=$(ask "Foreign server IP" "")
            if this_machine_has_ip "$peer"; then
                err "  That is this machine's own IP. Enter your foreign server's IP."
                continue
            fi
            valid_host "$peer" && break
            err "  That does not look like an address."
        done
    fi

    # IPv6 changes only the addresses. It is offered for the plain link and for the
    # disguised ones that connect straight to the foreign server (website, HTTP/2,
    # gRPC), which have been tried over it. Not for a CDN (which reaches the foreign
    # server by name), GRE (IPv4 only), the web-socket link or KCP (not tried over
    # it). When it is not offered it says so, rather than skipping in silence.
    V6_ON=off
    if [ "$DG_GRE" = on ]; then
        say "${DIM}IPv6 is not offered with a GRE link, which carries IPv4 only.${R}"
    elif cdn_involved "$DG_CDN" "$DG_ALTHOST"; then
        say "${DIM}IPv6 is not offered through a CDN, which reaches your server by name.${R}"
    else
        case "$DG_TRANSPORT" in
            plain | tls | h2 | grpc | kcp)
                # A foreign server that was given by its IPv6 address is that
                # address already, so it is not asked for again.
                case "$peer" in
                    *:*) ask_ipv6 "$target_agent" "$peer" ;;
                    *) ask_ipv6 "$target_agent" ;;
                esac
                [ "$V6_ON" = on ] && peer=$V6_PEER
                ;;
            *)
                say "${DIM}IPv6 is not offered with this kind of link; it has not been tried over IPv6.${R}"
                say "${DIM}Choose the plain, website, HTTP/2 or KCP link to be asked about it.${R}"
                ;;
        esac
    fi
    # If the foreign server was linked by its IPv6 address, and this tunnel is
    # using IPv4 or a CDN instead of IPv6, ask the linked agent for its IPv4
    # address automatically (or prompt for it when a direct IPv4 address is needed).
    case "$peer" in
        *:*)
            if [ "$V6_ON" != on ]; then
                local v4_peer=""
                if [ -n "$target_agent" ]; then
                    v4_peer=$(foreign_ipv4 "$target_agent" || true)
                fi
                if [ -n "$v4_peer" ]; then
                    peer=$v4_peer
                    ok "Using foreign server's IPv4 address for this tunnel: $peer"
                else
                    # Also for a CDN tunnel: the pairing code and the other
                    # server's settings still carry this address, and an IPv6 one
                    # would leave the two ends disagreeing about the link.
                    info "The foreign server was linked over IPv6, and this tunnel needs its IPv4 address."
                    while :; do
                        v4_peer=$(ask "Foreign server IPv4 address" "")
                        case "$v4_peer" in
                            [0-9]*.[0-9]*.[0-9]*.[0-9]*)
                                peer=$v4_peer
                                break
                                ;;
                            *)
                                err "  Please enter a valid IPv4 address (e.g. 203.0.113.10)."
                                ;;
                        esac
                    done
                fi
            fi
            ;;
    esac

    say ""
    info "The port of your inbound on the foreign server, as shown in your panel."
    info "For multiple ports/services, separate them with commas (e.g. 443, 8443, 2083)."
    use_foreign_agent "$target_agent"
    while :; do
        inport=$(ask_remote_ports "Inbound port(s)" "")
        check_foreign_service_ports "$inport" && break
    done

    # The inbound port being busy HERE almost always means Xray is running here,
    # so this is the foreign server and the user is on the wrong machine.
    local first_inport=${inport%%,*}
    first_inport=$(printf '%s' "$first_inport" | tr -d '[:space:]')
    if looks_like_foreign_server "$first_inport"; then
        warn "Port $first_inport is already in use on this machine. That usually means this"
        warn "is your foreign server, not your Iran server."
        warn "Create a tunnel should be run on the Iran server instead."
        confirm "Carry on here anyway?" || { say "Cancelled. Nothing was changed."; return 1; }
    fi

    say ""
    info "The port(s) your users put in their configs, next to this Iran server's IP."
    info "Keeping it the same as the inbound port(s) is simplest, so that is suggested."
    local users_default
    users_default=$(suggest_user_ports "$inport")
    uport=$(ask_user_ports "Port(s) for your users" "$users_default")
    # Each port users connect to leads to one inbound port, in the same order, so
    # the two lists must be the same length.
    while [ "$(printf '%s' "$uport" | awk -F',' '{print NF}')" != "$(printf '%s' "$inport" | awk -F',' '{print NF}')" ]; do
        err "  You gave a different number of user ports than inbound ports. Each user port"
        err "  leads to one inbound port, in order, so give the same number of each."
        uport=$(ask_user_ports "Port(s) for your users" "$users_default")
    done
    ulisten="$uport"


    say ""
    info "Last port: a private one the two servers use between themselves."
    info "Your users never see it. 443 is suggested because it is the port normal"
    info "websites use, so this link does not stand out."
    if cdn_involved "$DG_CDN" "$DG_ALTHOST"; then
        info "With a CDN in the picture the CDN has to forward this port. Cloudflare forwards"
        info "only: $CDN_PORTS. Other providers, such as ArvanCloud, may allow others."
    fi
    suggest_link_port "$mode" "$target_agent" "$(cdn_involved "$DG_CDN" "$DG_ALTHOST" && echo on || echo off)"
    while :; do
        if [ "$mode" = reverse ]; then
            # Reverse: it is opened here on the Iran server, so check it here.
            local link_proto=tcp
            [ "$DG_TRANSPORT" = kcp ] && link_proto=udp
            tport=$(ask_port "Port between the two servers" "${PORT_BEST:-$DEFAULT_TUNNEL_PORT}" "" link "$link_proto")
            if printf ',%s,' "$uport" | tr -d ' ' | grep -q ",$tport,"; then
                err "  It cannot be the same as your users' port."
                continue
            fi
        else
            # Direct: it is opened on the foreign server, so it is asked of its agent.
            tport=$(ask_remote_port "Port between the two servers" "${PORT_BEST:-$DEFAULT_TUNNEL_PORT}" link)
            if printf ',%s,' "$inport" | tr -d ' ' | grep -q ",$tport,"; then
                err "  It cannot be the same as a service port on the foreign server."
                continue
            fi
            check_foreign_link_port "$tport" || continue
        fi
        # Pointed out, not refused: only Cloudflare limits the ports.
        if cdn_involved "$DG_CDN" "$DG_ALTHOST" && ! cdn_port_ok "$tport"; then
            explain_cdn_ports "$tport"
        fi
        break
    done

    if [ "$mode" = direct ]; then
        taddr=$(hostport "$peer" "$tport")
    elif [ "$V6_ON" = on ]; then
        taddr="[::]:$tport"
    else
        taddr="0.0.0.0:$tport"
    fi

    local users_ip
    if [ "$V6_ON" = on ]; then
        # The link uses the IPv6 addresses; your users still connect over IPv4.
        localip=$V6_LOCAL
        users_ip=$(public_ip)
    else
        printf '%s' "${DIM}Working out this server's own IP...${R}" >&2
        localip=$(public_ip)
        printf '\r%*s\r' 45 '' >&2
        say ""
        info "Last thing: this Iran server's own IP, the one in your users' configs."
        info "Detected: ${localip:-could not tell}"
        info "Some hosts show a different address for outgoing traffic, so please check."
        while :; do
            localip=$(ask "This Iran server's IP" "$localip")
            valid_host "$localip" && break
            err "  That does not look like an address."
        done
        users_ip=$localip
    fi

    secret=$(gen_secret)

    peer_conf=$peer
    if [ "$DG_GRE" = on ]; then
        if ! gre_plan "$localip" "$peer"; then
            err "A GRE link needs plain IPv4 addresses for both servers, and these are not:"
            err "  this server $localip, foreign server $peer"
            say "Nothing was changed."
            return 1
        fi
        if ! this_machine_has_ip "$localip"; then
            err "$localip is not an address this server has on any of its network cards."
            err "It sits behind address translation, and a GRE link cannot be made from it."
            say "Nothing was changed."
            return 1
        fi
        DG_GRE_LOCAL=$localip
        DG_GRE_REMOTE=$peer
        peer_conf=$GRE_PEER
        if [ "$mode" = direct ]; then
            taddr="$GRE_PEER:$tport"
        else
            taddr="$GRE_OWN:$tport"
        fi
    fi

    hr
    say "${B}Ready to set this up:${R}"
    say "  tunnel name        $name"
    if [ -n "$target_agent" ]; then
        say "  foreign server     $target_agent ($peer) ${GREEN}[automated 1-click via agent]${R}"
    else
        say "  foreign server     $peer ${DIM}[manual pairing code]${R}"
    fi
    say "  your users use     ${users_ip:-$localip} port $uport"
    [ "$V6_ON" = on ] && say "  the two servers    talk over IPv6: $localip and $peer"
    say "  traffic goes to    $peer port $inport"
    if [ "$DG_GRE" = on ]; then
        if [ "$mode" = direct ]; then
            say "  connection         direct: this Iran server connects out to $GRE_PEER:$tport,"
        else
            say "  connection         reverse: $peer connects in to $GRE_OWN:$tport,"
        fi
        say "                     inside a private GRE link between $localip and $peer"
    elif [ "$mode" = direct ]; then
        say "  connection         direct: this Iran server connects out to $(hostport "$peer" "$tport")"
    else
        say "  connection         reverse: $peer connects in to this Iran server on port $tport"
        if cdn_involved "$DG_CDN" "$DG_ALTHOST"; then
            say "  firewall           port $tport here left open, because the link can"
            say "                     arrive from the CDN rather than from $peer"
        else
            say "  firewall           port $tport here open to $peer only"
        fi
    fi
    say "  link appearance    $(describe_disguise "$DG_TRANSPORT" "$DG_CDN" "$DG_ALTHOST" "${DG_HTTPHOST-}")"
    [ -n "$DG_SERVERNAME" ] && say "  claims to be       $DG_SERVERNAME$DG_WSPATH"
    if [ -n "$DG_ALTHOST" ]; then
        say "  if that is blocked it moves to $DG_ALTHOST:$tport through the CDN,"
        say "                     claiming $DG_ALTHOST$DG_WSPATH from then on"
    fi
    say "  connections        $(describe_sharing "$MX_MUX" "$MX_LINKS")"
    hr
    confirm "Set it up?" || { say "Cancelled. Nothing was changed."; return 1; }

    write_tunnel "$name" "$mode" edge "$taddr" "$ulisten" "" \
        "$peer_conf" "$localip" "$pool" "$secret" "$inport"

    validate_and_enable "$name" || return 1

    ok "Done. The Iran half of '$name' is running."
    say ""

    local auto_ok=0
    if [ -n "$agent_url" ] && [ -n "$agent_token" ]; then
        # Recorded first, so a retry after a refusal knows which server to ask.
        [ -n "$target_agent" ] && write_conf "$name" foreign_agent "$target_agent"
        info "Deploying tunnel '$name' on Foreign server '$target_agent' ($agent_url)..."
        local code out
        code=$(get_tunnel_pairing_code "$name")
        if out=$(run_agent_join "$target_agent" "$agent_url" "$agent_token" "$code" 2>&1); then
            printf '%s\n' "$out" | sed 's/^/  /' >&2
            say ""
            ok "============================================================"
            ok "SUCCESS: Tunnel '$name' deployed automatically to '$target_agent'!"
            ok "Both servers are now running and linked."
            ok "============================================================"
            auto_ok=1
            report_gre_link "$name"
        else
            say ""
            err "The foreign server could not set this tunnel up:"
            printf '%s\n' "$out" | sed 's/^/    /' >&2
            say ""
            info "If a port is busy there, you can change the ports now and try again."
            info "Nothing was left behind on the foreign server."
            if confirm "Change the ports and try again?"; then
                if edit_tunnel_ports "$name" join; then
                    auto_ok=1
                fi
            fi
            if [ "$auto_ok" -eq 0 ]; then
                warn "Not deployed automatically. Falling back to the manual pairing code:"
            fi
        fi
    fi

    if [ "$auto_ok" -eq 0 ]; then
        show_pairing_code "$name"
    fi
}

# ------------------------------------------------------------------ join flow

join_tunnel() {
    local code decoded v name mode tport relay_ip server_ip inport pool secret
    local taddr inbound gre_own="" gre_peer="" gre_out

    hr
    say "${B}Join a tunnel${R}"
    say "${DIM}Do this on your foreign server, the one with your panel on it.${R}"
    say ""
    say "Paste the code your ${B}Iran server${R} showed you when you created the tunnel."
    hr
    code=$(ask "Code" "")
    [ -n "$code" ] || { err "Nothing pasted."; return 1; }

    decoded=$(printf '%s' "$code" | tr -d '[:space:]' | base64 -d 2>/dev/null) || {
        err "That code could not be read. Copy the whole line and try again."
        return 1
    }
    get() { printf '%s\n' "$decoded" | sed -nE "s/^$1=(.*)$/\1/p" | head -1; }

    v=$(get v)
    if [ "$v" = 1 ] || [ "$v" = 2 ] || [ "$v" = 3 ] || [ "$v" = 4 ]; then
        err "That code was made by an older version of PortBridge, and does not say"
        err "everything this one needs to know about the link."
        err "Update the Iran server, then create the tunnel there again for a new code."
        return 1
    fi
    if [ "$v" != 5 ] && [ "$v" != 6 ] && [ "$v" != 7 ] && [ "$v" != 8 ]; then
        err "That code was made by a newer PortBridge than this one, or is not a code."
        err "Update this server, then try again."
        return 1
    fi
    name=$(get name); mode=$(get mode); tport=$(get tunnel_port)
    relay_ip=$(get relay_ip); server_ip=$(get server_ip)
    inport=$(get inbound_port); pool=$(get pool); secret=$(get secret)

    # The disguise comes from the code, so both ends always match. Everything is
    # set every time, so nothing is left over from an earlier tunnel made in the
    # same session.
    DG_TRANSPORT=$(get transport); [ -n "$DG_TRANSPORT" ] || DG_TRANSPORT=plain
    DG_SERVERNAME=$(get server_name)
    DG_WSPATH=$(get ws_path)
    DG_CDN=$(get cdn); [ -n "$DG_CDN" ] || DG_CDN=off
    # Carried so this side knows the link may arrive from a CDN and must leave
    # its port open, even though it is the Iran server that does the dialling.
    DG_ALTHOST=$(get alt_host)
    DG_UTLS=$(get utls)
    DG_FRAGMENT=$(get tls_fragment)
    DG_CLEAN_IPS=$(get clean_ips)
    DG_HTTPHEADER=$(get http_header); [ -n "$DG_HTTPHEADER" ] || DG_HTTPHEADER=off
    DG_HTTPHOST=$(get http_host)
    # Version 8: the tunnel runs over a private GRE link between the two servers.
    DG_GRE=$(get gre); [ -n "$DG_GRE" ] || DG_GRE=off
    DG_GRE_LOCAL=""
    DG_GRE_REMOTE=""
    # Version 9: passes strangers to the real website instead of presenting our cert.
    DG_REAL_SITE=$(get real_site); [ -n "$DG_REAL_SITE" ] || DG_REAL_SITE=off
    DG_COVER_SITE=$(get cover_site)

    # So does whether connections are shared: it must match on both ends or
    # neither side would understand the other.
    MX_MUX=$(get mux); [ -n "$MX_MUX" ] || MX_MUX=off
    MX_LINKS=$(get mux_links); [ -n "$MX_LINKS" ] || MX_LINKS=4

    # Everything in the code ends up in a settings file, so it is checked for what
    # it is allowed to be before anything is written. A code pasted from somewhere
    # untrustworthy must not be able to name a path or add a setting.
    if ! valid_name "$name" || [ -z "$secret" ] || [ "${#secret}" -lt 16 ] ||
        ! valid_port "${tport:-x}" || ! valid_ports_list "${inport:-x}" || ! valid_host "$relay_ip"; then
        err "That is not a valid PortBridge code."
        return 1
    fi
    case "$mode" in direct | reverse) ;; *) err "That code has an unknown mode."; return 1 ;; esac
    case "$DG_TRANSPORT" in plain | tls | wss | h2 | grpc | kcp) ;; *) err "That code has an unknown link type."; return 1 ;; esac
    case "$DG_CDN" in on | off) ;; *) err "That code has a bad CDN setting."; return 1 ;; esac
    case "$MX_MUX" in on | off) ;; *) err "That code has a bad sharing setting."; return 1 ;; esac
    case "$DG_HTTPHEADER" in on | off) ;; *) err "That code has a bad web header setting."; return 1 ;; esac
    case "$DG_GRE" in on | off) ;; *) err "That code has a bad link setting."; return 1 ;; esac
    case "$DG_REAL_SITE" in on | off) ;; *) err "That code has a bad setting."; return 1 ;; esac
    if [ "$DG_GRE" = on ] && { [ "$DG_TRANSPORT" != plain ] || [ "$DG_CDN" = on ] || [ -n "$DG_ALTHOST" ]; }; then
        err "That code puts a GRE link together with a disguise or a CDN, which cannot work."
        return 1
    fi
    if [ -n "$DG_HTTPHOST" ] && ! valid_hostname "$DG_HTTPHOST"; then err "That code has a bad web header name."; return 1; fi
    if [ "$DG_HTTPHEADER" = on ] && [ "$DG_TRANSPORT" != plain ]; then err "That code puts a web header on a link that is not plain."; return 1; fi
    case "$DG_UTLS" in '' | on | off) ;; *) err "That code has a bad setting."; return 1 ;; esac
    case "$DG_FRAGMENT" in '' | on | off) ;; *) err "That code has a bad setting."; return 1 ;; esac
    if ! valid_port "$MX_LINKS" || [ "$MX_LINKS" -gt 16 ]; then
        err "That code has a bad number of shared connections."
        return 1
    fi
    if [ -n "$DG_SERVERNAME" ] && ! valid_host "$DG_SERVERNAME"; then err "That code has a bad server name."; return 1; fi
    if [ -n "$DG_ALTHOST" ] && ! valid_host "$DG_ALTHOST"; then err "That code has a bad backup host."; return 1; fi
    if [ -n "$server_ip" ] && ! valid_host "$server_ip"; then err "That code has a bad server address."; return 1; fi
    if [ -n "$DG_WSPATH" ]; then
        case "$DG_WSPATH" in
            /*[!a-zA-Z0-9/_.~%-]* | [!/]*) err "That code has a bad path."; return 1 ;;
        esac
    fi
    case "$DG_CLEAN_IPS" in
        *[!]0-9a-fA-F.:,[]*) err "That code has a bad address list."; return 1 ;;
    esac
    valid_port "${pool:-x}" || pool=25

    # Pasting the code back on the Iran server is an easy slip; catch it.
    if this_machine_has_ip "$relay_ip"; then
        err "This is the Iran server that made this code."
        err "Paste it on your foreign server, $server_ip, instead."
        return 1
    fi
    if [ -f "$(conf_of "$name")" ]; then
        # The same tunnel, with the same password, is a request to change its
        # ports. Any other tunnel of that name is left alone.
        if [ "$(cat "$(secret_of "$name")" 2>/dev/null)" != "$secret" ]; then
            err "A tunnel called '$name' already exists here, with a different password."
            err "Delete it first to replace it."
            return 1
        fi
        hr
        say "${B}'$name' already exists here. This code changes it to:${R}"
        say "  link port          $tport"
        say "  service port(s)    $inport"
        hr
        confirm "Change it?" || { say "Cancelled. Nothing was changed."; return 1; }
        if printf '%s' "$code" | tr -d '[:space:]' | "$BIN" join -update -code-file -; then
            ok "Done. '$name' is running on the new ports."
            return 0
        fi
        err "It was not changed. The tunnel is still running on its old settings."
        return 1
    fi

    # A tunnel over a GRE link: this server's end of the link is made when the
    # tunnel starts, so first make sure it can be, and work out the addresses.
    gre_peer=$relay_ip
    if [ "$DG_GRE" = on ]; then
        if ! gre_plan "$server_ip" "$relay_ip"; then
            err "A GRE link needs plain IPv4 addresses for both servers. This code has:"
            err "  this server ${server_ip:-(none)}, Iran server $relay_ip"
            return 1
        fi
        if ! this_machine_has_ip "$server_ip"; then
            err "$server_ip is not an address this server has on any of its network cards."
            err "It sits behind address translation, and a GRE link cannot be made from it."
            return 1
        fi
        if ! gre_out=$("$FIREWALL" gre-check 2>&1); then
            err "$gre_out"
            err "Nothing was set up. Create the tunnel again on the Iran server without GRE."
            return 1
        fi
        gre_own=$GRE_OWN
        gre_peer=$GRE_PEER
        DG_GRE_LOCAL=$server_ip
        DG_GRE_REMOTE=$relay_ip
    fi

    # Both ports are checked before anything is written. A service port is meant
    # to be in use, by the service; what it must not be is the private link port,
    # or a port one of this server's other tunnels already uses.
    local p0 owner0 bad0=0
    if [ "$mode" = direct ]; then
        owner0=$(port_owner "$tport" || true)
        if [ -n "$owner0" ]; then
            err "Port $tport (between the servers) is already used by tunnel '$owner0' here."
            bad0=1
        fi
    fi
    while IFS= read -r p0; do
        p0=$(printf '%s' "$p0" | tr -d '[:space:]')
        [ -n "$p0" ] || continue
        if [ "$mode" = direct ] && [ "$p0" = "$tport" ]; then
            err "The service port and the port between the servers are both $p0; they must differ."
            bad0=1
        fi
        owner0=$(port_owner "$p0" || true)
        if [ -n "$owner0" ]; then
            err "Service port $p0 is used by the link of tunnel '$owner0' here."
            bad0=1
        fi
    done < <(printf '%s\n' "$inport" | tr ',' '\n')
    if [ "$bad0" -eq 1 ]; then
        err "Nothing was set up. On the Iran server choose Edit a tunnel, then Change ports,"
        err "and paste the new code here."
        return 1
    fi

    hr
    say "${B}This code sets up the foreign half of:${R}"
    say "  tunnel name        $name"
    case "$relay_ip" in
        *:*) say "  link               over IPv6, with the Iran server at $relay_ip" ;;
        *) say "  your users use     $relay_ip" ;;
    esac
    say "  traffic goes to    your inbound on port $inport, on this server"
    if [ "$DG_GRE" = on ]; then
        if [ "$mode" = direct ]; then
            say "  connection         direct: $relay_ip connects in to $gre_own:$tport,"
        else
            say "  connection         reverse: this server connects out to $gre_peer:$tport,"
        fi
        say "                     inside a private GRE link between $server_ip and $relay_ip"
    elif [ "$mode" = direct ]; then
        say "  connection         direct: $relay_ip connects in to this server on port $tport"
        if cdn_involved "$DG_CDN" "$DG_ALTHOST"; then
            say "  firewall           port $tport here left open, because the link can"
            say "                     arrive from the CDN rather than from $relay_ip"
        else
            say "  firewall           port $tport here open to $relay_ip only"
        fi
    else
        say "  connection         reverse: this server connects out to $relay_ip:$tport"
        say "                     so this server needs no open port for it"
    fi
    say "  link appearance    $(describe_disguise "$DG_TRANSPORT" "$DG_CDN" "$DG_ALTHOST" "${DG_HTTPHOST-}")"
    [ -n "$DG_SERVERNAME" ] && say "  claims to be       $DG_SERVERNAME$DG_WSPATH"
    say "  connections        $(describe_sharing "$MX_MUX" "$MX_LINKS")"
    hr

    # Nothing to ask, but two things are worth checking before going ahead.
    inbound=$(echo "$inport" | awk -F',' '{for(i=1;i<=NF;i++){gsub(/^[ \t]+|[ \t]+$/,"",$i); printf (i==1?"":", ") "127.0.0.1:" $i}}')
    local first_inport=${inport%%,*}
    first_inport=$(printf '%s' "$first_inport" | tr -d '[:space:]')
    if ! timeout 3 bash -c "echo > /dev/tcp/127.0.0.1/$first_inport" 2>/dev/null; then
        warn "Nothing is answering on port $first_inport on this server."
        warn "Is Xray running, and is this the server with your panel on it?"
        confirm "Carry on anyway?" || { say "Cancelled. Nothing was changed."; return 1; }
    fi
    if [ "$mode" = direct ]; then
        local link_proto=tcp
        [ "$DG_TRANSPORT" = kcp ] && link_proto=udp
        if port_in_use_by_system "$tport" "$link_proto" || port_owner "$tport" >/dev/null; then
            err "Port $tport is already in use on this server, so the Iran server could"
            err "not connect to it. On the Iran server choose Edit a tunnel, then Change ports,"
            err "pick a free link port, and paste the new code here."
            return 1
        fi
        taddr="0.0.0.0:$tport"
        # The Iran server connecting over IPv6 means listening on IPv6; [::] takes both.
        case "$relay_ip" in *:*) taddr="[::]:$tport" ;; esac
        [ "$DG_GRE" = on ] && taddr="$gre_own:$tport"
    else
        taddr=$(hostport "$relay_ip" "$tport")
        [ "$DG_GRE" = on ] && taddr="$gre_peer:$tport"
    fi

    confirm "Set it up?" || { say "Cancelled. Nothing was changed."; return 1; }

    write_tunnel "$name" "$mode" origin "$taddr" "" "$inbound" \
        "$gre_peer" "${server_ip:-}" "$pool" "$secret"

    validate_and_enable "$name" || return 1
    report_gre_link "$name"

    say ""
    # In direct mode the Iran server has been retrying since it was set up and
    # backs off to one attempt every thirty seconds, so allow longer for that.
    local i spares="" wait_for=15 field=parked_spares
    [ "$mode" = direct ] && wait_for=40
    # With shared connections there are no spares to count, so being linked shows
    # up as a link being open instead.
    [ "$MX_MUX" = on ] && field=links
    printf '%s' "${DIM}Waiting for the two servers to find each other...${R}" >&2
    for i in $(seq 1 "$wait_for"); do
        sleep 1
        spares=$(json_field "$RUN_DIR/$name.json" "$field" 2>/dev/null)
        [ -n "$spares" ] && [ "$spares" -gt 0 ] 2>/dev/null && break
    done
    printf '\r%*s\r' 55 '' >&2

    if [ -n "$spares" ] && [ "$spares" -gt 0 ] 2>/dev/null; then
        ok "Done. Both halves of '$name' are connected."
    else
        warn "Set up, but the two servers have not found each other yet."
        warn "Use 'Check a tunnel for problems' to see why."
    fi
    say ""
    info "Test it with a config pointing at $relay_ip and your users' port."
}

# ------------------------------------------------------------------- list/status

status_line() {
    local name=$1 unit active parked active_s mode role transport cdn
    unit=$(unit_of "$name")
    active=$(systemctl is-active "$unit" 2>/dev/null)
    mode=$(read_conf "$name" mode)
    role=$(read_conf "$name" role)

    # Colour codes are invisible but still count towards a printf width, so pad
    # the plain word and wrap the colour around it separately.
    local colour state
    case "$active" in
        active)   colour=$GREEN;  state=running ;;
        inactive) colour=$DIM;    state=stopped ;;
        failed)   colour=$RED;    state=failed ;;
        *)        colour=$YELLOW; state=${active:-unknown} ;;
    esac

    # With shared connections, how many links are open is the useful number;
    # spares do not exist. Reporting an ever-present zero would read as broken.
    local mux label
    mux=$(read_conf "$name" mux); [ -n "$mux" ] || mux=off
    if [ "$mux" = on ]; then
        parked=$(json_field "$RUN_DIR/$name.json" links 2>/dev/null)
        label=links
    else
        parked=$(json_field "$RUN_DIR/$name.json" parked_spares 2>/dev/null)
        label=spares
    fi
    active_s=$(json_field "$RUN_DIR/$name.json" active_sessions 2>/dev/null)
    [ -n "$parked" ] || parked="-"
    [ -n "$active_s" ] || active_s="-"

    local job
    [ "$role" = edge ] && job="Iran side" || job="foreign side"

    transport=$(read_conf "$name" transport); [ -n "$transport" ] || transport=plain
    cdn=$(read_conf "$name" cdn); [ -n "$cdn" ] || cdn=off
    local look
    case "$transport:$cdn" in
        tls:*) look=website ;;
        h2:*) look=http2 ;;
        grpc:*) look=grpc ;;
        kcp:*) look=kcp-udp ;;
        wss:on) look=cdn ;;
        wss:*)
            if [ -n "$(read_conf "$name" alt_target)" ]; then
                look="cdn-backup"
            else
                look="websocket"
            fi
            ;;
        *) look=plain ;;
    esac
    [ "$(read_conf "$name" gre)" = on ] && look=gre
    case "$(read_conf "$name" peer_ip)" in *:*) [ "$look" = plain ] && look=ipv6 ;; esac

    # Said plainly when the tunnel has found that nothing gets through, so a row
    # that shows connections "ready" is not read as a tunnel that works.
    local pstate warn_tag=""
    pstate=$(json_field "$RUN_DIR/$name.json" path_state 2>/dev/null)
    case "$pstate" in
        blocked) warn_tag="  ${RED}NO DATA GETS THROUGH${R}" ;;
        degraded) warn_tag="  ${YELLOW}unhealthy${R}" ;;
    esac
    # A stopped or failed tunnel gets the colour of its state on the dot as well,
    # so the eye finds it before reading anything.
    printf '  %s%s%s %s%-16s%s %-8s %-12s %s%-8s%s %-10s users:%-5s %s:%s%s\n' \
        "$colour" "$DOT" "$R" "$B" "$name" "$R" "$mode" "$job" "$colour" "$state" "$R" "$look" "$active_s" "$label" "$parked" "$warn_tag"
}

list_tunnels() {
    hr
    say "${B}Tunnels on this server${R}"
    hr
    if [ "$(tunnel_count)" -eq 0 ]; then
        say "  ${DIM}None yet. Choose 'Create a tunnel' to make one.${R}"
        hr
        return 0
    fi
    local n
    # Column headings, lined up with the rows below (the two blank spaces stand
    # in for the status dot).
    printf '  %s  %-16s %-8s %-12s %-8s %-10s %s%s\n' \
        "$DIM" "NAME" "MODE" "SIDE" "STATE" "LOOKS LIKE" "ACTIVITY" "$R"
    for n in $(tunnel_names); do
        status_line "$n"
    done
    hr
    say "${DIM}users = sessions right now. spares = ready connections waiting,${R}"
    say "${DIM}or links = shared connections open, for tunnels set up that way.${R}"
}

# pick_row <number> <name> <name-width> - one line of the "which tunnel" list:
# a coloured dot for how it is doing, the name in bold, and in grey which side
# this is, the mode, the ports and the other server, so tunnels can be told apart
# without having to remember what each name was for.
pick_row() {
    local idx=$1 name=$2 width=$3
    local active colour word pstate role mode side ports port tport peer detail
    active=$(systemctl is-active "$(unit_of "$name")" 2>/dev/null)
    case "$active" in
        active)   colour=$GREEN;  word=running ;;
        inactive) colour=$DIM;    word=stopped ;;
        failed)   colour=$RED;    word=failed ;;
        *)        colour=$YELLOW; word=${active:-unknown} ;;
    esac
    # Running, but the tunnel itself has found that nothing gets through.
    if [ "$active" = active ]; then
        pstate=$(json_field "$RUN_DIR/$name.json" path_state 2>/dev/null)
        case "$pstate" in
            blocked)  colour=$RED;    word="no data" ;;
            degraded) colour=$YELLOW; word=unhealthy ;;
        esac
    fi

    role=$(read_conf "$name" role)
    mode=$(read_conf "$name" mode); [ -n "$mode" ] || mode=direct
    if [ "$role" = edge ]; then
        side="Iran side"
        port=$(read_conf "$name" user_listen)
        ports="users ${port##*:}"
    else
        side="foreign side"
        port=$(read_conf "$name" inbound_addr)
        ports="service ${port##*:}"
    fi
    tport=$(read_conf "$name" tunnel_addr)
    peer=$(other_public_ip "$name")

    detail="$side | $mode | $ports"
    [ -n "$tport" ] && detail="$detail | link ${tport##*:}"
    [ -n "$peer" ] && detail="$detail | other $peer"
    [ "$(read_conf "$name" gre)" = on ] && detail="$detail | GRE"
    case "$peer" in *:*) detail="$detail | IPv6" ;; esac
    printf '  %s%2s%s)  %s%s%s %s%-*s%s  %s%-9s%s %s%s%s\n' \
        "$NUM" "$idx" "$R" "$colour" "$DOT" "$R" "$B" "$width" "$name" "$R" \
        "$colour" "$word" "$R" "$DIM" "$detail" "$R"
}

pick_tunnel() {
    local names count n i choice
    names=$(tunnel_names)
    count=$(printf '%s\n' "$names" | grep -c . || true)
    if [ "$count" -eq 0 ]; then
        err "There are no tunnels on this server yet."
        return 1
    fi
    # Names are padded to the longest one (at most 24 wide) so the details after
    # them line up in a column.
    local width=0
    for n in $names; do
        [ "${#n}" -gt "$width" ] && width=${#n}
    done
    [ "$width" -gt 24 ] && width=24
    say "" >&2
    i=0
    for n in $names; do
        i=$((i + 1))
        pick_row "$i" "$n" "$width" >&2
    done
    say "" >&2
    choice=$(ask "Which one (number, or name)" "")
    case "$choice" in
        '' ) return 1 ;;
        *[!0-9]* ) # treated as a name
            if [ -f "$(conf_of "$choice")" ]; then printf '%s' "$choice"; return 0; fi
            err "No tunnel called '$choice'."; return 1 ;;
        * )
            i=0
            for n in $names; do
                i=$((i + 1))
                [ "$i" = "$choice" ] && { printf '%s' "$n"; return 0; }
            done
            err "That number is not on the list."; return 1 ;;
    esac
}

show_details() {
    local name=$1 f
    f="$RUN_DIR/$name.json"
    hr
    say "${B}Tunnel '$name'${R}"
    hr
    say "${B}Settings${R}"
    sed -E '/^[[:space:]]*#/d; /^[[:space:]]*$/d; s/^/  /' "$(conf_of "$name")"
    say ""
    say "${B}Service${R}"
    printf '  state          %s\n' "$(systemctl is-active "$(unit_of "$name")" 2>/dev/null)"
    printf '  starts at boot %s\n' "$(systemctl is-enabled "$(unit_of "$name")" 2>/dev/null)"
    if [ -f "$f" ]; then
        say ""
        say "${B}Live${R}"
        printf '  running for    %s seconds\n' "$(json_field "$f" uptime_seconds)"
        printf '  users now      %s\n' "$(json_field "$f" active_sessions)"
        if [ "$(read_conf "$name" mux)" = on ]; then
            printf '  links open     %s of %s\n' "$(json_field "$f" links)" "$(json_field "$f" link_target)"
            printf '  riding on them %s\n' "$(json_field "$f" link_sessions)"
        else
            printf '  spares ready   %s of %s\n' "$(json_field "$f" parked_spares)" "$(json_field "$f" pool_target)"
        fi
        printf '  failed         %s\n' "$(json_field "$f" failed_sessions)"
        printf '  turned away    %s\n' "$(json_field "$f" dropped_sessions)"
        printf '  retried        %s\n' "$(json_field "$f" retries)"
    fi
    say ""
    say "${B}Firewall${R}"
    "$FIREWALL" show "$name" 2>/dev/null | sed 's/^/  /'
    hr
}

# -------------------------------------------------------------- changing ports

# agent_for_tunnel <name> - the saved agent that manages this tunnel's foreign
# server, if there is one. Only an agent recorded for the tunnel, or one whose
# address is exactly the tunnel's other server, is ever used.
agent_for_tunnel() {
    local name=$1 a
    init_agents_dir
    a=$(read_conf "$name" foreign_agent 2>/dev/null || true)
    if [ -z "$a" ] || [ ! -f "$(agent_conf_of "$a")" ]; then
        a=$(find_agent_by_target "$(other_public_ip "$name" 2>/dev/null || true)" 2>/dev/null || true)
    fi
    if [ -n "$a" ] && [ -f "$(agent_conf_of "$a")" ]; then
        printf '%s' "$a"
        return 0
    fi
    return 1
}

# push_tunnel_to_foreign <name> <join|update>
#
# Hands the tunnel's current settings to the foreign server's agent: "join" makes
# the foreign half, "update" changes one that exists. The foreign server checks
# that both of its ports are usable before it changes anything, and says why not.
# Returns 0 done, 1 refused (reason shown), 2 no agent is linked for it.
push_tunnel_to_foreign() {
    local name=$1 how=$2 alias code out
    alias=$(agent_for_tunnel "$name") || return 2
    code=$(get_tunnel_pairing_code "$name") || return 2
    if [ "$how" = update ]; then
        info "Asking the foreign server ($alias) to change its half..."
        if out=$(printf '%s' "$code" | agent_call_alias "$alias" -update -code-file - 2>&1); then
            printf '%s\n' "$out" | sed 's/^/  /' >&2
            return 0
        fi
    else
        info "Asking the foreign server ($alias) to set up its half..."
        if out=$(printf '%s' "$code" | agent_call_alias "$alias" -code-file - 2>&1); then
            printf '%s\n' "$out" | sed 's/^/  /' >&2
            return 0
        fi
    fi
    err "The foreign server did not accept it:"
    printf '%s\n' "$out" | sed 's/^/    /' >&2
    return 1
}

# bare_ports <list> - "0.0.0.0:443, 0.0.0.0:8443" becomes "443, 8443"
bare_ports() {
    local out="" item
    while IFS= read -r item; do
        item=$(printf '%s' "$item" | tr -d '[:space:]')
        [ -n "$item" ] || continue
        if [ -n "$out" ]; then out="$out, ${item##*:}"; else out="${item##*:}"; fi
    done < <(printf '%s\n' "$1" | tr ',' '\n')
    printf '%s' "$out"
}

count_ports() { printf '%s' "$1" | awk -F',' '{print NF}'; }

# ask_port_list <prompt> <default> <tunnel> <local|remote> - one or more ports.
# For ports on this machine, one that is already taken by something else is
# flagged; ports the tunnel already has are its own and are not.
ask_port_list() {
    local prompt=$1 def=$2 name=$3 where=$4 reply item owner clean bad old_ifs
    while :; do
        reply=$(ask "$prompt" "$def")
        if ! valid_ports_list "$reply"; then
            err "  Each port must be a number from 1 to 65535 (e.g. 443, 8443, 2083)."
            continue
        fi
        clean="" bad=0 old_ifs=$IFS
        IFS=','
        for item in $reply; do
            item=$(printf '%s' "$item" | tr -d '[:space:]')
            if [ "$where" = local ]; then
                owner=$(port_owner "$item" || true)
                if [ -n "$owner" ] && [ "$owner" != "$name" ]; then
                    err "  Port $item is already used by tunnel '$owner'."
                    bad=1
                    break
                fi
                case ", $def, " in
                    *", $item, "*) : ;;
                    *)
                        if port_in_use_by_system "$item"; then
                            warn "  Something is already listening on port $item."
                            confirm "  Use it anyway?" || { bad=1; break; }
                        fi
                        ;;
                esac
            fi
            if [ -n "$clean" ]; then clean="$clean, $item"; else clean="$item"; fi
        done
        IFS=$old_ifs
        [ "$bad" -eq 0 ] || continue
        printf '%s' "$clean"
        return 0
    done
}

# edit_tunnel_ports <name> [join]
#
# Changes the three kinds of port a tunnel has, from the Iran server: the ports
# users connect to, the service ports on the foreign server they lead to, and the
# port the two servers use between themselves. The foreign server is changed to
# match, and it checks the ports first. If it refuses, nothing is changed on
# either server and the ports can be edited again. "join" is the same for a
# tunnel the foreign server does not have yet.
edit_tunnel_ports() {
    local name=$1 how=${2:-update}
    local role mode taddr host_part transport alt backup proto
    local cur_users cur_in cur_link new_users new_in new_link rc=0 n_users n_in

    role=$(read_conf "$name" role)
    if [ "$role" != edge ]; then
        info "Ports are changed from the Iran server, which then updates this one."
        info "Open this menu on the Iran server and choose Edit a tunnel."
        return 1
    fi

    mode=$(read_conf "$name" mode)
    transport=$(read_conf "$name" transport); [ -n "$transport" ] || transport=plain
    alt=$(read_conf "$name" alt_target)
    proto=tcp
    [ "$transport" = kcp ] && proto=udp
    use_foreign_agent "$(agent_for_tunnel "$name" 2>/dev/null || true)" "$name"

    backup=$(mktemp)
    cp "$(conf_of "$name")" "$backup"

    while :; do
        cur_users=$(bare_ports "$(read_conf "$name" user_listen)")
        cur_in=$(read_conf "$name" server_inbound_port | sed -E 's/[[:space:]]+//g; s/,/, /g')
        taddr=$(read_conf "$name" tunnel_addr)
        cur_link=${taddr##*:}
        host_part=${taddr%:*}

        hr
        say "${B}Change the ports of '$name'${R}"
        say "${DIM}Press Enter to keep a value. The foreign server is updated to match, and it${R}"
        say "${DIM}checks that its ports are free before anything is changed.${R}"
        hr
        say "  ${B}Users' ports${R}        where your users connect, on this Iran server"
        say "  ${B}Service ports${R}       where the service listens on the foreign server; each"
        say "                       user port leads to the service port in the same position"
        say "  ${B}Link port${R}           the private port the two servers use between themselves"
        say ""

        new_users=$(ask_port_list "Users' port(s)" "$cur_users" "$name" local)
        new_in=$(ask_port_list "Service port(s) on the foreign server" "${cur_in:-$cur_users}" "$name" remote)
        check_foreign_service_ports "$new_in" || continue
        n_users=$(count_ports "$new_users")
        n_in=$(count_ports "$new_in")
        if [ "$n_users" != "$n_in" ]; then
            err "  You gave $n_users user port(s) and $n_in service port(s). Each user port leads to"
            err "  one service port, in order, so there must be the same number of each."
            continue
        fi

        suggest_link_port "$mode" "$(agent_for_tunnel "$name" 2>/dev/null || true)" \
            "$(cdn_involved "$(read_conf "$name" cdn)" "$alt" && echo on || echo off)"
        say "${DIM}This tunnel uses $cur_link now, so it shows as busy or reserved above.${R}"
        while :; do
            if [ "$mode" = reverse ]; then
                new_link=$(ask_port "Link port (opened on this Iran server)" "$cur_link" "$name" link "$proto")
            else
                new_link=$(ask_remote_port "Link port (opened on the foreign server)" "$cur_link" link)
                check_foreign_link_port "$new_link" || continue
            fi
            if cdn_involved "$(read_conf "$name" cdn)" "$alt" && ! cdn_port_ok "$new_link"; then
                explain_cdn_ports "$new_link"
            fi
            if printf ', %s, ' "$new_users" | grep -q ", $new_link, " && [ "$mode" = reverse ]; then
                err "  The link port cannot also be one of your users' ports."
                continue
            fi
            if printf ', %s, ' "$new_in" | grep -q ", $new_link, " && [ "$mode" = direct ]; then
                err "  The link port cannot also be a service port on the foreign server."
                continue
            fi
            break
        done

        if [ "$new_users" = "$cur_users" ] && [ "$new_in" = "$cur_in" ] && [ "$new_link" = "$cur_link" ] &&
            [ "$how" = update ]; then
            rm -f "$backup"
            say "Nothing changed."
            return 0
        fi

        say ""
        say "  users connect to     $new_users"
        say "  service ports        $new_in"
        say "  link port            $new_link"
        confirm "Apply this?" || { rm -f "$backup"; say "Cancelled. Nothing was changed."; return 1; }

        write_conf "$name" user_listen "$new_users"
        write_conf "$name" server_inbound_port "$new_in"
        write_conf "$name" tunnel_addr "$host_part:$new_link"
        [ -n "$alt" ] && write_conf "$name" alt_target "${alt%:*}:$new_link"

        if ! "$BIN" check -config "$(conf_of "$name")" >/dev/null 2>&1; then
            "$BIN" check -config "$(conf_of "$name")" >&2
            err "Those ports were refused here, so nothing has been changed."
            cp "$backup" "$(conf_of "$name")"
            confirm "Try other ports?" && continue
            rm -f "$backup"
            return 1
        fi

        push_tunnel_to_foreign "$name" "$how"
        rc=$?
        if [ "$rc" -eq 1 ]; then
            cp "$backup" "$(conf_of "$name")"
            err "Nothing was changed on either server."
            if confirm "Choose different ports?"; then
                continue
            fi
            rm -f "$backup"
            return 1
        fi
        break
    done
    rm -f "$backup"

    if true; then
        "$FIREWALL" apply "$name" >/dev/null 2>&1
        systemctl restart "$(unit_of "$name")"
        sleep 2
        if [ "$(systemctl is-active "$(unit_of "$name")")" = active ]; then
            ok "Ports changed. This server is running on them."
        else
            err "This half did not come back up. Recent log:"
            journalctl -u "$(unit_of "$name")" -n 20 --no-pager
            return 1
        fi
    fi

    if [ "$rc" -eq 2 ]; then
        say ""
        warn "No linked foreign server is recorded for this tunnel, so it was not changed there."
        say "On the foreign server, choose 'Join a tunnel' and paste this code. Because the"
        say "tunnel already exists there, it offers to change its ports."
        say ""
        get_tunnel_pairing_code "$name"
        say ""
    fi
    return 0
}

edit_tunnel() {
    local name=$1 role
    role=$(read_conf "$name" role)
    hr
    say "${B}Edit '$name'${R}"
    hr
    if [ "$role" = edge ]; then
        say "  ${NUM}1${R}) Change ports ${DIM}(users, service and link ports; the foreign server follows)${R}"
        say "  ${NUM}2${R}) Change other settings ${DIM}(limits, timing, the other server's IP)${R}"
    else
        say "  ${NUM}1${R}) Change ports ${DIM}(done from the Iran server)${R}"
        say "  ${NUM}2${R}) Change other settings ${DIM}(limits, timing, your service address)${R}"
    fi
    say "  ${NUM}0${R}) Back"
    hr
    case "$(ask "Choose" "1")" in
        1) edit_tunnel_ports "$name" ;;
        2) edit_tunnel_settings "$name" ;;
        *) return 0 ;;
    esac
}
edit_tunnel_settings() {
    local name=$1 cur new changed=0 backup
    hr
    say "${B}Edit '$name'${R}"
    say "${DIM}Press Enter to keep the current value.${R}"
    hr

    # A real copy, taken before anything is touched. The previous version told
    # the user to restore from a backup that was never actually made.
    backup=$(mktemp)
    cp "$(conf_of "$name")" "$backup"

    # Which of these makes sense depends on how the tunnel was set up. Asking
    # about spares on a tunnel that has none is just confusing.
    if [ "$(read_conf "$name" mux)" = on ]; then
        say "${DIM}This tunnel shares a few connections between all users. Changing how${R}"
        say "${DIM}many is safe on its own; the other server does not have to match.${R}"
        cur=$(read_conf "$name" mux_links); [ -n "$cur" ] || cur=4
        new=$(ask "Shared connections between the servers" "$cur")
        if [ "$new" != "$cur" ]; then
            if valid_count "$new" && [ "$new" -le 16 ]; then
                write_conf "$name" mux_links "$new"; changed=1
            else
                err "  Give a number from 1 to 16; leaving it as it was."
            fi
        fi
    else
        # How many are ready is agreed by both servers, and whichever asks for
        # fewer decides. Saying so matters: changing it on one server only looks
        # like it worked and does nothing, which is easy to do and hard to spot.
        local mode role
        mode=$(read_conf "$name" mode)
        role=$(read_conf "$name" role)
        say ""
        if [ "$mode:$role" = "reverse:edge" ]; then
            info "The foreign server is the one that opens these, so it has the same"
            info "setting and the lower of the two wins. Change it there as well or"
            info "this will appear to work and nothing will happen."
        elif [ "$mode:$role" = "reverse:origin" ]; then
            info "This server is the one that opens these. The Iran server has the"
            info "same setting and will not keep more than its own number, so change"
            info "it there to match."
        else
            info "The other server has the same setting and the lower of the two wins,"
            info "so change it there to match."
        fi
        info "Worth raising if you have more users arriving at once than this number:"
        info "the ones beyond it wait while fresh connections are opened."
        cur=$(read_conf "$name" pool_size)
        new=$(ask "Connections to keep ready" "$cur")
        if [ "$new" != "$cur" ]; then
            if valid_count "$new"; then
                write_conf "$name" pool_size "$new"; changed=1
            else
                err "  Give a whole number; leaving it as it was."
            fi
        fi

        cur=$(read_conf "$name" spare_ttl)
        new=$(ask "How long a spare lives before being replaced" "$cur")
        [ "$new" != "$cur" ] && { write_conf "$name" spare_ttl "$new"; changed=1; }
    fi

    cur=$(read_conf "$name" max_conn)
    new=$(ask "Maximum users at once" "$cur")
    if [ "$new" != "$cur" ]; then
        if valid_count "$new"; then
            write_conf "$name" max_conn "$new"; changed=1
        else
            err "  Give a whole number; leaving it as it was."
        fi
    fi

    cur=$(read_conf "$name" drain)
    new=$(ask "How long to let sessions finish when restarting" "$cur")
    [ "$new" != "$cur" ] && { write_conf "$name" drain "$new"; changed=1; }

    if [ "$(read_conf "$name" gre)" = on ]; then
        # The addresses of a GRE link come from the two public addresses, so
        # changing one means a different link, and a different tunnel.
        say "${DIM}This tunnel runs over a private GRE link, so the other server's IP cannot${R}"
        say "${DIM}be changed here. Delete the tunnel and create it again for a new server.${R}"
    else
        cur=$(read_conf "$name" peer_ip)
        new=$(ask "The other server's IP" "$cur")
        if [ "$new" != "$cur" ] && valid_host "$new"; then
            write_conf "$name" peer_ip "$new"
            # Keep the dial target in step with it.
            local taddr
            taddr=$(read_conf "$name" tunnel_addr)
            case "$taddr" in
                0.0.0.0:*|:::*|\[::\]:*) : ;;
                *) write_conf "$name" tunnel_addr "$(hostport "$new" "${taddr##*:}")" ;;
            esac
            changed=1
        fi
    fi

    local role cur_u
    role=$(read_conf "$name" role)
    if [ "$role" != edge ]; then
        say "${DIM}The service address is where this server sends your users' traffic. The ports${R}"
        say "${DIM}it leads from are changed on the Iran server (Edit, Change ports).${R}"
        cur_u=$(read_conf "$name" inbound_addr)
        new=$(ask "Your inbound on this server" "$cur_u")
        [ "$new" != "$cur_u" ] && { write_conf "$name" inbound_addr "$new"; changed=1; }
    fi

    if [ "$changed" -eq 0 ]; then
        rm -f "$backup"
        say "Nothing changed."
        return 0
    fi

    if ! "$BIN" check -config "$(conf_of "$name")"; then
        err "Those settings were refused, so nothing has been changed."
        cp "$backup" "$(conf_of "$name")"
        rm -f "$backup"
        ok "The previous settings have been put back. The tunnel is untouched."
        return 1
    fi
    rm -f "$backup"
    if confirm "Restart '$name' now to apply this?"; then
        "$FIREWALL" apply "$name" >/dev/null 2>&1
        systemctl restart "$(unit_of "$name")"
        sleep 2
        if [ "$(systemctl is-active "$(unit_of "$name")")" = active ]; then
            ok "Applied and running."
        else
            err "It did not come back up. Recent log:"
            journalctl -u "$(unit_of "$name")" -n 20 --no-pager
        fi
    else
        warn "Saved. It will take effect next time the tunnel restarts."
    fi
}

delete_tunnel() {
    local name=$1
    local role peer_name
    role=$(read_conf "$name" role)
    if [ "$role" = edge ]; then
        peer_name="foreign server"
    else
        peer_name="Iran server"
    fi

    hr
    warn "This will stop and remove tunnel '$name' on this server."
    say "${DIM}It will also automatically remove the corresponding tunnel from the $peer_name.${R}"
    hr
    confirm "Delete '$name'?" || { say "Cancelled."; return 1; }

    say ""
    info "Contacting $peer_name to delete its tunnel half..."
    local deleted_remote=no
    if "$BIN" teardown -config "$(conf_of "$name")" 2>/dev/null; then
        deleted_remote=yes
    fi

    if [ "$deleted_remote" = no ] && [ "$role" = edge ]; then
        init_agents_dir
        local target_agent
        target_agent=$(read_conf "$name" foreign_agent 2>/dev/null || true)
        if [ -z "$target_agent" ] || [ ! -f "$(agent_conf_of "$target_agent")" ]; then
            # Only an agent whose address is exactly this tunnel's other server
            # is used. Falling back to "the last agent linked" could delete a
            # tunnel of the same name on a different server.
            target_agent=$(find_agent_by_target "$(other_public_ip "$name" 2>/dev/null || true)" 2>/dev/null || true)
        fi
        if [ -n "$target_agent" ] && [ -f "$(agent_conf_of "$target_agent")" ]; then
            if agent_call_alias "$target_agent" -delete "$name" >/dev/null 2>&1; then
                deleted_remote=yes
            fi
        fi
    fi

    if [ "$deleted_remote" = yes ]; then
        ok "$peer_name: tunnel '$name' successfully deleted."
    else
        warn "Could not reach or delete the tunnel on the $peer_name."
        warn "The other server might be unreachable or already removed."
        warn "Remember to clean it up manually if needed."
    fi
    say ""

    systemctl disable --now "$(unit_of "$name")" >/dev/null 2>&1
    "$FIREWALL" remove "$name" >/dev/null 2>&1
    # The certificate goes too. Left behind, a later tunnel with the same name
    # would pick it up and claim whatever hostname this one claimed.
    rm -f "$(conf_of "$name")" "$(secret_of "$name")" "$RUN_DIR/$name.json" \
        "$RUN_DIR/$name.sock" "$CONF_DIR/$name.crt" "$CONF_DIR/$name.key"
    systemctl daemon-reload
    # Whatever the steps above or the other server's clean-up missed, now that the
    # settings are gone nothing of this tunnel's can be mistaken for something wanted.
    "$FIREWALL" sweep quiet >/dev/null 2>&1
    ok "Tunnel '$name' removed."
}

show_logs() {
    local name=$1
    hr
    say "${B}Recent log for '$name'${R} ${DIM}(newest last)${R}"
    hr
    journalctl -u "$(unit_of "$name")" -n 40 --no-pager
    hr
    if confirm "Watch it live? (Ctrl+C to stop)"; then
        journalctl -u "$(unit_of "$name")" -f --no-pager
    fi
}

test_tunnel() {
    local name=$1 role ulisten taddr mode
    role=$(read_conf "$name" role)
    mode=$(read_conf "$name" mode)
    hr
    say "${B}Checking '$name'${R}"
    hr

    # Results are printed on stdout alongside their label. Sending one to stdout
    # and the other to stderr looks fine on a terminal but arrives scrambled the
    # moment the output is redirected or captured.
    local pass=0 fail=0
    result() { # result <label> <good|bad|note> <detail>
        local colour
        case "$2" in
            good) colour=$GREEN; pass=$((pass + 1)) ;;
            bad)  colour=$RED;   fail=$((fail + 1)) ;;
            *)    colour=$DIM ;;
        esac
        printf '  %-26s %s%s%s\n' "$1" "$colour" "$3" "$R"
    }
    note() { printf '     %s%s%s\n' "$DIM" "$1" "$R"; }

    if [ "$(systemctl is-active "$(unit_of "$name")")" = active ]; then
        result "service running" good "yes"
    else
        result "service running" bad "no"
        note "Start it from the menu, or look at the log for why it stopped."
    fi

    # A tunnel over a GRE link depends on the link being up at both ends.
    if [ "$(read_conf "$name" gre)" = on ]; then
        local greout
        if greout=$("$FIREWALL" gre-test "$name" 2>&1); then
            result "private GRE link" good "$greout"
        else
            result "private GRE link" bad "$greout"
            note "GRE (IP protocol 47) may be dropped between these two servers, or the other"
            note "end of the link is not set up yet. The tunnel cannot carry data without it."
        fi
    fi

    # Settings may list several addresses, so each is checked in turn.
    local item
    if [ "$role" = edge ]; then
        ulisten=$(read_conf "$name" user_listen)
        while IFS= read -r item; do
            item=$(printf '%s' "$item" | tr -d '[:space:]')
            [ -n "$item" ] || continue
            if port_in_use_by_system "${item##*:}"; then
                result "listening for users" good "yes, port ${item##*:}"
            else
                result "listening for users" bad "no, port ${item##*:}"
            fi
        done < <(printf '%s\n' "$ulisten" | tr ',' '\n')
    else
        local inbound
        inbound=$(read_conf "$name" inbound_addr)
        while IFS= read -r item; do
            item=$(printf '%s' "$item" | tr -d '[:space:]')
            [ -n "$item" ] || continue
            if timeout 5 bash -c "echo > /dev/tcp/${item%:*}/${item##*:}" 2>/dev/null; then
                result "local service reachable" good "yes, $item"
            else
                result "local service reachable" bad "no, cannot reach $item"
                note "Is the service actually running on this server?"
            fi
        done < <(printf '%s\n' "$inbound" | tr ',' '\n')
    fi

    taddr=$(read_conf "$name" tunnel_addr)
    local link_proto=tcp
    [ "$(read_conf "$name" transport)" = kcp ] && link_proto=udp
    if [ "$mode:$role" = "direct:edge" ] || [ "$mode:$role" = "reverse:origin" ]; then
        if [ "$link_proto" = udp ]; then
            # A UDP port cannot be probed by connecting to it; whether the two
            # servers are linked, below, is the real answer.
            result "other server reachable" note "UDP, cannot be probed; see whether the servers are linked below"
        elif timeout 8 bash -c "echo > /dev/tcp/$(bare_host "$taddr")/${taddr##*:}" 2>/dev/null; then
            result "other server reachable" good "yes, $taddr"
        else
            result "other server reachable" bad "no, cannot reach $taddr"
            note "Either the other half is not running, or its firewall is not"
            note "allowing this server's address."
        fi
    else
        if port_in_use_by_system "${taddr##*:}" "$link_proto"; then
            result "waiting on tunnel port" good "yes, port ${taddr##*:}"
        else
            result "waiting on tunnel port" bad "no"
        fi
    fi

    local f spares mux ready
    f="$RUN_DIR/$name.json"
    mux=$(read_conf "$name" mux); [ -n "$mux" ] || mux=off
    if [ "$mux" = on ]; then
        spares=$(json_field "$f" links 2>/dev/null)
        ready="shared connections open"
    else
        spares=$(json_field "$f" parked_spares 2>/dev/null)
        ready="connections ready"
    fi
    if [ -n "$spares" ] && [ "$spares" -gt 0 ] 2>/dev/null; then
        result "both servers linked" good "yes, $spares $ready"
    else
        result "both servers linked" bad "no, the two servers are not talking"
        note "Make sure the tunnel is set up on both servers, that the code was"
        note "pasted on the foreign server, and that both clocks are correct."
    fi

    # Whether data really flows, as measured by the tunnel itself. Connections
    # being ready proves nothing: a route that lets a few packets through and
    # then cuts the connection leaves every one of them looking fine.
    local pstate pnote
    pstate=$(json_field "$f" path_state 2>/dev/null)
    pnote=$(sed -nE 's/^[[:space:]]*"path_note"[[:space:]]*:[[:space:]]*"(.*)",?[[:space:]]*$/\1/p' "$f" 2>/dev/null | head -1)
    case "$pstate" in
        ok) result "data flows" good "yes, checked by the tunnel" ;;
        blocked)
            result "data flows" bad "no, connections open but nothing gets through"
            note "${pnote:-The route between the servers is cutting connections.}"
            note "This is usually the route being filtered, not a fault in PortBridge."
            note "Use a backup route through a CDN, or another address or server."
            ;;
        degraded)
            result "data flows" bad "doubtful"
            note "${pnote:-Something is wrong on the route between the servers.}"
            ;;
        *) result "data flows" note "not measured yet" ;;
    esac

    local transport cdn
    transport=$(read_conf "$name" transport); [ -n "$transport" ] || transport=plain
    cdn=$(read_conf "$name" cdn); [ -n "$cdn" ] || cdn=off
    local alt
    alt=$(read_conf "$name" alt_target)
    result "link appearance" note "$(describe_disguise "$transport" "$cdn" "$alt" "$(http_header_host "$name")")"
    result "connections" note "$(describe_sharing "$mux" "$(read_conf "$name" mux_links)")"

    # Only Cloudflare limits the ports, so this is a reminder and never a failure.
    if cdn_involved "$cdn" "$alt" && ! cdn_port_ok "${taddr##*:}"; then
        result "CDN port" note "${taddr##*:} is not a Cloudflare port"
        note "Cloudflare forwards only: $CDN_PORTS"
        note "Another provider, such as ArvanCloud, may forward it; make sure yours does."
    fi

    if [ -n "$alt" ]; then
        if timeout 8 bash -c "echo > /dev/tcp/${alt%:*}/${alt##*:}" 2>/dev/null; then
            result "backup route" good "ready, $alt"
        else
            result "backup route" bad "cannot reach $alt"
            note "If the main route ever fails, this one would not take over."
            note "Check the domain points at your CDN with its proxy turned on, and"
            note "that the CDN is set to forward this port."
        fi
        # Which route is carrying the tunnel right now comes from the engine,
        # which is the only thing that knows. Reading it out of the log instead
        # got it wrong as soon as a tunnel recovered: it would go on reporting
        # the backup long after the main address came back.
        local backup
        backup=$(json_field "$f" on_backup_route 2>/dev/null)
        if [ "$backup" = true ]; then
            result "route in use" note "the backup, $(json_field "$f" route_in_use)"
        else
            result "route in use" note "the main address"
        fi
    fi

    # A mismatched disguise looks exactly like a wrong password from the log, so
    # call it out separately or it sends people hunting the wrong problem.
    #
    # Only worth raising while the two servers are not talking. If the link is up,
    # they evidently agree, and complaining about it on the strength of an old log
    # line sends someone to rebuild a tunnel that is working perfectly well.
    local tlsfail=0
    if [ -z "$spares" ] || [ "$spares" -le 0 ] 2>/dev/null; then
        tlsfail=$(journalctl -u "$(unit_of "$name")" --since "-10 min" --no-pager 2>/dev/null |
            grep -ciE 'securing the link failed|websocket upgrade' || true)
    fi
    if [ "${tlsfail:-0}" -gt 0 ]; then
        say ""
        printf '  %s%s%s\n' "$RED" "The two servers disagree about how the link should look." "$R"
        note "Delete this tunnel on your foreign server and join again with a fresh"
        note "code from your Iran server, so both ends match."
        fail=$((fail + 1))
    fi

    local empties
    empties=$(json_field "$f" empty_connections 2>/dev/null)
    if [ -n "$empties" ] && [ "$empties" -gt 0 ] 2>/dev/null; then
        result "ignored port scans" note "$empties"
    fi

    local rejects skew
    rejects=$(journalctl -u "$(unit_of "$name")" --since "-10 min" --no-pager 2>/dev/null |
        grep -ci 'wrong or missing secret' || true)
    skew=$(journalctl -u "$(unit_of "$name")" --since "-10 min" --no-pager 2>/dev/null |
        grep -ci 'clocks differ' || true)

    # Same reasoning as above: while the link is up, refusals are strangers
    # knocking on a public port, not the other server failing to get in.
    local linked=no
    [ -n "$spares" ] && [ "$spares" -gt 0 ] 2>/dev/null && linked=yes

    if [ "${rejects:-0}" -gt 0 ]; then
        if [ "$linked" = yes ]; then
            result "turned away wrong password" note "$rejects, from somewhere that is not your other server"
        else
            say ""
            printf '  %s%s%s\n' "$RED" "The password does not match: $rejects refusals in the last 10 minutes." "$R"
            note "Delete this tunnel on your foreign server, then join again with the"
            note "code from 'Show a tunnel's code' on your Iran server."
            fail=$((fail + 1))
        fi
    fi
    if [ "${skew:-0}" -gt 0 ] && [ "$linked" = no ]; then
        say ""
        printf '  %s%s%s\n' "$RED" "The two servers' clocks disagree." "$R"
        note "Run this on both: timedatectl set-ntp true"
        fail=$((fail + 1))
    fi

    hr
    if [ "$fail" -eq 0 ]; then
        printf '  %s%s%s\n' "$GREEN" "Everything checks out." "$R"
    else
        printf '  %s%s%s\n' "$RED" "$fail problem(s) found, listed above." "$R"
    fi
    hr
}

uninstall_all() {
    hr
    warn "This removes PortBridge and every tunnel on this server."
    hr
    confirm "Are you sure?" || { say "Cancelled."; return 1; }
    confirm "Really sure? This cannot be undone." || { say "Cancelled."; return 1; }

    local n
    for n in $(tunnel_names); do
        systemctl disable --now "$(unit_of "$n")" >/dev/null 2>&1
        "$FIREWALL" remove "$n" >/dev/null 2>&1
    done
    # Anything of PortBridge's still in the firewall, or any GRE link, whether or
    # not a tunnel was left to name it.
    "$FIREWALL" sweep all >/dev/null 2>&1
    systemctl disable --now "$AGENT_UNIT" >/dev/null 2>&1
    rm -f /etc/systemd/system/portbridge@.service /etc/systemd/system/portbridge-agent.service
    systemctl daemon-reload
    rm -rf /etc/portbridge "$RUN_DIR"
    # Put the network settings back before removing the helper that manages them.
    [ -x "$TUNE" ] && "$TUNE" undo >/dev/null 2>&1
    rm -f "$BIN" "$FIREWALL" "$TUNE" /usr/local/bin/portbridge-menu
    ok "PortBridge has been removed."
    say "${DIM}Any firewall rules it added have been taken out too.${R}"
    exit 0
}

speedtest_tunnel() {
    local name=$1
    hr
    say "${B}Speed testing tunnel '$name'...${R}"
    "$BIN" speedtest "$name"
}

# ------------------------------------------------------------- management agent

init_agents_dir() {
    mkdir -p "$AGENTS_DIR"
    chmod 700 "$AGENTS_DIR"
    if [ -f "$AGENT_CLIENT_CONF" ]; then
        local existing_count
        existing_count=$(agent_count)
        if [ "$existing_count" -eq 0 ]; then
            local u t
            u=$(read_file_key "$AGENT_CLIENT_CONF" url)
            t=$(read_file_key "$AGENT_CLIENT_CONF" token)
            if [ -n "$u" ] && [ -n "$t" ]; then
                local def_alias="foreign-1"
                local def_ip="${u#*://}"
                def_ip="${def_ip%%:*}"
                [ -n "$def_ip" ] && def_alias="$def_ip"
                write_file_key "$AGENTS_DIR/${def_alias}.conf" alias "$def_alias"
                write_file_key "$AGENTS_DIR/${def_alias}.conf" url "$u"
                write_file_key "$AGENTS_DIR/${def_alias}.conf" token "$t"
                write_file_key "$AGENTS_DIR/${def_alias}.conf" server_ip "$def_ip"
                local old_fp
                old_fp=$(read_file_key "$AGENT_CLIENT_CONF" fingerprint)
                [ -n "$old_fp" ] && write_file_key "$AGENTS_DIR/${def_alias}.conf" fingerprint "$old_fp"
                chmod 600 "$AGENTS_DIR/${def_alias}.conf"
            fi
        fi
    fi
}

agent_names() {
    [ -d "$AGENTS_DIR" ] || return 0
    for f in "$AGENTS_DIR"/*.conf; do
        [ -e "$f" ] || continue
        basename "$f" .conf
    done
}

agent_count() { agent_names | wc -l | tr -d ' '; }

agent_conf_of() { printf '%s/%s.conf' "$AGENTS_DIR" "$1"; }

find_agent_by_target() {
    local target=$1 f
    [ -d "$AGENTS_DIR" ] || return 1
    for f in "$AGENTS_DIR"/*.conf; do
        [ -f "$f" ] || continue
        local ip u
        ip=$(read_file_key "$f" server_ip)
        u=$(read_file_key "$f" url)
        # The address has to be the whole host of the saved link. It used to be
        # matched as a pattern anywhere in the link, so 1.2.3.4 also matched
        # 11.2.3.45, and a tunnel could be deleted from the wrong server.
        local host=${u#*://}
        host=${host%%/*}
        host=${host%:*}
        host=${host#\[}
        host=${host%\]}
        if [ -n "$target" ] && { [ "$ip" = "$target" ] || [ "$host" = "$target" ]; }; then
            basename "$f" .conf
            return 0
        fi
    done
    return 1
}

# agent_call <url> <token> <fingerprint> <arguments to "portbridge join"...>
#
# Runs the agent client with the token handed over in a private file rather than
# on the command line, where every user on the machine can read it.
agent_call() {
    local url=$1 tok=$2 fp=$3 tf rc
    shift 3
    tf=$(mktemp) || return 1
    chmod 600 "$tf"
    printf '%s' "$tok" >"$tf"
    local args=(join -agent-url "$url" -token-file "$tf")
    [ -n "$fp" ] && args+=(-fingerprint "$fp")
    "$BIN" "${args[@]}" "$@"
    rc=$?
    rm -f "$tf"
    return $rc
}

# agent_call_alias <alias> <arguments...> - the same, using a saved profile.
agent_call_alias() {
    local f
    f=$(agent_conf_of "$1")
    shift
    agent_call "$(read_file_key "$f" url)" "$(read_file_key "$f" token)" "$(read_file_key "$f" fingerprint)" "$@"
}

# run_agent_join <alias> <url> <token> <code> - hands a pairing code to the agent
# on the foreign server. The code holds the tunnel's password, so it goes in on
# standard input.
run_agent_join() {
    local alias=$1 url=$2 tok=$3 code=$4 fp=""
    [ -n "$alias" ] && [ -f "$(agent_conf_of "$alias")" ] && fp=$(read_file_key "$(agent_conf_of "$alias")" fingerprint)
    printf '%s' "$code" | agent_call "$url" "$tok" "$fp" -code-file -
}

# agent_fingerprint - the fingerprint of this server's agent certificate, which
# the Iran server pins so it knows it is talking to the real agent.
agent_fingerprint() {
    "$BIN" agent -config "$AGENT_CONF" -fingerprint 2>/dev/null | tail -1
}

find_free_agent_port() {
    local p
    for p in 2083 2087 2053 8443 2096; do
        if ! port_in_use_by_system "$p"; then
            echo "$p"
            return 0
        fi
    done
    echo "2083"
}

enable_agent() {
    hr
    say "${B}Enable Foreign Management Agent Daemon${R}"
    say "${DIM}Runs the PortBridge HTTPS management daemon on THIS Foreign server.${R}"
    say "${DIM}Allows your Iran server(s) to deploy and manage tunnels remotely.${R}"
    hr

    # An agent that is already running holds its own port, which made that port
    # look taken and sent the setup off to pick a different one every time. It is
    # stopped first (and started again below), so its own port counts as free.
    if [ "$(systemctl is-active "$AGENT_UNIT" 2>/dev/null)" = active ]; then
        systemctl stop "$AGENT_UNIT" >/dev/null 2>&1
    fi

    local cur_listen cur_port def_port
    cur_listen=$(read_file_key "$AGENT_CONF" listen 2>/dev/null || true)
    cur_port=${cur_listen##*:}
    if [ -n "$cur_port" ] && ! port_in_use_by_system "$cur_port"; then
        def_port="$cur_port"
    else
        def_port=$(find_free_agent_port)
    fi

    say "Agent listens over TLS. Cloudflare CDN supports: 2083, 2087, 2053, 8443, 2096."
    local p
    while :; do
        p=$(ask "Agent listen port" "$def_port")
        if ! valid_port "$p"; then
            err "  A port must be a number from 1 to 65535."
            continue
        fi
        if port_in_use_by_system "$p"; then
            err "Port $p is already in use by another process on this server!"
            local owner
            owner=$(ss -tulpn 2>/dev/null | grep ":$p " | head -n 1)
            [ -n "$owner" ] && info "In use by: $owner"
            warn "Please choose a different port."
        else
            break
        fi
    done

    local tok
    tok=$(read_file_key "$AGENT_CONF" token 2>/dev/null || true)
    if [ -z "$tok" ]; then
        tok=$(gen_agent_token)
    fi

    write_file_key "$AGENT_CONF" listen "0.0.0.0:$p"
    write_file_key "$AGENT_CONF" token "$tok"
    chmod 600 "$AGENT_CONF"

    systemctl daemon-reload
    systemctl enable "$AGENT_UNIT" >/dev/null 2>&1 || {
        err "Could not enable $AGENT_UNIT. Check systemctl status $AGENT_UNIT."
        return 1
    }
    # Restarted, not just started. "enable --now" leaves an agent that is already
    # running alone, so it kept listening on its old port while the link string
    # printed below named the new one, and nothing could connect.
    systemctl restart "$AGENT_UNIT" >/dev/null 2>&1 || {
        err "Could not start $AGENT_UNIT. Check systemctl status $AGENT_UNIT."
        return 1
    }
    sleep 2
    if [ "$(systemctl is-active "$AGENT_UNIT" 2>/dev/null)" = active ] && ! port_in_use_by_system "$p"; then
        err "The agent is running but is not listening on port $p."
        journalctl -u "$AGENT_UNIT" -n 10 --no-pager
        return 1
    fi
    if [ "$(systemctl is-active "$AGENT_UNIT" 2>/dev/null)" = active ]; then
        local my_ip afp
        my_ip=$(public_ip)
        afp=$(agent_fingerprint)
        say ""
        ok "Foreign Management Agent is now ACTIVE and running on port $p!"
        hr
        say "  ${B}Copy this Link String to your Iran server:${R}"
        print_agent_links "$tok" "$my_ip" "$p" "$afp"
        say ""
        say "  ${DIM}On your Iran server, open 'portbridge' -> Option 12 -> Option 2 (Link a new Foreign server)${R}"
        say "  ${DIM}and paste the link string above.${R}"
        hr
        return 0
    else
        err "Agent failed to start on port $p. Recent log:"
        journalctl -u "$AGENT_UNIT" -n 20 --no-pager
        return 1
    fi
}

show_agent_link() {
    hr
    say "${B}Foreign Management Agent Link String${R}"
    hr
    if [ ! -f "$AGENT_CONF" ]; then
        warn "The Agent daemon has not been enabled on this server yet."
        warn "Use option 'Enable & start Agent daemon' first."
        return 1
    fi

    local tok listen p my_ip st afp
    tok=$(read_file_key "$AGENT_CONF" token)
    listen=$(read_file_key "$AGENT_CONF" listen)
    p=${listen##*:}
    my_ip=$(public_ip)
    st=$(systemctl is-active "$AGENT_UNIT" 2>/dev/null || echo "inactive")
    afp=$(agent_fingerprint)

    # The link string names the port in the settings file. If the agent was
    # started before that was changed it is still on the old port, and a link
    # that names the new one can never connect. Say so, and offer the fix.
    if [ "$st" = active ] && [ -n "$p" ] && ! port_in_use_by_system "$p"; then
        warn "  The agent is running but is NOT listening on port $p (the port in its settings)."
        warn "  It was probably started before the port was changed."
        if confirm "  Restart the agent now so it uses port $p?"; then
            systemctl restart "$AGENT_UNIT"
            sleep 2
            if port_in_use_by_system "$p"; then
                ok "  Restarted. It is now listening on port $p."
            else
                err "  Still not listening on port $p. Recent log:"
                journalctl -u "$AGENT_UNIT" -n 10 --no-pager
            fi
        fi
    fi

    say "  Status:         $st"
    say "  Listen address: ${listen:-0.0.0.0:2083}"
    say "  Agent Token:    $tok"
    say "  Server IP:      $my_ip"
    say "  Certificate:    ${afp:-unknown}"
    say ""
    say "  ${B}Iran Link String:${R}"
    print_agent_links "$tok" "$my_ip" "$p" "$afp"
    say ""
    say "  ${DIM}Copy the link string above and paste it in Option 12 -> Option 2 on your Iran server.${R}"
    hr
}

disable_agent() {
    hr
    confirm "Stop and disable the Foreign Management Agent on this server?" || return 0
    systemctl disable --now "$AGENT_UNIT" >/dev/null 2>&1
    ok "Agent stopped and disabled."
}

change_agent_port() {
    hr
    say "${B}Change Agent Listen Port${R}"
    say "${DIM}Note: Cloudflare HTTPS supports ports 443, 2053, 2083, 2087, 2096, 8443.${R}"
    hr
    local cur_listen cur_port p
    cur_listen=$(read_file_key "$AGENT_CONF" listen 2>/dev/null || true)
    cur_port=${cur_listen##*:}
    [ -n "$cur_port" ] || cur_port=2083
    while :; do
        p=$(ask "New Agent listen port" "$cur_port")
        if ! valid_port "$p"; then
            err "  A port must be a number from 1 to 65535."
            continue
        fi
        if port_in_use_by_system "$p" && [ "$p" != "$cur_port" ]; then
            err "Port $p is already in use by another process!"
            local owner
            owner=$(ss -tulpn 2>/dev/null | grep ":$p " | head -n 1)
            [ -n "$owner" ] && info "In use by: $owner"
            warn "Please choose a different port."
        else
            break
        fi
    done
    write_file_key "$AGENT_CONF" listen "0.0.0.0:$p"
    if [ "$(systemctl is-active "$AGENT_UNIT" 2>/dev/null)" = active ]; then
        systemctl restart "$AGENT_UNIT"
        ok "Agent restarted on port $p."
    else
        ok "Saved. Start agent to apply."
    fi
}

regen_agent_token() {
    hr
    warn "Regenerating the token will invalidate existing links on your Iran server(s)."
    confirm "Generate a new Agent token?" || return 0
    local tok
    tok=$(gen_agent_token)
    write_file_key "$AGENT_CONF" token "$tok"
    if [ "$(systemctl is-active "$AGENT_UNIT" 2>/dev/null)" = active ]; then
        systemctl restart "$AGENT_UNIT"
    fi
    ok "New token generated: $tok"
    say ""
    show_agent_link
}

list_foreign_agents() {
    init_agents_dir
    hr
    say "${B}Linked Foreign Servers${R}"
    say "${DIM}These foreign servers can be automatically configured from this Iran server.${R}"
    hr
    local count
    count=$(agent_count)
    if [ "$count" -eq 0 ]; then
        warn "No foreign servers linked yet."
        say "Use Option 2 ('Link a new Foreign server') to add one."
        hr
        return 0
    fi

    printf "  %s%-15s %-25s %-12s %s%s\n" "$DIM" "ALIAS" "ADDRESS" "STATUS" "ACTIVE TUNNELS" "$R"
    local name
    for name in $(agent_names); do
        local f u out st="ONLINE" tun="?"
        f=$(agent_conf_of "$name")
        u=$(read_file_key "$f" url)

        local hostport="${u#*://}"
        out=$(agent_call_alias "$name" -status 2>&1 || true)
        if echo "$out" | grep -qi "status: OK"; then
            st="${GREEN}ONLINE${R}"
            local tun_info
            tun_info=$(echo "$out" | grep -i "active tunnels:" | sed -E 's/.*active tunnels:[[:space:]]*//' || true)
            [ -n "$tun_info" ] && tun="$tun_info"
        else
            st="${RED}OFFLINE${R}"
            tun="unreachable"
        fi
        printf "  %s%-15s%s %-25s %-21b %s\n" "$B" "$name" "$R" "$hostport" "$st" "$tun"
    done
    hr
}

# shellcheck disable=SC2120
link_foreign_agent() {
    init_agents_dir
    local default_ip=${1-}
    LAST_LINKED_AGENT=""

    hr
    say "${B}Link a new Foreign Management Agent${R}"
    say "${DIM}Enables 1-click automated tunnel deployment to that foreign server.${R}"
    say "${DIM}You can paste the Link String from the foreign server (pb-agent://...),${R}"
    say "${DIM}or enter the foreign server IP/domain, agent port, and token manually.${R}"
    say "${DIM}If ordinary IPv4 does not work between the two servers, use the foreign${R}"
    say "${DIM}server's IPv6 address instead; the agent answers on both.${R}"
    hr

    local input
    input=$(ask "Agent Link String or Foreign Server IP" "$default_ip")
    [ -n "$input" ] || { err "Nothing entered."; return 1; }

    # A host is a name or IPv4 address, or an IPv6 address in square brackets.
    local host_re='(\[[0-9a-fA-F:]+\]|[^/:?]+)'
    local target_host="" target_port="" tok="" fp=""
    if [[ "$input" =~ ^pb-agent://([^@]+)@${host_re}(:([0-9]+))?(\?fp=([0-9a-fA-F:]+))? ]]; then
        tok="${BASH_REMATCH[1]}"
        target_host="${BASH_REMATCH[2]}"
        target_port="${BASH_REMATCH[4]}"
        fp="${BASH_REMATCH[6]}"
    elif [[ "$input" =~ ^https?://${host_re}(:([0-9]+))? ]]; then
        target_host="${BASH_REMATCH[1]}"
        target_port="${BASH_REMATCH[3]}"
    elif [[ "$input" =~ ^${host_re}:([0-9]+)$ ]]; then
        target_host="${BASH_REMATCH[1]}"
        target_port="${BASH_REMATCH[2]}"
    else
        target_host="$input"
    fi
    target_host=${target_host#\[}
    target_host=${target_host%\]}

    say ""
    while :; do
        target_host=$(ask "Foreign server IP or Domain" "$target_host")
        target_host=${target_host#\[}
        target_host=${target_host%\]}
        if valid_host "$target_host"; then
            break
        fi
        err "Please enter a valid IP address or domain."
    done

    say ""
    info "The port PortBridge Agent daemon is listening on (Foreign Server Option 5/6)."
    info "Common ports: 2083, 2087, 2053, 8443, 2096, 443."
    target_port=$(ask_remote_port "Foreign server Agent port" "${target_port:-2083}")

    say ""
    while :; do
        tok=$(ask "Agent Bearer Token" "$tok")
        if [ -n "$tok" ]; then
            break
        fi
        err "Agent token cannot be empty."
    done

    local def_alias="$target_host"
    # An IPv6 address is no use as a nickname once its colons are gone.
    case "$target_host" in *:*) def_alias="foreign" ;; esac
    local alias
    say ""
    while :; do
        alias=$(ask "Alias / Nickname for this server (e.g. germany, vps1)" "$def_alias")
        alias=$(printf '%s' "$alias" | tr -dc 'a-zA-Z0-9_-')
        if [ -z "$alias" ]; then
            err "Please enter a valid alias (letters, digits, dashes, underscores)."
            continue
        fi
        if [ -f "$(agent_conf_of "$alias")" ]; then
            if ! confirm "An agent named '$alias' already exists. Overwrite?"; then
                continue
            fi
        fi
        break
    done

    local url
    url="https://$(hostport "$target_host" "$target_port")"

    # The agent's certificate is self-signed, so it is recognised by its
    # fingerprint. A link string carries it. Without one, it is read from the
    # server and the person checks it against what the server itself shows,
    # which is the one step that proves this really is their server.
    if [ -z "$fp" ]; then
        say ""
        info "Reading the agent's certificate fingerprint..."
        fp=$("$BIN" join -agent-url "$url" -fetch-fingerprint 2>/dev/null || true)
        if [ -z "$fp" ]; then
            # Some Iran servers have no working IPv4 to the outside at all, only
            # IPv6. Say so, and offer the other address, rather than just failing.
            err "Could not reach the agent at $url."
            case "$target_host" in
                *:*) ;;
                *)
                    if [ -n "$(first_global_ipv6)" ]; then
                        info "If ordinary IPv4 does not work between the two servers, give the foreign"
                        info "server's IPv6 address instead (it is shown with the link string on that server)."
                        local v6
                        v6=$(ask "Foreign server's IPv6 address (Enter to give up)" "")
                        v6=${v6#\[}
                        v6=${v6%\]}
                        case "$v6" in
                            *:*)
                                if valid_host "$v6"; then
                                    target_host=$v6
                                    url="https://$(hostport "$target_host" "$target_port")"
                                    info "Trying $url..."
                                    fp=$("$BIN" join -agent-url "$url" -fetch-fingerprint 2>/dev/null || true)
                                fi
                                ;;
                        esac
                    fi
                    ;;
            esac
        fi
        if [ -z "$fp" ]; then
            err "Could not reach the agent at $url, so there is nothing to compare."
            warn "Check the address and port, and that the agent is running there."
            return 1
        fi
        say ""
        say "  The agent at $url presents this certificate:"
        say "  ${B}$fp${R}"
        say ""
        say "  On the foreign server, choose the agent option 'Show the link string'."
        say "  It shows the same fingerprint. If they differ, do not continue."
        confirm "Is it the same?" || { err "Not linked."; return 1; }
    fi

    say ""
    info "Testing connection to $url (alias: $alias)..."
    if agent_call "$url" "$tok" "$fp" -status; then
        local f
        f=$(agent_conf_of "$alias")
        write_file_key "$f" alias "$alias"
        write_file_key "$f" url "$url"
        write_file_key "$f" token "$tok"
        write_file_key "$f" fingerprint "$fp"
        write_file_key "$f" server_ip "$target_host"
        write_file_key "$f" port "$target_port"
        chmod 600 "$f"

        write_file_key "$AGENT_CLIENT_CONF" url "$url"
        write_file_key "$AGENT_CLIENT_CONF" token "$tok"
        write_file_key "$AGENT_CLIENT_CONF" fingerprint "$fp"
        chmod 600 "$AGENT_CLIENT_CONF"

        LAST_LINKED_AGENT="$alias"

        say ""
        ok "============================================================"
        ok "Foreign server '$alias' ($url) linked successfully!"
        ok "Future tunnels targeting this server will deploy automatically."
        ok "============================================================"
        return 0
    else
        say ""
        warn "Could not verify connection to $url with the provided token."
        warn "If it says 'connection refused', nothing is listening on that port on the"
        warn "foreign server. On that server, open the agent menu, choose 'Show the link"
        warn "string' and let it restart the agent if it offers to. If it says 'timed out',"
        warn "the port is blocked by that server's firewall or its hosting company's."
        if confirm "Save this configuration anyway?"; then
            local f
            f=$(agent_conf_of "$alias")
            write_file_key "$f" alias "$alias"
            write_file_key "$f" url "$url"
            write_file_key "$f" token "$tok"
            write_file_key "$f" fingerprint "$fp"
            write_file_key "$f" server_ip "$target_host"
            write_file_key "$f" port "$target_port"
            chmod 600 "$f"

            write_file_key "$AGENT_CLIENT_CONF" url "$url"
            write_file_key "$AGENT_CLIENT_CONF" token "$tok"
            write_file_key "$AGENT_CLIENT_CONF" fingerprint "$fp"
            chmod 600 "$AGENT_CLIENT_CONF"
            LAST_LINKED_AGENT="$alias"
            ok "Saved."
            return 0
        fi
        return 1
    fi
}

test_foreign_agent() {
    init_agents_dir
    hr
    say "${B}Test Foreign Management Agent Connection${R}"
    hr
    local count
    count=$(agent_count)
    if [ "$count" -eq 0 ]; then
        warn "No foreign agents configured on this server yet."
        say "Use Option 2 ('Link a new Foreign server') first."
        return 1
    fi

    if [ "$count" -eq 1 ]; then
        local name
        name=$(agent_names)
        local u
        u=$(read_file_key "$(agent_conf_of "$name")" url)
        info "Testing connection to '$name' ($u)..."
        agent_call_alias "$name" -status
        return $?
    fi

    say "Select foreign server to test:"
    local names=() i=1
    for name in $(agent_names); do
        local u
        u=$(read_file_key "$(agent_conf_of "$name")" url)
        say "  ${NUM}$i${R})  ${B}$name${R}  ${DIM}($u)${R}"
        names+=("$name")
        i=$((i + 1))
    done
    say "  ${NUM}A${R}) Test ALL servers"
    say "  ${NUM}0${R}) Cancel"
    hr
    local choice
    choice=$(ask "Choose" "A")
    if [ "$choice" = "0" ]; then
        return 0
    elif [ "$choice" = "a" ] || [ "$choice" = "A" ]; then
        for name in "${names[@]}"; do
            local u
            u=$(read_file_key "$(agent_conf_of "$name")" url)
            say ""
            info "--> Testing '$name' ($u)..."
            agent_call_alias "$name" -status || true
        done
        return 0
    elif valid_count "$choice" && [ "$choice" -le "${#names[@]}" ]; then
        local sel_name="${names[$((choice - 1))]}"
        local u
        u=$(read_file_key "$(agent_conf_of "$sel_name")" url)
        say ""
        info "--> Testing '$sel_name' ($u)..."
        agent_call_alias "$sel_name" -status
        return $?
    else
        err "Invalid choice."
        return 1
    fi
}

unlink_foreign_agent() {
    init_agents_dir
    hr
    say "${B}Unlink / Remove a Foreign Management Agent${R}"
    hr
    local count
    count=$(agent_count)
    if [ "$count" -eq 0 ]; then
        warn "No foreign agents configured on this server."
        return 0
    fi

    say "Select foreign server to unlink:"
    local names=() i=1
    for name in $(agent_names); do
        local u
        u=$(read_file_key "$(agent_conf_of "$name")" url)
        say "  ${NUM}$i${R})  ${B}$name${R}  ${DIM}($u)${R}"
        names+=("$name")
        i=$((i + 1))
    done
    say "  ${NUM}ALL${R}) Unlink ALL foreign servers"
    say "  ${NUM}0${R}) Cancel"
    hr
    local choice
    choice=$(ask "Choose" "0")
    if [ "$choice" = "0" ]; then
        return 0
    elif [ "$choice" = "ALL" ] || [ "$choice" = "all" ]; then
        confirm "Really unlink ALL foreign servers from this Iran server?" || return 0
        rm -rf "${AGENTS_DIR:?}"/*
        rm -f "$AGENT_CLIENT_CONF"
        ok "All foreign servers unlinked."
        return 0
    elif valid_count "$choice" && [ "$choice" -le "${#names[@]}" ]; then
        local sel_name="${names[$((choice - 1))]}"
        confirm "Unlink foreign server '$sel_name'?" || return 0
        rm -f "$(agent_conf_of "$sel_name")"
        ok "Foreign server '$sel_name' unlinked."

        local rem_count
        rem_count=$(agent_count)
        if [ "$rem_count" -gt 0 ]; then
            local next_name
            next_name=$(agent_names | head -n 1)
            local next_u next_tok next_fp
            next_u=$(read_file_key "$(agent_conf_of "$next_name")" url)
            next_tok=$(read_file_key "$(agent_conf_of "$next_name")" token)
            next_fp=$(read_file_key "$(agent_conf_of "$next_name")" fingerprint)
            write_file_key "$AGENT_CLIENT_CONF" url "$next_u"
            write_file_key "$AGENT_CLIENT_CONF" token "$next_tok"
            write_file_key "$AGENT_CLIENT_CONF" fingerprint "$next_fp"
            chmod 600 "$AGENT_CLIENT_CONF"
        else
            rm -f "$AGENT_CLIENT_CONF"
        fi
        return 0
    else
        err "Invalid choice."
        return 1
    fi
}

agent_menu() {
    init_agents_dir
    while :; do
        hr
        say "${B}Management Agent (Cross-Server Automation)${R}"
        say "${DIM}Automate tunnel setup between your Iran server and Foreign server(s).${R}"
        hr
        local agent_active agent_listen
        agent_active=$(systemctl is-active "$AGENT_UNIT" 2>/dev/null || echo "inactive")
        if [ "$agent_active" = active ]; then
            agent_listen=$(read_file_key "$AGENT_CONF" listen 2>/dev/null || true)
            ok "  This Server's Agent Daemon (Foreign role): RUNNING on ${agent_listen:-0.0.0.0:2083}"
        else
            say "  ${DIM}This Server's Agent Daemon (Foreign role): NOT RUNNING${R}"
        fi

        local count
        count=$(agent_count)
        if [ "$count" -gt 0 ]; then
            ok "  Linked Foreign Servers (Iran role): $count server(s) configured"
        else
            say "  ${DIM}Linked Foreign Servers (Iran role): none linked yet${R}"
        fi
        hr
        group "Iran server: manage remote foreign servers"
        say "  ${NUM}1${R}) List linked Foreign servers & test status"
        say "  ${NUM}2${R}) Link a new Foreign server       ${DIM}(1-click deployment)${R}"
        say "  ${NUM}3${R}) Test connection to Foreign server(s)"
        say "  ${NUM}4${R}) Unlink / remove a Foreign server"
        group "Foreign server: agent daemon"
        say "  ${NUM}5${R}) Enable & start Agent daemon on this server"
        say "  ${NUM}6${R}) Show Agent Link String & Token  ${DIM}(pb-agent://...)${R}"
        say "  ${NUM}7${R}) Change Agent listen port"
        say "  ${NUM}8${R}) Regenerate Agent token"
        say "  ${NUM}9${R}) Stop & disable Agent daemon on this server"
        say ""
        say "  ${NUM}0${R}) Back"
        hr
        local c
        c=$(ask "Choose" "0")
        case "$c" in
            1) list_foreign_agents; pause ;;
            2) link_foreign_agent; pause ;;
            3) test_foreign_agent; pause ;;
            4) unlink_foreign_agent; pause ;;
            5) enable_agent; pause ;;
            6) show_agent_link; pause ;;
            7) change_agent_port; pause ;;
            8) regen_agent_token; pause ;;
            9) disable_agent; pause ;;
            *) return 0 ;;
        esac
    done
}

# -------------------------------------------------------------------- main menu

# tunnel_summary - one line for the top of the main menu: how many tunnels there
# are and how many are running, so a stopped one is noticed before anything else.
tunnel_summary() {
    local total=0 running=0 n
    for n in $(tunnel_names); do
        total=$((total + 1))
        [ "$(systemctl is-active "$(unit_of "$n")" 2>/dev/null)" = active ] && running=$((running + 1))
    done
    if [ "$total" -eq 0 ]; then
        printf '%s' "${DIM}$(hostname)  -  no tunnels yet${R}"
    elif [ "$running" -eq "$total" ]; then
        printf '%s' "${DIM}$(hostname)  -  ${R}${GREEN}${running} of ${total} tunnel(s) running${R}"
    else
        printf '%s' "${DIM}$(hostname)  -  ${R}${RED}${running} of ${total} tunnel(s) running${R}"
    fi
}

main_menu() {
    while :; do
        clear 2>/dev/null || true
        say "${B}PortBridge${R} ${DIM}$(engine_version)${R}"
        say "$(tunnel_summary)"
        hr
        group "Tunnels"
        item 1 "List tunnels and status"
        item 2 "Create a tunnel" "on your Iran server"
        item 3 "Join a tunnel" "then on your foreign server"
        item 4 "Tunnel details"
        item 5 "Edit a tunnel"
        item 6 "Start, stop or restart a tunnel"
        item 7 "Show a tunnel's code" "on your Iran server, if needed again"
        group "Check and fix"
        item 8 "Check a tunnel for problems"
        item 9 "View a tunnel's log"
        item 10 "Speed test a tunnel"
        item 11 "Show free ports on both servers" "which ones a CDN forwards"
        group "Settings"
        item 12 "Management Agent" "automate foreign setup from Iran"
        item 13 "Speed tuning" "run on both servers"
        item 14 "Firewall"
        group "Remove"
        item 15 "Delete a tunnel" "" "$RED"
        item 16 "Uninstall PortBridge" "" "$RED"
        say ""
        item 0 "Quit"
        hr
        local choice name
        choice=$(ask "Choose" "")
        case "$choice" in
            1) list_tunnels; pause ;;
            2) create_tunnel; pause ;;
            3) join_tunnel; pause ;;
            4) name=$(pick_tunnel) && show_details "$name"; pause ;;
            5) name=$(pick_tunnel) && edit_tunnel "$name"; pause ;;
            6) name=$(pick_tunnel) && service_menu "$name"; pause ;;
            7) name=$(pick_tunnel) && show_pairing_code "$name"; pause ;;
            8) name=$(pick_tunnel) && test_tunnel "$name"; pause ;;
            9) name=$(pick_tunnel) && show_logs "$name"; pause ;;
            10) name=$(pick_tunnel) && speedtest_tunnel "$name"; pause ;;
            11) ports_overview; pause ;;
            12) agent_menu ;;
            13) tuning_menu; pause ;;
            14) firewall_menu ;;
            15) name=$(pick_tunnel) && delete_tunnel "$name"; pause ;;
            16) uninstall_all ;;
            0 | q | Q) say "Bye."; exit 0 ;;
            *) err "Not a valid choice."; sleep 1 ;;
        esac
    done
}
# set_firewall <name> <on|off> - records the choice and applies it at once
set_firewall() {
    # A tunnel that can arrive from a CDN cannot have its port locked to one
    # address: the connection comes from the CDN, not from the other server, so
    # the lock would cut off the very route meant to keep it alive.
    if [ "$2" = on ] && cdn_involved "$(read_conf "$1" cdn)" "$(read_conf "$1" alt_target)"; then
        warn "'$1' can be reached through a CDN, whose addresses are not the other"
        warn "server's. Locking its port to one address would cut that route off, so"
        warn "the firewall stays off for it."
        return 1
    fi
    write_conf "$1" firewall "$2" || return 1
    "$FIREWALL" apply "$1"
}

tuning_menu() {
    hr
    say "${B}Speed tuning${R}"
    say "${DIM}Linux assumes a lost packet means the line is busy, so it slows down hard.${R}"
    say "${DIM}On a route between countries most loss is just interference, so that${R}"
    say "${DIM}reaction throws away speed for no reason. A setting called BBR measures${R}"
    say "${DIM}the real speed instead, and on a poor route it is often several times${R}"
    say "${DIM}faster. This affects the whole server and can be undone.${R}"
    hr
    "$TUNE" status | sed 's/^/  /'
    hr
    say "  ${NUM}1${R}) Turn the tuning on"
    say "  ${NUM}2${R}) Turn it off again"
    say "  ${NUM}0${R}) Back"
    hr
    case "$(ask "Choose" "0")" in
        1)
            "$TUNE" apply
            say ""
            info "Do the same on your other server to get the full benefit."
            ;;
        2) "$TUNE" undo ;;
        *) return 0 ;;
    esac
}

firewall_menu() {
    local choice name n addr
    while :; do
        hr
        say "${B}Firewall${R}"
        say "${DIM}PortBridge only ever touches the private port the two servers use to${R}"
        say "${DIM}talk to each other. Your users' ports, SSH, panels and any other${R}"
        say "${DIM}services are never blocked by it.${R}"
        hr
        "$FIREWALL" status | sed 's/^/  /'
        hr
        say "  ${NUM}1${R}) Turn the firewall off for a tunnel"
        say "  ${NUM}2${R}) Turn the firewall on for a tunnel"
        say "  ${NUM}3${R}) Change which address a tunnel allows"
        say "  ${NUM}4${R}) Turn it off for every tunnel"
        say "  ${NUM}5${R}) Turn it on for every tunnel"
        say "  ${NUM}6${R}) Remove leftovers of tunnels that no longer exist"
        say "  ${NUM}0${R}) Back"
        hr
        choice=$(ask "Choose" "0")
        case "$choice" in
            1)
                name=$(pick_tunnel) || continue
                warn "With it off, anyone can connect to this tunnel's port. They still"
                warn "cannot get through without the tunnel's password."
                confirm "Turn it off for '$name'?" && set_firewall "$name" off
                ;;
            2)
                name=$(pick_tunnel) || continue
                set_firewall "$name" on
                ;;
            3)
                name=$(pick_tunnel) || continue
                addr=$(ask "Address to allow" "$(read_conf "$name" peer_ip)")
                if valid_host "$addr"; then
                    write_conf "$name" peer_ip "$addr"
                    "$FIREWALL" apply "$name"
                else
                    err "That does not look like an address."
                fi
                ;;
            4)
                confirm "Turn the firewall off for every tunnel?" || continue
                for n in $(tunnel_names); do set_firewall "$n" off; done
                ;;
            5)
                for n in $(tunnel_names); do set_firewall "$n" on; done
                ;;
            6)
                "$FIREWALL" sweep
                ;;
            *) return 0 ;;
        esac
    done
}

service_menu() {
    local name=$1 unit
    unit=$(unit_of "$name")
    hr
    say "${B}'$name' is currently: $(systemctl is-active "$unit")${R}"
    hr
    say "  ${NUM}1${R}) Start"
    say "  ${NUM}2${R}) Stop"
    say "  ${NUM}3${R}) Restart"
    say "  ${NUM}4${R}) Back"
    hr
    case "$(ask "Choose" "3")" in
        1) systemctl start "$unit" && ok "Started." ;;
        2) systemctl stop "$unit" && ok "Stopped." ;;
        3) systemctl restart "$unit" && ok "Restarted." ;;
        *) return 0 ;;
    esac
    sleep 2
    say "Now: $(systemctl is-active "$unit")"
    if [ "$(systemctl is-active "$unit")" = failed ]; then
        journalctl -u "$unit" -n 20 --no-pager
    fi
}

# ------------------------------------------------------------------------- entry

require_root
[ -x "$BIN" ] || { err "PortBridge is not installed properly: $BIN is missing."; exit 1; }
mkdir -p "$CONF_DIR" "$RUN_DIR" "$AGENTS_DIR"
chmod 700 "$CONF_DIR" "$AGENTS_DIR"
init_agents_dir

case "${1-}" in
    list) list_tunnels ;;
    check) shift; test_tunnel "${1:?tunnel name required}" ;;
    code) shift; show_pairing_code "${1:?tunnel name required}" ;;
    speedtest) shift; speedtest_tunnel "${1:?tunnel name required}" ;;
    firewall) "$FIREWALL" status ;;
    agent) agent_menu ;;
    '' ) main_menu ;;
    *) say "Usage: portbridge-menu [list|check <name>|code <name>|speedtest <name>|firewall|agent]" ;;
esac
