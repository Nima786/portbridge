#!/usr/bin/env bash
#
# Locks a tunnel port down to the one server that is supposed to use it.
#
# Only the side that ACCEPTS the cross-border connection needs a rule:
#   direct mode  - the origin accepts, so the origin's tunnel port is locked
#   reverse mode - the edge accepts, so the edge's tunnel port is locked
#
# The side that dials out needs no rule at all, which is one of the quiet
# advantages of reverse mode.
#
# The port users connect to is deliberately left wide open.
#
# Run from the tunnel's systemd unit on every start, so rules are restored after
# a reboot without a separate service to manage. Every rule is added only if it
# is missing, so repeated runs are harmless.
#
# Every rule carries a comment naming its tunnel ("portbridge:<name>"). That is
# how it finds its own rules again: a rule that someone else put on the same port
# number, a web server's for instance, is never touched. Rules made by versions
# that did not tag them are recognised by their exact shape and cleaned up only
# on the side that accepts, where the port is this tunnel's own.
#
# The same helper also makes and removes the private GRE link of a tunnel that
# has "gre = on" (see gre.go for why), because it already runs at exactly the
# right moments: when the service starts, when a tunnel is deployed and when one
# is deleted. The link's name and addresses are worked out from the two public
# addresses alone, in the same way gre.go does it, so both servers agree without
# talking. Tunnels between the same two servers share one link, and it is removed
# only when the last of them goes.

set -uo pipefail

CONF_DIR=${PORTBRIDGE_CONF_DIR:-/etc/portbridge/tunnels}

die() {
    echo "portbridge-firewall: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
Usage:
  portbridge-firewall status                 every tunnel at a glance
  portbridge-firewall apply  <tunnel-name>   lock, or unlock if turned off; make the GRE link
  portbridge-firewall remove <tunnel-name>
  portbridge-firewall show   <tunnel-name>
  portbridge-firewall sweep [all]            remove what is left behind by tunnels that no longer exist
  portbridge-firewall gre-check              can this server make GRE links at all?
  portbridge-firewall gre-addr <this-ip> <other-ip>
                                             the link's name and the two private addresses
  portbridge-firewall gre-test <tunnel-name> is the other end of the GRE link answering?
EOF
    exit 2
}

# read_conf <file> <key> -> value, or empty
read_conf() {
    sed -nE "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"?([^\"#]*)\"?[[:space:]]*$/\1/p" "$1" |
        tail -1 | sed -E 's/[[:space:]]+$//'
}

# Works out whether this side accepts the tunnel connection, and on which port.
# Sets: LISTENS, TPORT, PEER, TRANSPORT, ENABLED, PROTO
# Returns non-zero, after saying why, when the settings cannot be used; one
# unreadable tunnel must not stop the others from being handled.
load() {
    local name=$1
    local conf="$CONF_DIR/$name.conf"
    case "$name" in
        '' | *[!a-zA-Z0-9_-]*)
            echo "portbridge-firewall: not a valid tunnel name: $name" >&2
            return 1
            ;;
    esac
    if [ ! -f "$conf" ]; then
        echo "portbridge-firewall: no such tunnel: $name" >&2
        return 1
    fi

    local mode role tunnel_addr
    mode=$(read_conf "$conf" mode)
    role=$(read_conf "$conf" role)
    tunnel_addr=$(read_conf "$conf" tunnel_addr)
    PEER=$(read_conf "$conf" peer_ip)
    TRANSPORT=$(read_conf "$conf" transport)
    [ -n "$TRANSPORT" ] || TRANSPORT=plain
    # Missing means on: tunnels made before this setting existed stay protected.
    ENABLED=$(read_conf "$conf" firewall)
    [ -n "$ENABLED" ] || ENABLED=on

    # Port is whatever follows the last colon, so IPv6 literals survive.
    TPORT=${tunnel_addr##*:}

    case "$mode:$role" in
        direct:origin | reverse:edge) LISTENS=yes ;;
        direct:edge | reverse:origin) LISTENS=no ;;
        *)
            echo "portbridge-firewall: tunnel $name has an unexpected mode/role combination: $mode/$role" >&2
            return 1
            ;;
    esac

    case "$TPORT" in
        '' | *[!0-9]*)
            echo "portbridge-firewall: tunnel $name has an unreadable tunnel port: '$tunnel_addr'" >&2
            return 1
            ;;
    esac

    PROTO=tcp
    [ "$TRANSPORT" = kcp ] && PROTO=udp
    return 0
}

have() { command -v "$1" >/dev/null 2>&1; }

# delete_rule <tool> <rule as printed by "-S"> - deletes that rule. The listing
# puts a comment in double quotes, and a quote left in would become part of the
# comment and match nothing, so rules the listing showed were never removed. Our
# own comments never contain a space, so taking the quotes out is safe.
delete_rule() {
    local tool=$1 rule=$2
    rule=${rule/-A/-D}
    rule=${rule//\"/}
    # shellcheck disable=SC2086 # the rule must be split back into words
    "$tool" $rule 2>/dev/null || true
}

tag() { printf 'portbridge:%s' "$1"; }

# rule_spec <name> <target> [source] - fills RULE with a rule for the loaded
# tunnel, after the chain name. The same words serve for checking, adding and
# deleting.
rule_spec() {
    local name=$1 target=$2 src=${3-}
    RULE=()
    [ -n "$src" ] && RULE+=(-s "$src")
    RULE+=(-p "$PROTO" --dport "$TPORT" -m comment --comment "$(tag "$name")" -j "$target")
}

# add_rule <tool> <name> <target> [source]
#
# Inserted at the top of the chain, not appended. Appending put the rule below
# whatever the machine already had, and a broad REJECT or an accept-everything
# further up made the lock either useless or impossible to get through. Rules
# are added so that, in the end, the allowed sources sit above the drop.
add_rule() {
    local tool=$1 name=$2 target=$3 src=${4-}
    have "$tool" || return 0
    rule_spec "$name" "$target" "$src"
    "$tool" -C INPUT "${RULE[@]}" 2>/dev/null || "$tool" -I INPUT 1 "${RULE[@]}"
}

# purge_own <tool> <name> - removes every rule this tunnel added, whatever port
# or address it names, so a changed port or peer never leaves an old one behind.
purge_own() {
    local tool=$1 name=$2 rule
    have "$tool" || return 0
    "$tool" -S INPUT 2>/dev/null |
        grep -E -- "^-A INPUT .*--comment \"?$(tag "$name")\"?( |$)" |
        while read -r rule; do
            delete_rule "$tool" "$rule"
        done
}

# purge_legacy <tool> <port> - removes rules of the shape older versions made,
# which carried no tag. Only ever used on the side that accepts, where the port
# belongs to this tunnel; on the side that dials the same number may be somebody
# else's service.
purge_legacy() {
    local tool=$1 port=$2 rule
    have "$tool" || return 0
    "$tool" -S INPUT 2>/dev/null |
        grep -E -- "^-A INPUT( -s [^ ]+)? -p (tcp|udp) -m (tcp|udp) --dport $port -j (ACCEPT|DROP)$" |
        while read -r rule; do
            delete_rule "$tool" "$rule"
        done
}

purge_everything() {
    local name=$1
    purge_own iptables "$name"
    purge_own ip6tables "$name"
    if [ "$LISTENS" = yes ]; then
        purge_legacy iptables "$TPORT"
        purge_legacy ip6tables "$TPORT"
    fi
}

# ---------------------------------------------------------- private GRE link
#
# Some networks cut ordinary connections that leave the country after a few
# packets but let GRE (IP protocol 47) through. A tunnel with "gre = on" talks to
# the other server's private address on a GRE link, so only GRE crosses the border.

GRE_PREFIX=10.99
GRE_MTU=1300

# valid_ipv4 <text> - a plain dotted address: four numbers 0-255, no leading zeros.
valid_ipv4() {
    local ip=$1 part
    [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    local IFS=.
    # shellcheck disable=SC2086 # split on the dots on purpose
    set -- $ip
    for part in "$@"; do
        [ "${#part}" -gt 1 ] && [ "${part:0:1}" = 0 ] && return 1
        [ "$part" -le 255 ] || return 1
    done
    return 0
}

ip2int() {
    local a b c d
    IFS=. read -r a b c d <<<"$1"
    echo $(((a << 24) | (b << 16) | (c << 8) | d))
}

# gre_pair <this-ip> <other-ip> - works out the link for two public addresses.
# Sets GRE_IFACE, GRE_OWN (this server's private address) and GRE_PEER (the
# other's). The same rule, byte for byte, as greLink in gre.go: the server with
# the smaller public address gets the lower private one, and the block of four
# addresses comes from a hash of the two.
gre_pair() {
    local mine=$1 other=$2 lo hi digest h8 block off third fourth low high
    valid_ipv4 "$mine" && valid_ipv4 "$other" || return 1
    [ "$mine" != "$other" ] || return 1
    if [ "$(ip2int "$other")" -lt "$(ip2int "$mine")" ]; then
        lo=$other hi=$mine
    else
        lo=$mine hi=$other
    fi
    digest=$(printf '%s' "$lo-$hi" | sha256sum)
    h8=${digest:0:8}
    block=$((16#$h8 % 16384))
    off=$((block * 4))
    third=$((off / 256))
    fourth=$((off % 256))
    low="$GRE_PREFIX.$third.$((fourth + 1))"
    high="$GRE_PREFIX.$third.$((fourth + 2))"
    GRE_IFACE="pbg$h8"
    if [ "$mine" = "$lo" ]; then
        GRE_OWN=$low GRE_PEER=$high
    else
        GRE_OWN=$high GRE_PEER=$low
    fi
}

# gre_conf <name> - reads the GRE settings of a tunnel.
gre_conf() {
    local conf="$CONF_DIR/$1.conf"
    GRE_ON=$(read_conf "$conf" gre)
    [ -n "$GRE_ON" ] || GRE_ON=off
    GRE_LOCAL=$(read_conf "$conf" gre_local)
    GRE_REMOTE=$(read_conf "$conf" gre_remote)
}

gre_tag() { printf 'portbridge-gre:%s' "$1"; }

# gre_firewall_open / gre_firewall_close - let the other server's GRE packets in.
# Only matters on a server whose firewall drops what it has not been told to
# accept; harmless where it does not. Tagged with the link, not the tunnel,
# because tunnels share a link.
gre_firewall_open() {
    have iptables || return 0
    iptables -C INPUT -s "$GRE_REMOTE" -p gre -m comment --comment "$(gre_tag "$GRE_IFACE")" -j ACCEPT 2>/dev/null ||
        iptables -I INPUT 1 -s "$GRE_REMOTE" -p gre -m comment --comment "$(gre_tag "$GRE_IFACE")" -j ACCEPT 2>/dev/null || true
}

gre_firewall_close() {
    local rule
    have iptables || return 0
    iptables -S INPUT 2>/dev/null |
        grep -E -- "^-A INPUT .*--comment \"?$(gre_tag "$GRE_IFACE")\"?( |$)" |
        while read -r rule; do
            delete_rule iptables "$rule"
        done
}

# gre_unsupported_hint - what to say when the kernel will not make a GRE link.
gre_unsupported_hint() {
    echo "this server cannot make GRE links. The host does not allow it: this is common on"
    echo "OpenVZ or LXC containers and on some low-cost plans. Ask the provider, or use a"
    echo "different kind of tunnel on this server."
}

# gre_used_by_others <name> - does another tunnel use the same link?
gre_used_by_others() {
    local self=$1 f n
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        n=$(basename "$f" .conf)
        [ "$n" = "$self" ] && continue
        [ "$(read_conf "$f" gre)" = on ] || continue
        if [ "$(read_conf "$f" gre_local)" = "$GRE_LOCAL" ] && [ "$(read_conf "$f" gre_remote)" = "$GRE_REMOTE" ]; then
            return 0
        fi
    done
    return 1
}

# link_release <name> - takes the link down unless another tunnel still needs it.
link_release() {
    local name=$1
    gre_conf "$name"
    [ -n "$GRE_LOCAL" ] && [ -n "$GRE_REMOTE" ] || return 0
    gre_pair "$GRE_LOCAL" "$GRE_REMOTE" || return 0
    if gre_used_by_others "$name"; then
        return 0
    fi
    if have ip && ip link show "$GRE_IFACE" >/dev/null 2>&1; then
        ip link del "$GRE_IFACE" 2>/dev/null && echo "private GRE link $GRE_IFACE removed"
    fi
    gre_firewall_close
    return 0
}

# link_apply <name> - makes the GRE link a tunnel needs, if it does. Safe to run
# again and again: whatever is already right is left alone.
link_apply() {
    local name=$1
    gre_conf "$name"
    if [ "$GRE_ON" != on ]; then
        # Turned off since the link was made: drop it if nothing else uses it.
        link_release "$name"
        return 0
    fi

    if ! gre_pair "$GRE_LOCAL" "$GRE_REMOTE"; then
        echo "tunnel $name has gre = on but gre_local '$GRE_LOCAL' and gre_remote '$GRE_REMOTE' are not two different IPv4 addresses" >&2
        return 1
    fi
    if ! have ip; then
        echo "the 'ip' command is missing; install iproute2 to use a GRE link" >&2
        return 1
    fi
    # The link is built on this server's own public address. A server that only
    # sees it through address translation cannot receive GRE on it.
    if ! ip -4 -o addr show 2>/dev/null | grep -qF "inet $GRE_LOCAL/"; then
        echo "this server does not carry the address $GRE_LOCAL on any of its network cards," >&2
        echo "so it sits behind address translation, and a GRE link cannot be made from it" >&2
        return 1
    fi

    modprobe ip_gre 2>/dev/null || true
    local err
    if ! ip link show "$GRE_IFACE" >/dev/null 2>&1; then
        if ! err=$(ip tunnel add "$GRE_IFACE" mode gre local "$GRE_LOCAL" remote "$GRE_REMOTE" ttl 64 2>&1); then
            echo "could not make the GRE link $GRE_IFACE: $err" >&2
            gre_unsupported_hint >&2
            return 1
        fi
    fi
    if ! ip -4 addr show dev "$GRE_IFACE" 2>/dev/null | grep -qF "inet $GRE_OWN/"; then
        # The block of four addresses is picked from a hash; if another network
        # on this server already uses the address, say so rather than overlap it.
        if ip -4 -o addr show 2>/dev/null | grep -v " $GRE_IFACE " | grep -qF "inet $GRE_OWN/"; then
            echo "the private address $GRE_OWN is already used by another network card here;" >&2
            echo "change the tunnel's name or the server pair to get a different one" >&2
            return 1
        fi
        ip addr add "$GRE_OWN/30" dev "$GRE_IFACE" 2>/dev/null || {
            echo "could not give the GRE link its address $GRE_OWN" >&2
            return 1
        }
    fi
    ip link set "$GRE_IFACE" mtu "$GRE_MTU" up 2>/dev/null || {
        echo "could not bring the GRE link $GRE_IFACE up" >&2
        return 1
    }
    gre_firewall_open
    echo "private GRE link $GRE_IFACE is up: this server $GRE_OWN, the other server $GRE_PEER"
    return 0
}

# cmd_gre_check - can this server make a GRE link at all? Makes a throw-away
# link that goes nowhere and removes it again.
cmd_gre_check() {
    have ip || {
        echo "the 'ip' command is missing; install iproute2 to use a GRE link"
        exit 1
    }
    modprobe ip_gre 2>/dev/null || true
    local err probe=pbgchk$$
    if err=$(ip tunnel add "$probe" mode gre local 127.0.0.1 remote 192.0.2.1 ttl 64 2>&1); then
        ip link del "$probe" 2>/dev/null
        echo "this server can make GRE links"
        return 0
    fi
    echo "$err"
    gre_unsupported_hint
    exit 1
}

# cmd_gre_addr <this-ip> <other-ip> - prints the link's name, this server's
# private address and the other server's.
cmd_gre_addr() {
    gre_pair "$1" "$2" || {
        echo "portbridge-firewall: '$1' and '$2' must be two different plain IPv4 addresses" >&2
        exit 1
    }
    echo "$GRE_IFACE $GRE_OWN $GRE_PEER"
}

# cmd_gre_test <name> - is the link up and does the other end answer?
cmd_gre_test() {
    local name=$1
    load "$name" || exit 1
    gre_conf "$name"
    if [ "$GRE_ON" != on ]; then
        echo "tunnel $name does not use a GRE link"
        return 0
    fi
    gre_pair "$GRE_LOCAL" "$GRE_REMOTE" || {
        echo "tunnel $name has unusable GRE addresses"
        exit 1
    }
    if ! ip link show "$GRE_IFACE" >/dev/null 2>&1; then
        echo "the GRE link $GRE_IFACE is not there on this server"
        exit 1
    fi
    if ! have ping; then
        echo "the GRE link $GRE_IFACE is up (ping is not installed, so the other end was not tried)"
        return 0
    fi
    if ping -c 3 -W 2 "$GRE_PEER" >/dev/null 2>&1; then
        echo "the other end of the GRE link answers ($GRE_PEER)"
        return 0
    fi
    echo "the GRE link $GRE_IFACE is up here, but the other end ($GRE_PEER) does not answer"
    exit 1
}

firewall_apply() {
    local name=$1
    load "$name" || exit 1

    if [ "$LISTENS" != yes ]; then
        # Switching a tunnel between direct and reverse swaps which side accepts.
        # If this side used to accept, its rules are now meaningless and would
        # keep a port shut that nothing is listening on, so clear this tunnel's
        # own.
        purge_everything "$name"
        echo "tunnel $name dials out, so no firewall rule is needed on this server"
        return 0
    fi
    if [ "$ENABLED" = off ]; then
        # Turned off by the user: make sure nothing is left behind from when it
        # was on, so "off" really means the port is open.
        purge_everything "$name"
        echo "firewall is turned off for tunnel $name, so port $TPORT is open to everyone"
        return 0
    fi
    if [ -z "$PEER" ]; then
        echo "tunnel $name has no peer address recorded, so port $TPORT is left open" >&2
        return 0
    fi

    # Start clean, so a changed peer address never leaves the old one allowed.
    purge_everything "$name"

    # Added bottom to top, each at the top of the chain: the drop first, then the
    # addresses allowed through, which end up above it.
    add_rule iptables "$name" DROP
    add_rule iptables "$name" ACCEPT 127.0.0.1
    add_rule iptables "$name" ACCEPT "$PEER"

    # The port is bound on IPv6 too. The peer is recorded as IPv4, so close v6
    # rather than leaving an unguarded way in.
    if have ip6tables && [[ "$PEER" != *:* ]]; then
        add_rule ip6tables "$name" DROP
    fi

    echo "tunnel port $TPORT ($PROTO) is restricted to $PEER"
}

# cmd_sweep [quiet|all] - removes whatever PortBridge left behind for tunnels that
# no longer exist: firewall rules carrying a tunnel's tag when that tunnel has no
# settings file any more, GRE rules and links no tunnel needs. It is the safety net
# under every other way of cleaning up: a tunnel deleted by hand, by an older
# version, by a program that stopped half way, or on a server where the rule
# listing was written in a form the older cleaning did not understand.
#
# It touches only rules whose comment is "portbridge:<name>" or
# "portbridge-gre:<link>", and only links named like the ones this makes. Nobody
# else's rules are looked at. If the settings directory is missing it does nothing,
# since it could not tell what is still wanted; "all" is for uninstalling, when
# nothing is.
cmd_sweep() {
    local mode=${1-} tool rule name iface f n used="" removed=0
    local re_tunnel='--comment "?portbridge:([A-Za-z0-9_-]+)"?( |$)'
    local re_link='--comment "?portbridge-gre:(pbg[0-9a-f]{8})"?( |$)'

    if [ "$mode" != all ]; then
        if [ ! -d "$CONF_DIR" ]; then
            [ "$mode" = quiet ] || echo "there is no settings directory ($CONF_DIR), so nothing can be told apart; nothing swept"
            return 0
        fi
        for f in "$CONF_DIR"/*.conf; do
            [ -e "$f" ] || continue
            n=$(basename "$f" .conf)
            gre_conf "$n"
            [ "$GRE_ON" = on ] || continue
            gre_pair "$GRE_LOCAL" "$GRE_REMOTE" && used="$used $GRE_IFACE "
        done
    fi

    for tool in iptables ip6tables; do
        have "$tool" || continue
        while read -r rule; do
            if [[ "$rule" =~ $re_tunnel ]]; then
                name=${BASH_REMATCH[1]}
                [ "$mode" != all ] && [ -f "$CONF_DIR/$name.conf" ] && continue
            elif [[ "$rule" =~ $re_link ]]; then
                iface=${BASH_REMATCH[1]}
                case "$used" in *" $iface "*) continue ;; esac
            else
                continue
            fi
            delete_rule "$tool" "$rule"
            removed=$((removed + 1))
        done < <("$tool" -S INPUT 2>/dev/null)
    done

    if have ip; then
        for iface in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | sed 's/@.*//'); do
            [[ "$iface" =~ ^pbg[0-9a-f]{8}$ ]] || continue
            case "$used" in *" $iface "*) continue ;; esac
            if ip link del "$iface" 2>/dev/null; then
                echo "removed the GRE link $iface, which no tunnel uses"
                removed=$((removed + 1))
            fi
        done
    fi

    if [ "$removed" -gt 0 ]; then
        echo "swept $removed leftover rule(s) and link(s) of tunnels that no longer exist"
    elif [ "$mode" != quiet ]; then
        echo "nothing left behind"
    fi
    return 0
}

# cmd_apply makes the GRE link first, since a tunnel over one cannot start
# without it, then sets the port rule. A link that cannot be made is reported
# and makes the command fail, but the port rule is still dealt with.
cmd_apply() {
    local name=$1 rc=0
    load "$name" || exit 1
    link_apply "$name" || rc=1
    firewall_apply "$name"
    # Starting a tunnel is a good moment to clear away what deleted ones left.
    cmd_sweep quiet
    return "$rc"
}

cmd_remove() {
    local name=$1
    load "$name" || exit 1
    # Purge whether or not this side accepts now: the mode may have been changed
    # since the rules were added, and leaving them behind shuts a port for good.
    purge_everything "$name"
    echo "firewall rules for tunnel $name removed"
    # The GRE link goes too, unless another tunnel between the same two servers
    # is still using it.
    link_release "$name"
}

cmd_status() {
    local f name
    printf '%-16s %-8s %-7s %-10s %s\n' TUNNEL PORT SETTING STATE "ALLOWED FROM"
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        name=$(basename "$f" .conf)
        # A tunnel whose settings cannot be read is listed as such, not allowed
        # to end the listing.
        if ! load "$name" 2>/dev/null; then
            printf '%-16s %-8s %-7s %-10s %s\n' "$name" "?" "?" "unreadable" "check its settings file"
            continue
        fi
        if [ "$LISTENS" != yes ]; then
            printf '%-16s %-8s %-7s %-10s %s\n' "$name" "$TPORT" "-" "not needed" "this side dials out"
            continue
        fi
        local state="open"
        rule_spec "$name" DROP
        if have iptables && iptables -C INPUT "${RULE[@]}" 2>/dev/null; then
            state="locked"
        fi
        printf '%-16s %-8s %-7s %-10s %s\n' "$name" "$TPORT" "$ENABLED" "$state" \
            "$([ "$state" = locked ] && echo "$PEER only" || echo "everyone")"
    done

    # The GRE links, for the tunnels that use one.
    local shown=0 up
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        name=$(basename "$f" .conf)
        gre_conf "$name"
        [ "$GRE_ON" = on ] || continue
        if [ "$shown" -eq 0 ]; then
            printf '\n%-16s %-13s %s\n' "TUNNEL" "GRE LINK" "THIS SERVER <-> OTHER SERVER"
            shown=1
        fi
        if ! gre_pair "$GRE_LOCAL" "$GRE_REMOTE"; then
            printf '%-16s %-13s %s\n' "$name" "?" "unusable addresses in its settings"
            continue
        fi
        up=down
        if have ip && ip link show "$GRE_IFACE" 2>/dev/null | grep -q 'UP'; then
            up=up
        fi
        printf '%-16s %-13s %s <-> %s  (%s)\n' "$name" "$GRE_IFACE" "$GRE_OWN" "$GRE_PEER" "$up"
    done
}

cmd_show() {
    local name=$1
    load "$name" || exit 1
    if [ "$LISTENS" != yes ]; then
        echo "this side dials out; no rules expected"
        return 0
    fi
    echo "rules for port $TPORT:"
    have iptables && { iptables -S INPUT | grep -- "--dport $TPORT" || echo "  (none)"; }
    if have ip6tables; then
        echo "IPv6:"
        ip6tables -S INPUT | grep -- "--dport $TPORT" || echo "  (none)"
    fi
}

case "${1-}:$#" in
    status:1) cmd_status ;;
    apply:2) cmd_apply "$2" ;;
    remove:2) cmd_remove "$2" ;;
    show:2) cmd_show "$2" ;;
    sweep:1) cmd_sweep ;;
    sweep:2)
        case "$2" in
            all | quiet) cmd_sweep "$2" ;;
            *) usage ;;
        esac
        ;;
    gre-check:1) cmd_gre_check ;;
    gre-addr:3) cmd_gre_addr "$2" "$3" ;;
    gre-test:2) cmd_gre_test "$2" ;;
    *) usage ;;
esac
