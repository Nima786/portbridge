#!/usr/bin/env bash
#
# Locks a tunnel port down to the one server that is supposed to use it.
#
# Only the side that ACCEPTS the cross-border connection needs a rule:
#   direct mode  - the origin accepts, so the origin's tunnel port is locked
#   reverse mode - the edge accepts, so the edge's tunnel port is locked
#
# The side that dials out needs no rule at all, which is one of the quiet
# advantages of reverse mode.
#
# The port users connect to is deliberately left wide open.
#
# Run from the tunnel's systemd unit on every start, so rules are restored after
# a reboot without a separate service to manage. Every rule is added only if it
# is missing, so repeated runs are harmless.

set -uo pipefail

CONF_DIR=/etc/portbridge/tunnels

die() {
    echo "portbridge-firewall: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
Usage:
  portbridge-firewall status                 every tunnel at a glance
  portbridge-firewall apply  <tunnel-name>   lock, or unlock if turned off
  portbridge-firewall remove <tunnel-name>
  portbridge-firewall show   <tunnel-name>
EOF
    exit 2
}

# read_conf <file> <key> -> value, or empty
read_conf() {
    sed -nE "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"?([^\"#]*)\"?[[:space:]]*$/\1/p" "$1" |
        tail -1 | sed -E 's/[[:space:]]+$//'
}

# Works out whether this side accepts the tunnel connection, and on which port.
# Sets: LISTENS, TPORT, PEER
load() {
    local name=$1
    local conf="$CONF_DIR/$name.conf"
    [ -f "$conf" ] || die "no such tunnel: $name"

    local mode role tunnel_addr
    mode=$(read_conf "$conf" mode)
    role=$(read_conf "$conf" role)
    tunnel_addr=$(read_conf "$conf" tunnel_addr)
    PEER=$(read_conf "$conf" peer_ip)
    # Missing means on: tunnels made before this setting existed stay protected.
    ENABLED=$(read_conf "$conf" firewall)
    [ -n "$ENABLED" ] || ENABLED=on

    # Port is whatever follows the last colon, so IPv6 literals survive.
    TPORT=${tunnel_addr##*:}

    case "$mode:$role" in
        direct:origin | reverse:edge) LISTENS=yes ;;
        direct:edge | reverse:origin) LISTENS=no ;;
        *) die "tunnel $name has an unexpected mode/role combination: $mode/$role" ;;
    esac

    case "$TPORT" in
        '' | *[!0-9]*) die "tunnel $name has an unreadable tunnel port: '$tunnel_addr'" ;;
    esac
}

have() { command -v "$1" >/dev/null 2>&1; }

# Adds a rule only when an identical one is not already present.
ensure4() {
    have iptables || return 0
    iptables -C "$@" 2>/dev/null || iptables -A "$@"
}
drop4() {
    have iptables || return 0
    while iptables -C "$@" 2>/dev/null; do
        iptables -D "$@" || break
    done
}

cmd_apply() {
    load "$1"

    if [ "$LISTENS" != yes ]; then
        echo "tunnel $1 dials out, so no firewall rule is needed on this server"
        return 0
    fi
    if [ "$ENABLED" = off ]; then
        # Turned off by the user: make sure nothing is left behind from when it
        # was on, so "off" really means the port is open.
        cmd_remove "$1" >/dev/null
        echo "firewall is turned off for tunnel $1, so port $TPORT is open to everyone"
        return 0
    fi
    if [ -z "$PEER" ]; then
        echo "tunnel $1 has no peer address recorded, so port $TPORT is left open" >&2
        return 0
    fi

    # Start clean, so a changed peer address never leaves the old one allowed.
    purge_port iptables "$TPORT"
    purge_port ip6tables "$TPORT"

    # Order matters: the allow rules must sit above the catch-all drop.
    ensure4 INPUT -p tcp --dport "$TPORT" -s "$PEER" -j ACCEPT
    ensure4 INPUT -p tcp --dport "$TPORT" -s 127.0.0.1 -j ACCEPT
    ensure4 INPUT -p tcp --dport "$TPORT" -j DROP

    # The port is bound on IPv6 too. The peer is recorded as IPv4, so close v6
    # rather than leaving an unguarded way in.
    if have ip6tables && [[ "$PEER" != *:* ]]; then
        ip6tables -C INPUT -p tcp --dport "$TPORT" -j DROP 2>/dev/null ||
            ip6tables -A INPUT -p tcp --dport "$TPORT" -j DROP
    fi

    echo "tunnel port $TPORT is restricted to $PEER"
}

# Removes every allow and drop rule for a port, whatever source address it
# names. Matching on the port rather than on the recorded peer matters: if the
# peer address was changed, the rule for the old address must go too, or it
# would stay open to a server that is no longer part of the tunnel.
purge_port() {
    local tool=$1 port=$2 rule
    have "$tool" || return 0
    "$tool" -S INPUT 2>/dev/null |
        grep -E -- "^-A INPUT( -s [^ ]+)? -p tcp -m tcp --dport $port -j (ACCEPT|DROP)$" |
        while read -r rule; do
            # shellcheck disable=SC2086 # the rule must be split back into words
            "$tool" ${rule/-A/-D} 2>/dev/null || true
        done
}

cmd_remove() {
    load "$1"
    [ "$LISTENS" = yes ] || return 0
    purge_port iptables "$TPORT"
    purge_port ip6tables "$TPORT"
    echo "firewall rules for tunnel port $TPORT removed"
}

cmd_status() {
    local f name
    printf '%-16s %-8s %-7s %-10s %s\n' TUNNEL PORT SETTING STATE "ALLOWED FROM"
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        name=$(basename "$f" .conf)
        load "$name"
        if [ "$LISTENS" != yes ]; then
            printf '%-16s %-8s %-7s %-10s %s\n' "$name" "$TPORT" "-" "not needed" "this side dials out"
            continue
        fi
        local state="open"
        if have iptables && iptables -C INPUT -p tcp --dport "$TPORT" -j DROP 2>/dev/null; then
            state="locked"
        fi
        printf '%-16s %-8s %-7s %-10s %s\n' "$name" "$TPORT" "$ENABLED" "$state" \
            "$([ "$state" = locked ] && echo "$PEER only" || echo "everyone")"
    done
}

cmd_show() {
    load "$1"
    if [ "$LISTENS" != yes ]; then
        echo "this side dials out; no rules expected"
        return 0
    fi
    echo "rules for port $TPORT:"
    have iptables && iptables -S INPUT | grep -- "--dport $TPORT" || echo "  (none)"
    if have ip6tables; then
        echo "IPv6:"
        ip6tables -S INPUT | grep -- "--dport $TPORT" || echo "  (none)"
    fi
}

case "${1-}:$#" in
    status:1) cmd_status ;;
    apply:2) cmd_apply "$2" ;;
    remove:2) cmd_remove "$2" ;;
    show:2) cmd_show "$2" ;;
    *) usage ;;
esac
