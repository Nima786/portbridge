[Unit]
Description=PortBridge Management Agent
Documentation=https://github.com/Nima786/portbridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/portbridge agent -config /etc/portbridge/agent.conf
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
